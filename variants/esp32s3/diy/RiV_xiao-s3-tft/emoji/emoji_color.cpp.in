// Colour emoji through an LVGL image font: 33 emoji built in, more from /emoji_color.bin on the SD card.
// Twemoji graphics (c) Twitter, Inc. and other contributors, licensed CC-BY 4.0, shrunk to 18x18 RGB565A8.
#include "lvgl.h"
#include <esp_heap_caps.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

extern "C" lv_font_t ui_emoji_font;
extern "C" {
lv_font_t ui_emoji_color_font;
}

#include "emoji_color_builtin.inc"

static const int SZ = 18;
static const uint32_t BUILTIN_N = sizeof(builtin_codes) / sizeof(builtin_codes[0]);
static lv_image_dsc_t builtin_dsc[sizeof(builtin_codes) / sizeof(builtin_codes[0])];
static uint32_t *pack_codes = nullptr;
static lv_image_dsc_t *pack_dsc = nullptr;
static uint32_t pack_n = 0;
static bool color_ready = false;

static void fill_dsc(lv_image_dsc_t *d, const uint8_t *data)
{
    memset(d, 0, sizeof(*d));
    d->header.magic = LV_IMAGE_HEADER_MAGIC;
    d->header.cf = LV_COLOR_FORMAT_RGB565A8;
    d->header.w = SZ;
    d->header.h = SZ;
    d->header.stride = SZ * 2;
    d->data_size = SZ * SZ * 3;
    d->data = data;
}

static int find_code(const uint32_t *codes, uint32_t n, uint32_t code)
{
    int lo = 0, hi = (int)n - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (codes[mid] == code)
            return mid;
        if (codes[mid] < code)
            lo = mid + 1;
        else
            hi = mid - 1;
    }
    return -1;
}

static const void *emoji_path_cb(const lv_font_t *font, uint32_t unicode, uint32_t unicode_next, int32_t *offset_y, void *user_data)
{
    *offset_y = -3;
    int i = find_code(builtin_codes, BUILTIN_N, unicode);
    if (i >= 0)
        return &builtin_dsc[i];
    if (pack_n) {
        i = find_code(pack_codes, pack_n, unicode);
        if (i >= 0)
            return &pack_dsc[i];
    }
    return nullptr;
}

static bool stub_glyph_dsc(const lv_font_t *font, lv_font_glyph_dsc_t *dsc, uint32_t letter, uint32_t letter_next)
{
    return false;
}

static const void *stub_glyph_bitmap(lv_font_glyph_dsc_t *dsc, lv_draw_buf_t *draw_buf)
{
    return nullptr;
}

// Before emoji_color_init() the font finds nothing, so text falls through to the monochrome emoji font
static struct EmojiColorBoot {
    EmojiColorBoot()
    {
        memset(&ui_emoji_color_font, 0, sizeof(ui_emoji_color_font));
        ui_emoji_color_font.get_glyph_dsc = stub_glyph_dsc;
        ui_emoji_color_font.get_glyph_bitmap = stub_glyph_bitmap;
        ui_emoji_color_font.line_height = SZ;
        ui_emoji_color_font.fallback = &ui_emoji_font;
    }
} emoji_color_boot;

extern "C" void emoji_color_init(void)
{
    if (color_ready)
        return;
    for (uint32_t i = 0; i < BUILTIN_N; i++)
        fill_dsc(&builtin_dsc[i], &builtin_data[i * SZ * SZ * 3]);
    lv_font_t *f = lv_imgfont_create(SZ, emoji_path_cb, nullptr);
    if (!f)
        return;
    lv_font_t tmp = *f;
    tmp.fallback = &ui_emoji_font;
    ui_emoji_color_font = tmp;
    color_ready = true;
}

// Pack layout: "EMJ1", count u16, size u8, pad u8, count x (code u32, offset u32), then the 18x18 RGB565A8 blocks
extern "C" bool emoji_color_load_pack(const uint8_t *buf, uint32_t size)
{
    if (!color_ready || pack_n || size < 8 || memcmp(buf, "EMJ1", 4) != 0)
        return false;
    uint16_t n = buf[4] | (buf[5] << 8);
    if (buf[6] != SZ || size < 8 + (uint32_t)n * 8)
        return false;
    uint32_t *codes = (uint32_t *)heap_caps_malloc(n * sizeof(uint32_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    lv_image_dsc_t *dsc = (lv_image_dsc_t *)heap_caps_malloc(n * sizeof(lv_image_dsc_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!codes || !dsc) {
        free(codes);
        free(dsc);
        return false;
    }
    for (uint16_t i = 0; i < n; i++) {
        uint32_t code, off;
        memcpy(&code, buf + 8 + i * 8, 4);
        memcpy(&off, buf + 8 + i * 8 + 4, 4);
        if (off + SZ * SZ * 3 > size) {
            free(codes);
            free(dsc);
            return false;
        }
        codes[i] = code;
        fill_dsc(&dsc[i], buf + off);
    }
    pack_codes = codes;
    pack_dsc = dsc;
    pack_n = n;
    return true;
}

// True when a colour image exists for this code point, the UI fonts use it to skip their own monochrome glyph
extern "C" bool emoji_color_has(uint32_t cp)
{
    if (!color_ready)
        return false;
    if (find_code(builtin_codes, BUILTIN_N, cp) >= 0)
        return true;
    return pack_n && find_code(pack_codes, pack_n, cp) >= 0;
}
