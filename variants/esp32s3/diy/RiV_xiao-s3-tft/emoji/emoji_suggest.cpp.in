// Emoji suggestions while typing: ":fi" in the message box shows matching emoji in a strip above the box, tap one to replace the token
#include "lvgl.h"
#include <ctype.h>
#include <stdint.h>
#include <string.h>
#include <Preferences.h>

#include "emoji_names.inc"

static const int MAX_SUGGESTIONS = 8;
extern "C" bool emoji_reply_active(void);
static lv_obj_t *g_strip = nullptr;
static lv_obj_t *g_ta = nullptr;
static bool g_picking = false;

static int utf8_encode(uint32_t cp, char *out)
{
    if (cp < 0x80) {
        out[0] = (char)cp;
        out[1] = 0;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        out[2] = 0;
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        out[3] = 0;
        return 3;
    }
    out[0] = (char)(0xF0 | (cp >> 18));
    out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
    out[3] = (char)(0x80 | (cp & 0x3F));
    out[4] = 0;
    return 4;
}

// token is a colon that starts the text or follows a space, then one or more letters up to the end of the text
static bool find_token(const char *t, char *query, int qsize, int *tokenLen)
{
    int n = (int)strlen(t);
    int i = n;
    while (i > 0 && isalpha((unsigned char)t[i - 1]))
        i--;
    int letters = n - i;
    if (letters < 1 || letters >= qsize || i < 1 || t[i - 1] != ':')
        return false;
    if (i - 1 > 0 && t[i - 2] != ' ')
        return false;
    for (int k = 0; k < letters; k++)
        query[k] = (char)tolower((unsigned char)t[i + k]);
    query[letters] = 0;
    *tokenLen = letters + 1;
    return true;
}

// 0 = first word starts with the query, 1 = a later word does, -1 = no match
static int match_rank(const char *words, const char *q)
{
    size_t ql = strlen(q);
    const char *p = words;
    int word = 0;
    while (*p) {
        while (*p == ' ')
            p++;
        if (!*p)
            break;
        if (strncmp(p, q, ql) == 0)
            return word == 0 ? 0 : 1;
        while (*p && *p != ' ')
            p++;
        word++;
    }
    return -1;
}

static void hide_strip(void)
{
    if (g_strip)
        lv_obj_add_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
}

static void pick_cb(lv_event_t *e)
{
    lv_obj_t *label = (lv_obj_t *)lv_event_get_target(e);
    uint32_t code = (uint32_t)(uintptr_t)lv_obj_get_user_data(label);
    char query[16];
    int tokenLen = 0;
    if (!g_ta || !find_token(lv_textarea_get_text(g_ta), query, sizeof(query), &tokenLen))
        return;
    char utf8[5];
    utf8_encode(code, utf8);
    g_picking = true;
    lv_textarea_set_cursor_pos(g_ta, LV_TEXTAREA_CURSOR_LAST);
    for (int k = 0; k < tokenLen; k++)
        lv_textarea_delete_char(g_ta);
    lv_textarea_add_text(g_ta, utf8);
    g_picking = false;
    hide_strip();
}

static void text_changed_cb(lv_event_t *e)
{
    if (g_picking || !g_strip || !g_ta)
        return;
    char query[16];
    int tokenLen = 0;
    if (!find_token(lv_textarea_get_text(g_ta), query, sizeof(query), &tokenLen)) {
        hide_strip();
        return;
    }
    uint32_t hits[MAX_SUGGESTIONS];
    int count = 0;
    for (int pass = 0; pass < 2; pass++) {
        for (unsigned i = 0; i < sizeof(emoji_names) / sizeof(emoji_names[0]) && count < MAX_SUGGESTIONS; i++) {
            if (match_rank(emoji_names[i].words, query) == pass)
                hits[count++] = emoji_names[i].code;
        }
    }
    if (count == 0) {
        hide_strip();
        return;
    }
    lv_obj_clean(g_strip);
    for (int i = 0; i < count; i++) {
        char utf8[5];
        utf8_encode(hits[i], utf8);
        lv_obj_t *label = lv_label_create(g_strip);
        lv_label_set_text(label, utf8);
        lv_obj_set_style_pad_all(label, 5, 0);
        lv_obj_set_user_data(label, (void *)(uintptr_t)hits[i]);
        lv_obj_add_flag(label, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_add_event_cb(label, pick_cb, LV_EVENT_CLICKED, nullptr);
    }
    lv_obj_remove_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
    lv_obj_align_to(g_strip, g_ta, LV_ALIGN_OUT_TOP_LEFT, 0, emoji_reply_active() ? -40 : -2);
    lv_obj_move_foreground(g_strip);
}

extern "C" void emoji_suggest_init(lv_obj_t *ta)
{
    if (g_strip || !ta)
        return;
    g_ta = ta;
    lv_obj_t *parent = lv_obj_get_parent(ta);
    g_strip = lv_obj_create(parent);
    lv_obj_set_size(g_strip, LV_SIZE_CONTENT, 34);
    lv_obj_set_flex_flow(g_strip, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(g_strip, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_remove_flag(g_strip, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_style_bg_color(g_strip, lv_color_hex(0xDFE3EE), 0);
    lv_obj_set_style_bg_opa(g_strip, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(g_strip, 0, 0);
    lv_obj_set_style_radius(g_strip, 6, 0);
    lv_obj_set_style_pad_all(g_strip, 2, 0);
    lv_obj_set_style_pad_gap(g_strip, 0, 0);
    lv_obj_add_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_event_cb(ta, text_changed_cb, LV_EVENT_VALUE_CHANGED, nullptr);
}

// Setting: show the sender's long name instead of the 4 character short name in group chat bubbles, kept in NVS
extern "C" void add_style_settings_button_style(lv_obj_t *obj);

static bool g_longNames = false;
static lv_obj_t *g_namesLabel = nullptr;

extern "C" bool emoji_long_names(void)
{
    return g_longNames;
}

static void names_text(void)
{
    if (g_namesLabel)
        lv_label_set_text(g_namesLabel, g_longNames ? "Chat names: long" : "Chat names: short");
}

static void names_click_cb(lv_event_t *e)
{
    g_longNames = !g_longNames;
    Preferences prefs;
    if (prefs.begin("chatui", false)) {
        prefs.putBool("longnames", g_longNames);
        prefs.end();
    }
    names_text();
}

// adds the entry to the settings list, right below the button given
extern "C" void emoji_settings_init(lv_obj_t *anchor)
{
    if (g_namesLabel || !anchor)
        return;
    Preferences prefs;
    if (prefs.begin("chatui", true)) {
        g_longNames = prefs.getBool("longnames", false);
        prefs.end();
    }
    lv_obj_t *parent = lv_obj_get_parent(anchor);
    lv_obj_t *btn = lv_button_create(parent);
    lv_obj_set_pos(btn, 0, 0);
    lv_obj_set_size(btn, LV_PCT(95), 30);
    add_style_settings_button_style(btn);
    lv_obj_set_style_align(btn, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_shadow_width(btn, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_left(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_right(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(btn, lv_color_hex(0x4db270), LV_PART_MAIN | LV_STATE_PRESSED);
    lv_obj_set_style_text_color(btn, lv_color_hex(0x015114), LV_PART_MAIN | LV_STATE_PRESSED);
    g_namesLabel = lv_label_create(btn);
    lv_obj_set_size(g_namesLabel, LV_PCT(100), LV_SIZE_CONTENT);
    lv_label_set_long_mode(g_namesLabel, LV_LABEL_LONG_DOT);
    lv_obj_set_style_align(g_namesLabel, LV_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
    names_text();
    lv_obj_add_event_cb(btn, names_click_cb, LV_EVENT_CLICKED, nullptr);
    lv_obj_move_to_index(btn, lv_obj_get_index(anchor) + 1);
}

// Replies and reactions carry the id of the message they answer. Remember the last few text messages so a reply can show a
// quote line with what it answers, like the phone app does.
struct QuoteEntry {
    uint32_t id;
    char text[40];
};
static QuoteEntry g_quotes[16];
static int g_quoteNext = 0;

static void quote_store(uint32_t id, const char *text, size_t len)
{
    if (id == 0)
        return;
    QuoteEntry &e = g_quotes[g_quoteNext];
    g_quoteNext = (g_quoteNext + 1) % 16;
    e.id = id;
    size_t n = len < 34 ? len : 34;
    if (len > 34)
        while (n > 0 && ((unsigned char)text[n] & 0xC0) == 0x80)
            n--;
    memcpy(e.text, text, n);
    for (size_t i = 0; i < n; i++)
        if (e.text[i] == '\n')
            e.text[i] = ' ';
    if (len > 34) {
        e.text[n++] = '.';
        e.text[n++] = '.';
    }
    e.text[n] = 0;
}

extern "C" void emoji_quote_record(uint32_t id, const char *text)
{
    quote_store(id, text, strlen(text));
}

// returns the text to show: for a reply or a reaction a quote line comes first, then the message
extern "C" size_t emoji_quote_compose(uint32_t id, uint32_t replyId, uint32_t emojiFlag, const char *payload, size_t size, char *out,
                                      size_t outSize)
{
    size_t pos = 0;
    if (replyId != 0 || emojiFlag != 0) {
        const char *orig = nullptr;
        for (int i = 0; i < 16; i++)
            if (g_quotes[i].id == replyId && replyId != 0)
                orig = g_quotes[i].text;
        int w = snprintf(out, outSize, "> %s\n", orig ? orig : "earlier message");
        pos = (w < 0) ? 0 : ((size_t)w < outSize ? (size_t)w : outSize - 1);
    }
    quote_store(id, payload, size);
    size_t room = outSize - 1 - pos;
    size_t n = size < room ? size : room;
    memcpy(out + pos, payload, n);
    out[pos + n] = 0;
    return pos + n;
}

extern "C" lv_obj_t *emoji_textarea(void)
{
    return g_ta;
}
