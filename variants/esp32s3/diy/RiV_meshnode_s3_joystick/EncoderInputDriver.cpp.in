#ifdef INPUTDRIVER_ENCODER_TYPE

#include "input/EncoderInputDriver.h"
#include "Arduino.h"
#include "util/ILog.h"
#include <limits.h>

volatile EncoderInputDriver::EncoderActionType EncoderInputDriver::action = TB_ACTION_NONE;

// JOYSTICK NAVIGATION STATE
static lv_obj_t *joyLastNav = NULL;
static lv_obj_t *joyLastContent = NULL;
static bool joyChatScrolling = false;
static void joyChatEnd(void);
// outlines the message nearest to the middle of the chat list; open = show its menu (emoji_bubbles.cpp.in)
extern "C" __attribute__((weak)) bool emoji_joy_chat_pick(lv_obj_t *chat, bool open);

// the OK button that opened a menu must not also press inside it
static bool joySwallowOk = false;

// WIDGETS, SET BY TFTView_320x240.cpp
lv_obj_t *joyHomeButton = NULL;
lv_obj_t *joyMessagesPanel = NULL;
lv_obj_t *joyMessageInput = NULL;
lv_obj_t *joyKeyboardButton = NULL;
lv_obj_t *joyChatsPanel = NULL;
lv_obj_t *joyMapPanel = NULL;
lv_obj_t *joyArrowUpButton = NULL;
lv_obj_t *joyArrowDownButton = NULL;
lv_obj_t *joyArrowLeftButton = NULL;
lv_obj_t *joyArrowRightButton = NULL;
lv_obj_t *joyZoomInButton = NULL;
lv_obj_t *joyZoomOutButton = NULL;

static void joyChatEnd(void)
{
    if (joyChatScrolling && emoji_joy_chat_pick)
        emoji_joy_chat_pick(NULL, false);
    joyChatScrolling = false;
}

// DIRECTIONS, OPPOSITE = DIR ^ 1
enum { JOY_LEFT = 0, JOY_RIGHT = 1, JOY_UP = 2, JOY_DOWN = 3 };

// counts every joystick press (OK or a direction), the screensaver reads it to unlock
extern "C" uint32_t emoji_joy_count = 0;

// B/I format toggle — provided by emoji_compose.cpp.in; no-op if compose not compiled in
extern "C" __attribute__((weak)) void emoji_format_key(int kind);

// NAVIGATION BAR = CONTAINER OF THE HOME BUTTON (LEFT COLUMN IN LANDSCAPE, BOTTOM ROW IN PORTRAIT)
static lv_obj_t *joyNavBar(void)
{
    return joyHomeButton ? lv_obj_get_parent(joyHomeButton) : NULL;
}

static bool joyIsNav(lv_obj_t *o)
{
    lv_obj_t *bar = joyNavBar();
    return bar && o && lv_obj_get_parent(o) == bar;
}

// DIRECTION THAT LEADS FROM THE CONTENT TO THE NAVIGATION BAR
static int joyBackDir(void)
{
    lv_obj_t *bar = joyNavBar();
    if (!bar)
        return JOY_LEFT;
    lv_area_t a;
    lv_obj_get_coords(bar, &a);
    lv_display_t *d = lv_display_get_default();
    int sw = d ? lv_display_get_horizontal_resolution(d) : 320;
    int sh = d ? lv_display_get_vertical_resolution(d) : 240;
    if ((a.x2 - a.x1) > (a.y2 - a.y1))
        return ((a.y1 + a.y2) / 2 > sh / 2) ? JOY_DOWN : JOY_UP;
    return ((a.x1 + a.x2) / 2 < sw / 2) ? JOY_LEFT : JOY_RIGHT;
}

static void joyTrack(void)
{
    lv_group_t *g = lv_group_get_default();
    lv_obj_t *f = g ? lv_group_get_focused(g) : NULL;
    if (!f)
        return;
    // CHAT TEXT FIELD IS NOT A STOP, THE KEYBOARD BUTTON OPENS THE KEYBOARD
    if (f == joyMessageInput && joyKeyboardButton && lv_obj_is_visible(joyKeyboardButton)) {
        lv_group_focus_obj(joyKeyboardButton);
        return;
    }
    if (joyIsNav(f))
        joyLastNav = f;
    else
        joyLastContent = f;
}

// NEAREST FOCUSABLE OBJECT IN A DIRECTION, LIKE A PHONE DPAD
static lv_obj_t *joyNeighbor(lv_group_t *g, lv_obj_t *cur, int dir, bool sameRegion)
{
    int dx = dir == JOY_RIGHT ? 1 : dir == JOY_LEFT ? -1 : 0;
    int dy = dir == JOY_DOWN ? 1 : dir == JOY_UP ? -1 : 0;
    lv_area_t c;
    lv_obj_get_coords(cur, &c);
    int cx = (c.x1 + c.x2) / 2;
    int cy = (c.y1 + c.y2) / 2;
    bool curNav = joyIsNav(cur);
    lv_obj_t *best = NULL;
    long bestScore = LONG_MAX;
    uint32_t n = lv_group_get_obj_count(g);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *o = lv_group_get_obj_by_index(g, i);
        if (!o || o == cur || o == joyMessageInput || !lv_obj_is_visible(o) || lv_obj_has_state(o, LV_STATE_DISABLED))
            continue;
        if (sameRegion && joyIsNav(o) != curNav)
            continue;
        lv_area_t a;
        lv_obj_get_coords(o, &a);
        int ox = (a.x1 + a.x2) / 2;
        int oy = (a.y1 + a.y2) / 2;
        int along = dx ? (ox - cx) * dx : (oy - cy) * dy;
        int across = dx ? oy - cy : ox - cx;
        if (along <= 0)
            continue;
        if (across < 0)
            across = -across;
        long score = along + 3L * across;
        if (score < bestScore) {
            bestScore = score;
            best = o;
        }
    }
    return best;
}

// VISIBLE MESSAGE LIST OF THE CHAT PANEL
static lv_obj_t *joyFindChat(void)
{
    lv_obj_t *p = joyMessagesPanel;
    if (!p)
        return NULL;
    uint32_t n = lv_obj_get_child_count(p);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *c = lv_obj_get_child(p, i);
        if (!lv_obj_has_class(c, &lv_obj_class) || !lv_obj_is_visible(c) || !lv_obj_has_flag(c, LV_OBJ_FLAG_SCROLLABLE) ||
            lv_obj_get_height(c) < 80)
            continue;
        return c;
    }
    return NULL;
}

// CHAT: UP FROM THE KEYBOARD BUTTON SCROLLS THE MESSAGES, DOWN TO THE END RETURNS TO THE BUTTON
static bool joyChatNavigate(lv_obj_t *f, bool up, bool down)
{
    if (f != joyKeyboardButton || !joyMessagesPanel || !lv_obj_is_visible(joyMessagesPanel)) {
        joyChatEnd();
        return false;
    }
    lv_obj_t *chat = joyFindChat();
    if (!chat) {
        joyChatEnd();
        return false;
    }
    const int32_t step = 48;
    int32_t top = lv_obj_get_scroll_top(chat);
    int32_t bottom = lv_obj_get_scroll_bottom(chat);
    // ENTER THE MESSAGE LIST WHEN IT HAS ANYTHING TO SCROLL
    if (up && !joyChatScrolling && (top > 0 || bottom > 0))
        joyChatScrolling = true;
    if (!joyChatScrolling)
        return false;
    if (up) {
        if (top > 0)
            lv_obj_scroll_by(chat, 0, top < step ? top : step, LV_ANIM_OFF);
        if (emoji_joy_chat_pick)
            emoji_joy_chat_pick(chat, false);
        return true;
    }
    if (down) {
        if (bottom > 0)
            lv_obj_scroll_by(chat, 0, -(bottom < step ? bottom : step), LV_ANIM_OFF);
        if (lv_obj_get_scroll_bottom(chat) <= 0)
            joyChatEnd();
        else if (emoji_joy_chat_pick)
            emoji_joy_chat_pick(chat, false);
        return true;
    }
    return false;
}

// NEXT FOCUSABLE SIBLING ABOVE/BELOW IN THE SAME LIST, INCLUDING ROWS SCROLLED OFF SCREEN
static lv_obj_t *joyListNeighbor(lv_obj_t *f, bool down)
{
    lv_obj_t *p = lv_obj_get_parent(f);
    lv_group_t *g = lv_obj_get_group(f);
    if (!p || !g)
        return NULL;
    lv_area_t fa;
    lv_obj_get_coords(f, &fa);
    lv_obj_t *best = NULL;
    int bestY = INT_MAX;
    uint32_t n = lv_obj_get_child_count(p);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *c = lv_obj_get_child(p, i);
        if (c == f || c == joyMessageInput || lv_obj_get_group(c) != g || lv_obj_has_flag(c, LV_OBJ_FLAG_HIDDEN) ||
            lv_obj_has_state(c, LV_STATE_DISABLED))
            continue;
        lv_area_t a;
        lv_obj_get_coords(c, &a);
        if (a.x2 < fa.x1 || a.x1 > fa.x2)
            continue;
        int dy = down ? a.y1 - fa.y1 : fa.y1 - a.y1;
        if (dy <= 0)
            continue;
        if (dy < bestY) {
            bestY = dy;
            best = c;
        }
    }
    return best;
}

// FIRST GROUP MEMBER INSIDE AN OBJECT (THE OBJECT ITSELF OR THE FIRST BUTTON IN ITS SUBTREE)
static lv_obj_t *joyFirstFocusable(lv_obj_t *o, lv_group_t *g)
{
    if (lv_obj_get_group(o) == g && !lv_obj_has_state(o, LV_STATE_DISABLED))
        return o;
    uint32_t n = lv_obj_get_child_count(o);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *r = joyFirstFocusable(lv_obj_get_child(o, i), g);
        if (r)
            return r;
    }
    return NULL;
}

// NEXT ROW OF THE NEAREST SCROLLABLE LIST, ALSO WHEN IT IS SCROLLED OFF SCREEN (NODE LIST, CHANNEL LIST WITH ITS SAVE AND CANCEL ROW)
static lv_obj_t *joyRowNeighbor(lv_obj_t *f, bool down)
{
    lv_group_t *g = lv_obj_get_group(f);
    if (!g)
        return NULL;
    for (lv_obj_t *a = f; a && lv_obj_get_parent(a); a = lv_obj_get_parent(a)) {
        lv_obj_t *p = lv_obj_get_parent(a);
        if (!lv_obj_has_flag(p, LV_OBJ_FLAG_SCROLLABLE))
            continue;
        lv_area_t fa;
        lv_obj_get_coords(a, &fa);
        lv_obj_t *best = NULL;
        int bestDy = INT_MAX;
        uint32_t n = lv_obj_get_child_count(p);
        for (uint32_t i = 0; i < n; i++) {
            lv_obj_t *c = lv_obj_get_child(p, i);
            if (c == a || lv_obj_has_flag(c, LV_OBJ_FLAG_HIDDEN))
                continue;
            lv_area_t ca;
            lv_obj_get_coords(c, &ca);
            int dy = down ? ca.y1 - fa.y1 : fa.y1 - ca.y1;
            if (dy <= 0 || dy >= bestDy)
                continue;
            lv_obj_t *t = joyFirstFocusable(c, g);
            if (!t)
                continue;
            bestDy = dy;
            best = t;
        }
        return best; // the nearest scrollable list decides, NULL means the end of it
    }
    return NULL;
}

static void joyNavigate(lv_indev_data_t *data, bool up, bool down, bool left, bool right)
{
    lv_group_t *g = lv_group_get_default();
    lv_obj_t *f = g ? lv_group_get_focused(g) : NULL;
    if (!f) {
        data->enc_diff = (up || left) ? -1 : 1;
        return;
    }

    // KEYBOARD: REAL DIRECTION KEYS
    if (lv_obj_has_class(f, &lv_keyboard_class)) {
        joyChatEnd();
        data->key = up ? LV_KEY_UP : down ? LV_KEY_DOWN : left ? LV_KEY_LEFT : LV_KEY_RIGHT;
        data->state = LV_INDEV_STATE_PRESSED;
        return;
    }

    // SLIDER: LEFT/RIGHT ADJUST
    if ((left || right) && lv_obj_has_class(f, &lv_slider_class)) {
        data->key = left ? LV_KEY_DOWN : LV_KEY_UP;
        data->state = LV_INDEV_STATE_PRESSED;
        return;
    }

    // DROPDOWN WITH ITS LIST OPEN: UP/LEFT IS THE PREVIOUS OPTION, DOWN/RIGHT THE NEXT ONE
    if (lv_obj_has_class(f, &lv_dropdown_class) && lv_dropdown_is_open(f)) {
        data->enc_diff = (up || left) ? -1 : 1;
        return;
    }

    // CHAT SCROLL
    if ((up || down) && joyChatNavigate(f, up, down))
        return;
    if (left || right)
        joyChatEnd();

    int dir = left ? JOY_LEFT : right ? JOY_RIGHT : up ? JOY_UP : JOY_DOWN;
    int back = joyBackDir();
    int fwd = back ^ 1;
    lv_obj_t *t = NULL;

    if (joyIsNav(f)) {
        if (dir == fwd) {
            // BAR TO CONTENT: BACK TO THE LAST WIDGET
            if (joyLastContent && lv_obj_is_visible(joyLastContent) && !joyIsNav(joyLastContent))
                t = joyLastContent;
            else
                t = joyNeighbor(g, f, dir, false);
        } else if (dir != back) {
            // ALONG THE BAR
            t = joyNeighbor(g, f, dir, true);
        }
    } else {
        // MAP PANEL: SPATIAL DPAD NAVIGATION WITHIN MAP BUTTONS
        bool inMap = false;
        if (joyMapPanel && f) {
            for (lv_obj_t *p = lv_obj_get_parent(f); p; p = lv_obj_get_parent(p)) {
                if (p == joyMapPanel) { inMap = true; break; }
            }
        }
        if (inMap) {
            if (dir == back) {
                lv_obj_t *nb = (joyLastNav && lv_obj_is_visible(joyLastNav))
                                   ? joyLastNav
                                   : joyNeighbor(g, f, dir, false);
                if (nb)
                    lv_group_focus_obj(nb);
            } else {
                t = joyNeighbor(g, f, dir, true);
                if (t)
                    lv_group_focus_obj(t);
            }
            return;
        }
        // LANDSCAPE: UP/DOWN STEP THROUGH THE GROUP IN LIST ORDER, AS ON THE T-DECK
        if ((dir == JOY_UP || dir == JOY_DOWN) && (back == JOY_LEFT || back == JOY_RIGHT)) {
            // try spatial sibling first — handles buttons inserted out of group order (e.g. Advanced settings)
            lv_obj_t *row = joyListNeighbor(f, dir == JOY_DOWN);
            if (row) {
                lv_group_focus_obj(row);
                return;
            }
            // chats_panel adds items bottom-to-top, so focus_prev visually moves down — invert
            bool inChats = joyChatsPanel && f && lv_obj_get_parent(f) == joyChatsPanel;
            data->enc_diff = (up != inChats) ? -1 : 1;
            return;
        }
        // PORTRAIT: NEXT ROW, EVEN WHEN SCROLLED OFF SCREEN
        if (dir == JOY_UP || dir == JOY_DOWN) {
            lv_obj_t *row = joyListNeighbor(f, dir == JOY_DOWN);
            if (!row)
                row = joyRowNeighbor(f, dir == JOY_DOWN);
            if (row) {
                lv_group_focus_obj(row);
                return;
            }
        }
        // INSIDE THE CONTENT FIRST
        t = joyNeighbor(g, f, dir, true);
        if (!t && dir == back) {
            // CONTENT TO BAR: BACK TO THE LAST BUTTON
            if (joyLastNav && lv_obj_is_visible(joyLastNav))
                t = joyLastNav;
            else
                t = joyNeighbor(g, f, dir, false);
        } else if (!t && (dir == JOY_UP || dir == JOY_DOWN)) {
            // LISTS: STEP THROUGH THE GROUP, UP IS THE PREVIOUS ENTRY (THE CHATS LIST IS BUILT BOTTOM TO TOP)
            bool inChats = joyChatsPanel && f && lv_obj_get_parent(f) == joyChatsPanel;
            data->enc_diff = (up != inChats) ? -1 : 1;
        }
    }

    if (t)
        lv_group_focus_obj(t);
}

EncoderInputDriver::EncoderInputDriver(void) {}

void EncoderInputDriver::init(void)
{
    // trackball or joystick type encoder with four directions
    if (INPUTDRIVER_ENCODER_TYPE == 3) {
#ifdef INPUTDRIVER_ENCODER_LEFT
        pinMode(INPUTDRIVER_ENCODER_LEFT, INPUT_PULLUP);
        attachInterrupt(INPUTDRIVER_ENCODER_LEFT, intLeftHandler, FALLING);
#endif
#ifdef INPUTDRIVER_ENCODER_RIGHT
        pinMode(INPUTDRIVER_ENCODER_RIGHT, INPUT_PULLUP);
        attachInterrupt(INPUTDRIVER_ENCODER_RIGHT, intRightHandler, FALLING);
#endif
#ifdef INPUTDRIVER_ENCODER_UP
        pinMode(INPUTDRIVER_ENCODER_UP, INPUT_PULLUP);
        attachInterrupt(INPUTDRIVER_ENCODER_UP, intUpHandler, FALLING);
#endif
#ifdef INPUTDRIVER_ENCODER_DOWN
        pinMode(INPUTDRIVER_ENCODER_DOWN, INPUT_PULLUP);
        attachInterrupt(INPUTDRIVER_ENCODER_DOWN, intDownHandler, FALLING);
#endif
#ifdef INPUTDRIVER_ENCODER_BTN
        pinMode(INPUTDRIVER_ENCODER_BTN, INPUT_PULLUP);
#endif
    }

    encoder = lv_indev_create();
    lv_indev_set_type(encoder, LV_INDEV_TYPE_ENCODER);
    lv_indev_set_read_cb(encoder, encoder_read);

    if (!inputGroup) {
        inputGroup = lv_group_create();
        lv_group_set_default(inputGroup);
    }
    lv_indev_set_group(encoder, inputGroup);
}

void EncoderInputDriver::encoder_read(lv_indev_t *indev, lv_indev_data_t *data)
{
    // encoder w/o interrupts but read GPIOs directly
    if (INPUTDRIVER_ENCODER_TYPE == 1) {
#ifdef INPUTDRIVER_ENCODER_LEFT
        if (digitalRead(INPUTDRIVER_ENCODER_LEFT))
            data->enc_diff = -1;
#endif
#ifdef INPUTDRIVER_ENCODER_RIGHT
        if (digitalRead(INPUTDRIVER_ENCODER_RIGHT))
            data->enc_diff = 1;
#endif
#ifdef INPUTDRIVER_ENCODER_BTN
        // FIXME: need same logix as below to trigger LONG_PRESSED events
        if (!digitalRead(INPUTDRIVER_ENCODER_BTN)) {
            data->key = LV_KEY_ENTER;
            data->state = LV_INDEV_STATE_PRESSED;
        }
#endif
    }
    // trackball/joystick with additional up/down inputs to control sliders
    else if (INPUTDRIVER_ENCODER_TYPE == 3) {
        static uint32_t prevkey = 0;
        static uint32_t lastPressed = millis();

        data->key = 0;
        data->enc_diff = 0;
        data->state = LV_INDEV_STATE_RELEASED;

        joyTrack();

#ifdef INPUTDRIVER_ENCODER_BTN
        {
            static uint32_t joyBtnDownMs  = 0;
            static bool     joyBtnHandled = false;
            lv_group_t *_bg = lv_group_get_default();
            lv_obj_t   *_bf = _bg ? lv_group_get_focused(_bg) : NULL;
            bool kbdFocused = _bf && lv_obj_has_class(_bf, &lv_keyboard_class);
            bool btnNow = !digitalRead(INPUTDRIVER_ENCODER_BTN);
            if (joySwallowOk) {
                if (btnNow)
                    btnNow = false;
                else
                    joySwallowOk = false;
            }
            if (kbdFocused) {
                // keyboard: long-press (>500 ms) → B/I toggle; short press → ENTER
                if (btnNow) {
                    if (!joyBtnDownMs) { joyBtnDownMs = millis(); joyBtnHandled = false; }
                    if (!joyBtnHandled && millis() - joyBtnDownMs > 500) {
                        if (emoji_format_key) emoji_format_key(-1);
                        joyBtnHandled = true;
                    }
                } else {
                    if (joyBtnDownMs && !joyBtnHandled && action == TB_ACTION_NONE)
                        action = TB_ACTION_PRESSED;
                    joyBtnDownMs  = 0;
                    joyBtnHandled = false;
                }
            } else {
                // non-keyboard: original polling — sustains LV_EVENT_LONG_PRESSED
                joyBtnDownMs  = 0;
                joyBtnHandled = false;
                if (action == TB_ACTION_NONE && btnNow)
                    action = TB_ACTION_PRESSED;
            }
        }
#endif
        // slow down repeating key to max. four events per second
        // the button is an exception for LONG_PRESSED monitoring
        if (action != TB_ACTION_NONE && (action == TB_ACTION_PRESSED || millis() > lastPressed + 250)) {
            emoji_joy_count++;
            if (action == TB_ACTION_PRESSED && joyChatScrolling && emoji_joy_chat_pick) {
                // OK while reading the messages: the menu of the outlined message
                lv_obj_t *chat = joyFindChat();
                bool done = chat && emoji_joy_chat_pick(chat, true);
                joyChatEnd();
                if (done) {
                    joySwallowOk = true;
                    lastPressed = millis();
                    prevkey = 0;
                    action = TB_ACTION_NONE;
                    return;
                }
            }
            if (action == TB_ACTION_PRESSED) {
                joyChatEnd();
                data->key = LV_KEY_ENTER;
                data->state = LV_INDEV_STATE_PRESSED;
            } else {
                // moving the joystick is user activity, focus moves alone are not counted by LVGL and the screen would time out mid-scroll
                lv_display_trigger_activity(NULL);
                joyNavigate(data, action == TB_ACTION_UP, action == TB_ACTION_DOWN, action == TB_ACTION_LEFT,
                            action == TB_ACTION_RIGHT);
            }

            lastPressed = millis();
            prevkey = data->key;
            action = TB_ACTION_NONE;
        } else {
            // this logic is required for LONG_PRESSED event, see lv_indev.c
            if (prevkey != 0) {
                data->state = LV_INDEV_STATE_RELEASED;
                data->key = prevkey;
                prevkey = 0;
            }
        }
    }
}

void EncoderInputDriver::intPressHandler()
{
    action = TB_ACTION_PRESSED;
}

void EncoderInputDriver::intDownHandler()
{
    static uint32_t lastEdge = 0;
    uint32_t now = millis();
    if (now - lastEdge < 150)
        return;
    lastEdge = now;
    action = TB_ACTION_DOWN;
}

void EncoderInputDriver::intUpHandler()
{
    static uint32_t lastEdge = 0;
    uint32_t now = millis();
    if (now - lastEdge < 150)
        return;
    lastEdge = now;
    action = TB_ACTION_UP;
}

void EncoderInputDriver::intLeftHandler()
{
    static uint32_t lastEdge = 0;
    uint32_t now = millis();
    if (now - lastEdge < 150)
        return;
    lastEdge = now;
    action = TB_ACTION_LEFT;
}

void EncoderInputDriver::intRightHandler()
{
    static uint32_t lastEdge = 0;
    uint32_t now = millis();
    if (now - lastEdge < 150)
        return;
    lastEdge = now;
    action = TB_ACTION_RIGHT;
}

#endif
