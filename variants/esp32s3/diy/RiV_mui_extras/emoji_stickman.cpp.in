// Stickman arena for the screensaver (style "Stickman arena"). Two stick fighters use the whole screen and the screensaver's own parts as
// props: one climbs to the analog clock and rips off the minute hand as a sword, a toast with the last message is torn down as a shield,
// digits are plucked out of the digital clock and thrown. It is included into emoji_screensaver.cpp and runs only while plugged in.
#include <functional>
#include <initializer_list>
#include <utility>
#include <vector>

namespace sm
{
enum { LEAN, ROT, OX, OY, AF0, AF1, AB0, AB1, LF0, LF1, LB0, LB1, NP };
struct PoseS {
    float v[NP];
};
static const float TAU = 6.2831853f;
static PoseS GUARD;

static PoseS P(std::initializer_list<std::pair<int, float>> o)
{
    PoseS p = GUARD;
    for (auto &kv : o)
        p.v[kv.first] = kv.second;
    return p;
}
#define AF(a, b) {AF0, a}, {AF1, b}
#define AB(a, b) {AB0, a}, {AB1, b}
#define LF(a, b) {LF0, a}, {LF1, b}
#define LB(a, b) {LB0, a}, {LB1, b}

static PoseS lerpP(const PoseS &a, const PoseS &b, float u)
{
    PoseS r;
    for (int i = 0; i < NP; i++)
        r.v[i] = a.v[i] + (b.v[i] - a.v[i]) * u;
    return r;
}
static float smooth(float u)
{
    u = u < 0 ? 0 : (u > 1 ? 1 : u);
    return u * u * (3 - 2 * u);
}

struct Key {
    float t;
    PoseS p;
};
struct Move {
    const char *name;
    float d, hit, reach, dmg, kb, launch, lunge, jump;
    bool low, hasBlade;
    float b0, b1;
    std::vector<Key> keys;
};
enum { JAB, CROSS, HOOK, UPPER, KICK, ROUND, SWEEP, FLY, SPIN, TACKLE, SMASH, SLASH, THRUST, SPINSLASH, FLIP, FLINCH, NMOVES };
static Move g_mv[NMOVES];
static const int CLOSE_L[] = {JAB, CROSS, HOOK, UPPER, SWEEP, SMASH, TACKLE};
static const int MID_L[] = {KICK, ROUND, SPIN, CROSS, TACKLE, JAB};
static const int FAR_L[] = {FLY, TACKLE};
static const int SCLOSE_L[] = {SLASH, SWEEP, KICK};
static const int SMID_L[] = {SLASH, THRUST, SPINSLASH, ROUND};
static const int SFAR_L[] = {THRUST, FLY};
static PoseS KOPOSE, JUMPPOSE, HANG, PULL, CARRY;
static bool g_tablesDone = false;

static float rnd(void)
{
    return (float)(random(10000)) / 10000.0f;
}

static void mk(int id, const char *n, float d, float hit, float reach, float dmg, float kb, std::vector<Key> keys)
{
    Move &m = g_mv[id];
    m.name = n;
    m.d = d;
    m.hit = hit;
    m.reach = reach;
    m.dmg = dmg;
    m.kb = kb;
    m.launch = 0;
    m.lunge = 0;
    m.jump = 0;
    m.low = false;
    m.hasBlade = false;
    m.b0 = m.b1 = 0;
    m.keys = keys;
}

static void init_tables(void)
{
    if (g_tablesDone)
        return;
    g_tablesDone = true;
    const float G[NP] = {0.1f, 0, 0, 0, 0.9f, 2.4f, 0.5f, 2.6f, 0.5f, 0.2f, -0.5f, -0.3f};
    for (int i = 0; i < NP; i++)
        GUARD.v[i] = G[i];
    PoseS g0 = P({});
    mk(JAB, "jab", .30f, .45f, 1.05f, 6, 150, {{0, g0}, {.3f, P({{LEAN, .12f}, AF(.7f, 2.5f)})}, {.5f, P({{LEAN, .3f}, {OX, .3f}, AF(1.55f, 1.6f)})}, {.7f, P({{LEAN, .3f}, {OX, .3f}, AF(1.55f, 1.6f)})}, {1, g0}});
    mk(CROSS, "cross", .44f, .5f, 1.15f, 10, 240, {{0, g0}, {.3f, P({{LEAN, -.15f}, AB(.2f, 1.2f), AF(.6f, 2.5f)})}, {.55f, P({{LEAN, .5f}, {OX, .7f}, AB(1.55f, 1.6f), AF(.3f, 2.4f), LB(-.9f, -.4f)})}, {.75f, P({{LEAN, .5f}, {OX, .7f}, AB(1.55f, 1.6f), AF(.3f, 2.4f), LB(-.9f, -.4f)})}, {1, g0}});
    mk(HOOK, "hook", .52f, .52f, 1.05f, 11, 260, {{0, g0}, {.35f, P({{LEAN, -.2f}, AF(-.7f, .4f), {OY, .3f}})}, {.55f, P({{LEAN, .35f}, {OX, .4f}, AF(2.0f, 1.3f), {OY, .2f}})}, {.75f, P({{LEAN, .4f}, {OX, .4f}, AF(1.9f, 1.0f)})}, {1, g0}});
    mk(UPPER, "uppercut", .52f, .58f, .95f, 12, 120, {{0, g0}, {.35f, P({{OY, .95f}, {LEAN, .15f}, AF(.3f, .8f), LF(.9f, .1f), LB(-.9f, -.4f)})}, {.62f, P({{OY, -.5f}, {LEAN, .2f}, AF(2.7f, 3.0f), LF(.4f, .3f), LB(-.3f, -.1f)})}, {.8f, P({{OY, -.4f}, AF(2.7f, 3.0f)})}, {1, g0}});
    g_mv[UPPER].launch = -760;
    mk(KICK, "front kick", .46f, .5f, 1.35f, 9, 260, {{0, g0}, {.3f, P({{LEAN, -.1f}, LF(1.3f, .3f)})}, {.52f, P({{LEAN, -.25f}, LF(1.55f, 1.55f), AB(.3f, 2.6f)})}, {.7f, P({{LEAN, -.25f}, LF(1.55f, 1.55f)})}, {1, g0}});
    mk(ROUND, "roundhouse", .62f, .55f, 1.45f, 13, 340, {{0, g0}, {.3f, P({{LEAN, -.2f}, LF(1.0f, .2f)})}, {.58f, P({{LEAN, -.55f}, {ROT, -.35f}, LF(1.75f, 2.0f), AF(1.0f, 2.8f), AB(.8f, 2.8f)})}, {.78f, P({{LEAN, -.5f}, {ROT, -.3f}, LF(1.5f, 1.8f)})}, {1, g0}});
    mk(SWEEP, "low sweep", .58f, .55f, 1.25f, 8, 80, {{0, g0}, {.3f, P({{OY, 2.0f}, {LEAN, .25f}, LF(.5f, .2f), LB(-1.5f, -1.3f), AF(.4f, 1.4f)})}, {.62f, P({{OY, 2.0f}, {LEAN, .35f}, LB(1.3f, 1.6f), LF(-.2f, -.1f), AF(.2f, 1.4f)})}, {.82f, P({{OY, 1.7f}, {LEAN, .3f}, LB(1.2f, 1.5f)})}, {1, g0}});
    g_mv[SWEEP].low = true;
    g_mv[SWEEP].launch = -380;
    mk(FLY, "flying kick", .74f, .5f, 1.7f, 14, 420, {{0, g0}, {.25f, P({{OY, .5f}, {LEAN, -.15f}})}, {.5f, P({{ROT, -.95f}, {OY, -.4f}, LF(1.5f, 1.6f), LB(-.6f, -.7f), AF(.4f, 1.2f), AB(-.4f, .6f)})}, {.8f, P({{ROT, -.9f}, {OY, -.4f}, LF(1.5f, 1.6f), LB(-.6f, -.7f)})}, {1, g0}});
    g_mv[FLY].lunge = 520;
    g_mv[FLY].jump = -560;
    mk(SPIN, "spin kick", .8f, .62f, 1.55f, 15, 420, {{0, g0}, {.2f, P({{OY, .4f}, {LEAN, .2f}})}, {.62f, P({{ROT, -TAU * .75f}, LF(1.6f, 1.7f), AF(1.3f, 1.5f), AB(-1.3f, -1.5f)})}, {.9f, P({{ROT, -TAU}, LF(.8f, .6f)})}, {1, g0}});
    mk(TACKLE, "shoulder tackle", .52f, .42f, 1.1f, 10, 300, {{0, g0}, {.25f, P({{LEAN, .7f}, {OX, .3f}, AF(.3f, .4f), AB(.2f, .3f)})}, {.5f, P({{LEAN, 1.05f}, {OX, .9f}, AF(.2f, .3f), AB(.1f, .2f), LF(1.0f, .6f), LB(-1.0f, -.8f)})}, {.8f, P({{LEAN, 1.0f}, {OX, .9f}})}, {1, g0}});
    g_mv[TACKLE].lunge = 560;
    mk(SMASH, "overhead smash", .64f, .62f, 1.05f, 14, 260, {{0, g0}, {.35f, P({{LEAN, -.25f}, AF(2.9f, 3.1f), AB(2.9f, 3.1f), LF(.3f, .2f)})}, {.62f, P({{LEAN, .55f}, {OY, .45f}, AF(1.2f, 1.3f), AB(1.2f, 1.3f)})}, {.82f, P({{LEAN, .5f}, {OY, .4f}, AF(1.1f, 1.2f), AB(1.1f, 1.2f)})}, {1, g0}});
    g_mv[SMASH].launch = -300;
    mk(SLASH, "sword slash", .5f, .55f, 1.9f, 22, 300, {{0, g0}, {.3f, P({{LEAN, -.2f}, AF(3.0f, 3.1f), AB(2.4f, 2.6f)})}, {.58f, P({{LEAN, .5f}, {OX, .4f}, AF(1.5f, 1.5f), AB(.5f, .9f)})}, {.8f, P({{LEAN, .45f}, {OX, .4f}, AF(1.4f, 1.4f)})}, {1, g0}});
    g_mv[SLASH].hasBlade = true;
    g_mv[SLASH].b0 = -.7f;
    g_mv[SLASH].b1 = 2.3f;
    mk(THRUST, "sword thrust", .5f, .5f, 2.1f, 20, 380, {{0, g0}, {.3f, P({{LEAN, -.2f}, AF(.6f, 1.0f), {OY, .3f}, LF(.9f, .4f)})}, {.55f, P({{LEAN, .45f}, {OX, .8f}, AF(1.45f, 1.5f), LF(1.0f, .5f), LB(-1.1f, -.9f)})}, {.8f, P({{LEAN, .45f}, {OX, .8f}, AF(1.45f, 1.5f)})}, {1, g0}});
    g_mv[THRUST].hasBlade = true;
    g_mv[THRUST].b0 = 1.45f;
    g_mv[THRUST].b1 = 1.57f;
    g_mv[THRUST].lunge = 420;
    mk(SPINSLASH, "spin slash", .7f, .6f, 1.9f, 24, 380, {{0, g0}, {.2f, P({{OY, .3f}, AF(1.4f, 1.5f)})}, {.6f, P({{ROT, -TAU * .7f}, AF(1.57f, 1.57f), AB(-1.2f, -1.0f)})}, {.9f, P({{ROT, -TAU}, AF(1.4f, 1.4f)})}, {1, g0}});
    g_mv[SPINSLASH].hasBlade = true;
    g_mv[SPINSLASH].b0 = g_mv[SPINSLASH].b1 = 1.57f;
    mk(FLIP, "backflip", .62f, 2, 0, 0, 0, {{0, g0}, {.25f, P({{OY, .6f}, {LEAN, -.2f}, AF(2.6f, 2.9f), AB(2.6f, 2.9f)})}, {.55f, P({{ROT, TAU * .5f}, {OY, -.3f}, LF(.9f, 1.5f), LB(.4f, 1.2f), AF(1.0f, 1.8f), AB(.9f, 1.7f)})}, {.9f, P({{ROT, TAU}, {OY, -.1f}})}, {1, g0}});
    g_mv[FLIP].lunge = -300;
    g_mv[FLIP].jump = -720;
    mk(FLINCH, "hit", .34f, 2, 0, 0, 0, {{0, g0}, {.25f, P({{LEAN, -.5f}, {ROT, -.25f}, AF(2.6f, 2.9f), AB(2.0f, 2.4f), LF(.8f, .3f), LB(-.7f, -.4f)})}, {.7f, P({{LEAN, -.45f}, {ROT, -.2f}, AF(2.4f, 2.7f), AB(1.8f, 2.2f)})}, {1, g0}});
    KOPOSE = P({{LEAN, .1f}, {ROT, -1.45f}, {OY, -.1f}, AF(.3f, .4f), AB(-.3f, -.2f), LF(.3f, .2f), LB(-.3f, -.2f)});
    JUMPPOSE = P({{LEAN, .15f}, {OY, -.1f}, AF(2.5f, 2.8f), AB(2.2f, 2.6f), LF(.9f, 1.6f), LB(.2f, 1.1f)});
    HANG = P({{LEAN, 0}, AF(3.0f, 3.05f), AB(2.9f, 3.0f), LF(.3f, .2f), LB(-.2f, -.1f)});
    PULL = P({{LEAN, .05f}, AF(2.6f, 3.0f), AB(2.4f, 2.9f), LF(.4f, .3f), LB(-.4f, -.3f)});
    CARRY = P({{LEAN, -.1f}, AF(2.9f, 3.05f), AB(2.8f, 2.95f), LF(.3f, .2f), LB(-.3f, -.2f)});
}

static PoseS sample(const std::vector<Key> &k, float u)
{
    if (u <= k[0].t)
        return k[0].p;
    for (size_t i = 1; i < k.size(); i++)
        if (u <= k[i].t)
            return lerpP(k[i - 1].p, k[i].p, smooth((u - k[i - 1].t) / (k[i].t - k[i - 1].t)));
    return k.back().p;
}
static PoseS runPose(float ph)
{
    float s = sinf(ph), c = fabsf(cosf(ph));
    return P({{LEAN, .28f}, {OY, -c * .3f}, AF(-s * .9f + .3f, -s * .9f + 1.6f), AB(s * .9f + .3f, s * .9f + 1.6f), LF(s, s - .8f * (s > 0 ? 0 : 1)), LB(-s, -s - .8f * (-s > 0 ? 0 : 1))});
}
static PoseS idlePose(float t)
{
    float b = sinf(t * 3) * .08f;
    return P({{OY, b}, {LEAN, .1f + b * .2f}});
}
// front hand in feet-local coordinates, rotation about the hip applied
static void handFeet(const PoseS &p, float h, float *ox, float *oy)
{
    float u = h / 10, hx = p.v[OX] * u, hy = -4.2f * u + p.v[OY] * u;
    float sx = sinf(p.v[LEAN]) * 3.4f * u, sy = -cosf(p.v[LEAN]) * 3.4f * u;
    float x1 = sx + sinf(p.v[AF0]) * 1.5f * u, y1 = sy + cosf(p.v[AF0]) * 1.5f * u;
    float x2 = x1 + sinf(p.v[AF1]) * 1.4f * u, y2 = y1 + cosf(p.v[AF1]) * 1.4f * u;
    float c = cosf(p.v[ROT]), s = sinf(p.v[ROT]);
    *ox = hx + x2 * c - y2 * s;
    *oy = hy + x2 * s + y2 * c;
}

// ---------- state ----------
enum { SQ_RUN, SQ_JUMP, SQ_HOLD, SQ_PULL, SQ_FALL, SQ_ANIM, SQ_DO };
struct Step {
    int type = SQ_DO;
    float x = 0, y = 0, dur = 0, arc = 0, dy = 0, speed = 0, x0 = 0, y0 = 0;
    int face = 1;
    PoseS pose, pose2, p0;
    std::vector<Key> keys;
    std::function<void()> fn;
    std::function<void(float)> on;
};
struct Seq {
    std::vector<Step> steps;
    size_t i = 0;
    float t = 0;
    bool init = false;
};
struct Fighter {
    float x, y, vx, vy, hp, fh, sp, ds, dm, cd, throwCd;
    int face;
    uint32_t col;
    bool wide, ko, air, sword;
    PoseS pose;
    bool moving;
    int mv;
    float mt, mdur;
    bool mhit;
    PoseS mfrom;
    int lastMove;
    Seq *seq;
    float hwx, hwy;
    char id;
};
enum { HC_CLOCK, HC_GRIPPED, HC_PULLED, HC_HELD, HC_FLYING };
enum { T_NONE, T_IN, T_GRIPPED, T_PULLED, T_CARRIED, T_HELD, T_CRUMPLE };
enum { PK_NONE, PK_ATTACHED, PK_GRIPPED, PK_PULLED, PK_CARRIED, PK_THROWN, PK_RESPAWN };
struct Glyph {
    float x, y, vx, vy, spin;
    char ch;
    Fighter *owner;
    bool dead;
};
struct Spark {
    float x, y, t;
    uint32_t col;
};
struct Pop {
    float x, y, t;
    char text[10];
};
struct Layout {
    bool an = false, dg = false;
    float cx = 0, cy = 0, r = 0;
    float dgY = 0, dgSize = 0, dgW = 0;
    float dig[4];
    char str[8];
    float toastY = 24, toastW = 200, toastH = 28;
};

static lv_obj_t *g_arena = nullptr;
static lv_timer_t *g_smTimer = nullptr;
static int W = 320, H = 480, GY = 420;
static float FH = 70;
static bool g_small2 = false;
static Fighter FA, FB;
static float T_now = 0, nextSword = 6, heldAt = 0, nextToast = 20, bladeT = 0;
static int handState = HC_CLOCK;
static float flyx0, flyy0, flyt, flyx, flyy, flya;
static int toastState = T_NONE;
static float toastT = 0, toastAge = 0, toastJig = 0, toastCt = 0;
static char toastText[40];
static int pkState = PK_NONE, pkIdx = 0;
static char pkCh = '0';
static float pkUntil = 0, pkRt = 0;
static Fighter *pkHolder = nullptr;
static float koT = 0;
static float ph = 0;
static Layout L;
static std::vector<Glyph> glyphs;
static std::vector<Spark> sparks;
static std::vector<Pop> pops;
static char lastAct[48];
static float hpA0 = 100, hpB0 = 100;
static uint32_t lastTick = 0;
static int ox0 = 0, oy0 = 0;
static lv_layer_t *dl = nullptr;

static void say(const char *who, const char *what)
{
    snprintf(lastAct, sizeof(lastAct), "%s: %s", who, what);
}
static void addSpark(float x, float y, uint32_t col)
{
    if (sparks.size() < 12)
        sparks.push_back({x, y, .28f, col});
}
static void addPop(float x, float y, const char *t)
{
    if (pops.size() >= 6)
        return;
    Pop p;
    p.x = x;
    p.y = y;
    p.t = .7f;
    snprintf(p.text, sizeof(p.text), "%s", t);
    pops.push_back(p);
}

static void reset_fight(void)
{
    init_tables();
    auto mkf = [](Fighter &f, float x, int face, uint32_t col, float size, float speed, float ds, float dm, char id) {
        memset(&f, 0, sizeof(f));
        f.x = x;
        f.y = GY;
        f.face = face;
        f.hp = 100;
        f.col = col;
        f.fh = FH * size;
        f.sp = speed * (float)W / 320.0f;
        f.ds = ds;
        f.dm = dm;
        f.pose = P({});
        f.cd = .5f;
        f.throwCd = 2;
        f.lastMove = -1;
        f.wide = size > 1;
        f.id = id;
        f.seq = nullptr;
    };
    if (FA.seq)
        delete FA.seq;
    if (FB.seq)
        delete FB.seq;
    mkf(FA, W * .22f, 1, 0xF2C14E, 1.18f, 70, 1.2f, 1.3f, 'Y');
    mkf(FB, W * .78f, -1, 0xE0534A, .86f, 150, .8f, .75f, 'R');
    FA.hp = hpA0;
    FB.hp = hpB0;
    glyphs.clear();
    koT = 0;
    handState = HC_CLOCK;
    pkState = PK_NONE;
    toastState = T_NONE;
    nextSword = T_now + 3;
}

static void layout_sync(void)
{
    lv_obj_update_layout(g_ov);
    lv_area_t ar, ac;
    lv_obj_get_coords(g_arena, &ar);
    ox0 = ar.x1;
    oy0 = ar.y1;
    L.an = !lv_obj_has_flag(g_analog, LV_OBJ_FLAG_HIDDEN);
    if (L.an) {
        lv_obj_get_coords(g_analog, &ac);
        L.cx = (ac.x1 + ac.x2) / 2.0f - ox0;
        L.cy = (ac.y1 + ac.y2) / 2.0f - oy0;
        L.r = (ac.x2 - ac.x1) / 2.0f;
    }
    time_t now = time(nullptr);
    bool timeSet = now > 1700000000;
    L.dg = !lv_obj_has_flag(g_clock, LV_OBJ_FLAG_HIDDEN) && timeSet;
    if (L.dg) {
        struct tm t;
        localtime_r(&now, &t);
        snprintf(L.str, sizeof(L.str), "%02d:%02d", t.tm_hour, t.tm_min);
        lv_obj_get_coords(g_clock, &ac);
        const lv_font_t *f = lv_obj_get_style_text_font(g_clock, 0);
        float x0 = ac.x1 + 10 - ox0;
        float cxs[5];
        for (int i = 0; i < 5; i++) {
            float cw = (float)lv_font_get_glyph_width(f, (uint32_t)L.str[i], i < 4 ? (uint32_t)L.str[i + 1] : 0);
            cxs[i] = x0 + cw / 2;
            x0 += cw;
        }
        L.dig[0] = cxs[0];
        L.dig[1] = cxs[1];
        L.dig[2] = cxs[3];
        L.dig[3] = cxs[4];
        L.dgY = (ac.y1 + ac.y2) / 2.0f - oy0;
        L.dgSize = (float)lv_font_get_line_height(f);
        L.dgW = (float)(ac.x2 - ac.x1);
    }
    L.toastW = W - 30 < 210 ? W - 30 : 210;
    L.toastH = g_small2 ? 24 : 28;
    L.toastY = 22;
}

// ---------- sequences ----------
static void seq_start(Fighter &f, Seq *s, const char *label)
{
    if (f.seq)
        delete f.seq;
    f.seq = s;
    f.vx = f.vy = 0;
    f.moving = false;
    say(f.id == 'Y' ? "yellow" : "red", label);
}
static Step sRun(float x, float speed)
{
    Step s;
    s.type = SQ_RUN;
    s.x = x;
    s.speed = speed;
    return s;
}
static Step sJump(float x, float y, float dur, float arc, int face, const PoseS &pose)
{
    Step s;
    s.type = SQ_JUMP;
    s.x = x;
    s.y = y;
    s.dur = dur;
    s.arc = arc;
    s.face = face;
    s.pose = pose;
    return s;
}
static Step sHold(float dur, const PoseS &pose, std::function<void(float)> on = nullptr)
{
    Step s;
    s.type = SQ_HOLD;
    s.dur = dur;
    s.pose = pose;
    s.on = on;
    return s;
}
static Step sPull(float dur, float dy, const PoseS &a, const PoseS &b, std::function<void(float)> on)
{
    Step s;
    s.type = SQ_PULL;
    s.dur = dur;
    s.dy = dy;
    s.pose = a;
    s.pose2 = b;
    s.on = on;
    return s;
}
static Step sFall(void)
{
    Step s;
    s.type = SQ_FALL;
    return s;
}
static Step sAnim(float dur, std::vector<Key> keys, std::function<void(float)> on = nullptr)
{
    Step s;
    s.type = SQ_ANIM;
    s.dur = dur;
    s.keys = keys;
    s.on = on;
    return s;
}
static Step sDo(std::function<void()> fn)
{
    Step s;
    s.type = SQ_DO;
    s.fn = fn;
    return s;
}

static void step_seq(Fighter &f, float dt)
{
    Seq *s = f.seq;
    if (!s)
        return;
    if (s->i >= s->steps.size()) {
        delete f.seq;
        f.seq = nullptr;
        return;
    }
    Step &st = s->steps[s->i];
    if (!s->init) {
        s->init = true;
        s->t = 0;
        st.x0 = f.x;
        st.y0 = f.y;
        st.p0 = f.pose;
    }
    s->t += dt;
    float u = st.dur > 0 ? (s->t / st.dur > 1 ? 1 : s->t / st.dur) : 1;
    bool done = false;
    switch (st.type) {
    case SQ_RUN: {
        float dx = st.x - f.x;
        f.face = dx >= 0 ? 1 : -1;
        float mv = fabsf(dx) < st.speed * dt ? fabsf(dx) : st.speed * dt;
        f.x += f.face * mv;
        f.pose = lerpP(f.pose, runPose(ph * 1.1f), dt * 16 > 1 ? 1 : dt * 16);
        if (fabsf(st.x - f.x) < 1.5f)
            done = true;
        break;
    }
    case SQ_JUMP:
        f.face = st.face;
        f.x = st.x0 + (st.x - st.x0) * smooth(u);
        f.y = st.y0 + (st.y - st.y0) * u - 4 * st.arc * u * (1 - u);
        f.pose = lerpP(JUMPPOSE, st.pose, smooth((u - .5f) * 2));
        if (u >= 1)
            done = true;
        break;
    case SQ_HOLD:
        f.pose = lerpP(st.p0, st.pose, s->t / .12f > 1 ? 1 : s->t / .12f);
        if (st.on)
            st.on(u);
        if (u >= 1)
            done = true;
        break;
    case SQ_PULL:
        f.y = st.y0 + st.dy * smooth(u);
        f.pose = lerpP(st.pose, st.pose2, smooth(u));
        if (st.on)
            st.on(u);
        if (u >= 1)
            done = true;
        break;
    case SQ_FALL:
        f.vy += 1500 * dt;
        f.y += f.vy * dt;
        f.pose = lerpP(f.pose, JUMPPOSE, dt * 10 > 1 ? 1 : dt * 10);
        if (f.y >= GY) {
            f.y = GY;
            f.vy = 0;
            done = true;
        }
        break;
    case SQ_ANIM:
        f.pose = lerpP(st.p0, sample(st.keys, u), s->t / .08f > 1 ? 1 : s->t / .08f);
        if (st.on)
            st.on(u);
        if (u >= 1)
            done = true;
        break;
    case SQ_DO:
        if (st.fn)
            st.fn();
        done = true;
        break;
    }
    float hx, hy;
    handFeet(f.pose, f.fh, &hx, &hy);
    f.hwx = f.x + f.face * hx;
    f.hwy = f.y + hy;
    if (done) {
        s->i++;
        s->init = false;
        if (s->i >= s->steps.size()) {
            delete f.seq;
            f.seq = nullptr;
        }
    }
}

static void hang_plan(Fighter &f, float gx, float gy, int *face, float *fx, float *fy)
{
    int fc = gx >= f.x ? 1 : -1;
    float hx, hy;
    handFeet(HANG, f.fh, &hx, &hy);
    *face = fc;
    *fx = gx - fc * hx;
    *fy = gy - hy;
}
static float minute_angle(void)
{
    time_t n = time(nullptr);
    struct tm t;
    localtime_r(&n, &t);
    return ((float)t.tm_min + (float)t.tm_sec / 60.0f) * 3.14159265f / 30.0f;
}

static PoseS landPose(void)
{
    return P({{OY, .8f}, {LEAN, .2f}, AF(1.0f, 1.4f), AB(.3f, .6f), LF(.9f, .3f), LB(-.9f, -.6f)});
}

static void start_grab_sword(void)
{
    Fighter &f = FA;
    float a = minute_angle(), gx = L.cx + sinf(a) * L.r * .55f, gy = L.cy - cosf(a) * L.r * .55f;
    int face;
    float fx, fy;
    hang_plan(f, gx, gy, &face, &fx, &fy);
    float k = (float)W / 320.0f;
    Seq *s = new Seq;
    s->steps.push_back(sRun(fx, f.sp * 2));
    s->steps.push_back(sJump(fx, fy, .85f, 90 * k, face, HANG));
    s->steps.push_back(sDo([=]() {
        handState = HC_GRIPPED;
        addSpark(gx, gy, 0xFFE27A);
        addPop(gx, gy - 18, "GRAB");
    }));
    s->steps.push_back(sHold(.4f, HANG));
    s->steps.push_back(sPull(.8f, f.fh * .55f, HANG, PULL, [](float) { handState = HC_PULLED; }));
    s->steps.push_back(sDo([=]() {
        handState = HC_HELD;
        heldAt = T_now;
        bladeT = 0;
        addSpark(L.cx, L.cy, 0xFFE27A);
        addSpark(FA.hwx, FA.hwy, 0xFFFFFF);
        addPop(L.cx, L.cy - L.r - 6, "SNAP");
    }));
    s->steps.push_back(sFall());
    s->steps.push_back(sAnim(.35f, {{0, landPose()}, {1, P({})}}));
    seq_start(f, s, "climbs the clock and grabs the minute hand");
}
static void start_toss(void)
{
    Fighter &f = FA;
    Seq *s = new Seq;
    s->steps.push_back(sAnim(.35f, {{0, P({})}, {1, P({{LEAN, -.35f}, AF(-.8f, .0f), AB(-.5f, .4f)})}}));
    s->steps.push_back(sDo([]() {
        handState = HC_FLYING;
        flyx0 = FA.hwx;
        flyy0 = FA.hwy;
        flyt = 0;
        nextSword = T_now + 6;
    }));
    s->steps.push_back(sAnim(.3f, {{0, P({{LEAN, -.35f}, AF(-.8f, .0f)})}, {1, P({{LEAN, .35f}, {OX, .3f}, AF(2.9f, 3.0f), AB(2.4f, 2.6f)})}}));
    s->steps.push_back(sAnim(.25f, {{0, P({{LEAN, .35f}, AF(2.9f, 3.0f)})}, {1, P({})}}));
    seq_start(f, s, "throws the minute hand back");
}
static void start_grab_toast(void)
{
    Fighter &f = FB;
    float gx = W / 2.0f, gy = L.toastY + L.toastH;
    int face;
    float fx, fy;
    hang_plan(f, gx, gy, &face, &fx, &fy);
    float k = (float)W / 320.0f;
    if (toastT < 7)
        toastT = 7;
    Seq *s = new Seq;
    s->steps.push_back(sRun(fx, f.sp * 1.8f));
    s->steps.push_back(sJump(fx, fy, .75f, 70 * k, face, HANG));
    s->steps.push_back(sDo([=]() {
        toastState = T_GRIPPED;
        addSpark(gx, gy, 0x9FD3FF);
        addPop(gx, gy + 18, "GRAB");
    }));
    s->steps.push_back(sHold(.35f, HANG, [](float u) { toastJig = sinf(u * 40) * .05f; }));
    s->steps.push_back(sPull(.5f, f.fh * .45f, HANG, PULL, [](float u) {
        toastState = T_PULLED;
        toastJig = sinf(u * 30) * .1f;
    }));
    s->steps.push_back(sDo([=]() {
        toastState = T_CARRIED;
        toastJig = 0;
        for (int i = 0; i < 4; i++)
            addSpark(gx + (i - 1.5f) * 14, L.toastY + 4, 0x9FD3FF);
        addPop(gx, L.toastY + L.toastH + 8, "RIP");
    }));
    s->steps.push_back(sFall());
    s->steps.push_back(sAnim(.3f, {{0, landPose()}, {1, P({{LEAN, .1f}, AF(1.1f, 2.2f), AB(.9f, 2.2f)})}}, [](float u) {
        if (u >= .5f)
            toastState = T_HELD;
    }));
    seq_start(f, s, "tears the notification off the screen");
}
static void start_pluck(Fighter &f)
{
    int idx = (int)random(4);
    float gx = L.dig[idx], gy = L.dgY + L.dgSize * .5f;
    int face;
    float fx, fy;
    hang_plan(f, gx, gy, &face, &fx, &fy);
    float k = (float)W / 320.0f;
    Fighter *e = (&f == &FA) ? &FB : &FA;
    pkState = PK_ATTACHED;
    pkIdx = idx;
    pkCh = L.str[idx < 2 ? idx : idx + 1];
    pkHolder = &f;
    f.throwCd = 3 + rnd() * 2;
    Fighter *fp = &f;
    Seq *s = new Seq;
    s->steps.push_back(sRun(fx, f.sp * 1.8f));
    s->steps.push_back(sJump(fx, fy, .75f, 70 * k, face, HANG));
    s->steps.push_back(sDo([=]() {
        pkState = PK_GRIPPED;
        addSpark(gx, gy, 0xFFE27A);
        addPop(gx, gy + 16, "GRAB");
    }));
    s->steps.push_back(sHold(.3f, HANG));
    s->steps.push_back(sPull(.4f, f.fh * .35f, HANG, PULL, [](float) { pkState = PK_PULLED; }));
    s->steps.push_back(sDo([=]() {
        pkState = PK_CARRIED;
        addPop(gx, gy - 10, "POP");
        addSpark(gx, L.dgY, 0xFFFFFF);
    }));
    s->steps.push_back(sFall());
    s->steps.push_back(sAnim(.45f, {{0, P({{OY, .7f}, {LEAN, .2f}, AF(1.0f, 2.0f), AB(.8f, 2.0f)})}, {.5f, CARRY}, {1, P({{LEAN, -.45f}, AF(3.3f, 3.6f), AB(2.9f, 3.2f)})}}));
    s->steps.push_back(sDo([=]() {
        fp->face = e->x >= fp->x ? 1 : -1;
        Glyph g;
        g.x = fp->hwx;
        g.y = fp->hwy - 4;
        g.vx = fp->face * 270 * k;
        g.vy = -110;
        g.spin = 0;
        g.ch = pkCh;
        g.owner = fp;
        g.dead = false;
        glyphs.push_back(g);
        pkState = PK_THROWN;
        pkUntil = T_now + 2.4f;
        addPop(fp->hwx, fp->hwy - 20, "THROW");
    }));
    s->steps.push_back(sAnim(.3f, {{0, P({{LEAN, -.45f}, AF(3.3f, 3.6f)})}, {1, P({{LEAN, .4f}, {OX, .3f}, AF(1.3f, 1.4f), AB(.4f, .8f)})}}));
    s->steps.push_back(sAnim(.25f, {{0, P({{LEAN, .4f}, AF(1.3f, 1.4f)})}, {1, P({})}}));
    seq_start(f, s, "plucks a digit out of the clock");
}

static void start_move(Fighter &f, int id)
{
    const Move &m = g_mv[id];
    f.moving = true;
    f.mv = id;
    f.mt = 0;
    f.mhit = false;
    f.mfrom = f.pose;
    f.mdur = m.d * f.ds;
    f.lastMove = id;
    float k = (float)W / 320.0f;
    if (m.lunge != 0)
        f.vx = f.face * m.lunge * k * (f.sp > 100 ? 1 : .9f);
    if (m.jump != 0)
        f.vy = m.jump;
    if (id != FLINCH)
        say(f.id == 'Y' ? "yellow" : "red", m.name);
}
static int pick(const int *l, int n, int avoid)
{
    int c[8], m = 0;
    for (int i = 0; i < n; i++)
        if (l[i] != avoid)
            c[m++] = l[i];
    return c[random(m)];
}

static void sm_step(float dt)
{
    T_now += dt;
    ph += dt * 11;
    Fighter &A = FA, &B = FB;
    layout_sync();
    bool canProps = koT <= 0;
    // toast life: a real message, or a quiet reminder now and then
    if (toastState == T_CRUMPLE) {
        toastCt += dt;
        if (toastCt > .4f)
            toastState = T_NONE;
    } else if (toastState != T_NONE) {
        toastAge += dt;
        toastT -= dt;
        if (toastT <= 0) {
            if (toastState == T_HELD || toastState == T_CARRIED) {
                toastState = T_CRUMPLE;
                toastCt = 0;
                addSpark(B.x, B.y - B.fh * .6f, 0x9FD3FF);
            } else if (toastState == T_IN)
                toastState = T_NONE;
        }
    } else {
        nextToast -= dt;
        if (nextToast <= 0) {
            snprintf(toastText, sizeof(toastText), "%s", g_lastText[0] ? g_lastText : "Mesh online");
            toastState = T_IN;
            toastT = 4.2f;
            toastAge = 0;
            toastJig = 0;
            nextToast = 30;
        }
    }
    A.sword = handState == HC_HELD;
    B.sword = false;
    if (canProps && L.an && !A.seq && !A.moving && !A.ko) {
        if (handState == HC_CLOCK && T_now > nextSword)
            start_grab_sword();
        else if (handState == HC_HELD && T_now - heldAt > 7)
            start_toss();
    }
    if (handState == HC_FLYING) {
        flyt += dt;
        float fu = flyt / .75f > 1 ? 1 : flyt / .75f;
        float k = (float)W / 320.0f;
        flyx = flyx0 + (L.cx - flyx0) * smooth(fu);
        flyy = flyy0 + (L.cy - flyy0) * smooth(fu) - 90 * k * 4 * fu * (1 - fu);
        flya = flyt * 14;
        if (fu >= 1) {
            handState = HC_CLOCK;
            addSpark(L.cx, L.cy, 0xFFFFFF);
            addPop(L.cx, L.cy - L.r - 6, "CLICK");
        }
    }
    if (handState == HC_HELD)
        bladeT += dt;
    if (canProps && toastState == T_IN && toastAge > 1.0f && !B.seq && !B.moving && !B.ko)
        start_grab_toast();
    if (pkState == PK_THROWN && T_now > pkUntil) {
        pkState = PK_RESPAWN;
        pkRt = 0;
    }
    if (pkState == PK_RESPAWN) {
        pkRt += dt;
        if (pkRt > .4f)
            pkState = PK_NONE;
    }
    if (canProps && L.dg && pkState == PK_NONE) {
        Fighter *fs[2] = {&B, &A};
        for (int i = 0; i < 2; i++) {
            Fighter &f = *fs[i];
            if (pkState == PK_NONE && f.throwCd <= 0 && !f.seq && !f.moving && !f.ko && T_now > 5)
                start_pluck(f);
        }
    }
    float k = (float)W / 320.0f;
    Fighter *both[2] = {&A, &B};
    for (int i = 0; i < 2; i++) {
        Fighter &f = *both[i];
        f.cd -= dt;
        f.throwCd -= dt;
        if (f.seq)
            continue;
        f.vy += 1500 * dt;
        f.x += f.vx * dt;
        f.y += f.vy * dt;
        if (f.y >= GY) {
            f.y = GY;
            f.vy = 0;
        }
        f.air = f.y < GY - 2;
        f.vx *= powf(f.moving ? 0.12f : 0.002f, dt);
        if (f.x < 24) {
            f.x = 24;
            f.vx = fabsf(f.vx) * .5f;
        }
        if (f.x > W - 24) {
            f.x = W - 24;
            f.vx = -fabsf(f.vx) * .5f;
        }
    }
    auto moveTo = [&](Fighter &f, Fighter &e, float speed) {
        f.face = e.x >= f.x ? 1 : -1;
        float a = dt * 8 > 1 ? 1 : dt * 8;
        f.vx += (f.face * speed - f.vx) * a;
    };
    auto ai = [&](Fighter &f, Fighter &e) {
        if (f.ko || f.moving || f.seq || koT > 0)
            return;
        float d = fabsf(e.x - f.x) / f.fh;
        bool fl = f.sword;
        if (e.seq && d < 1.2f) {
            f.vx *= .9f;
            return;
        }
        if (d > (fl ? 3.4f : 3.0f)) {
            moveTo(f, e, f.sp);
        } else if (f.cd <= 0) {
            f.face = e.x >= f.x ? 1 : -1;
            int id;
            if (&f == &B && rnd() < .14f && d < 1.5f)
                id = FLIP;
            else if (d < 1.05f)
                id = fl ? pick(SCLOSE_L, 3, f.lastMove) : pick(CLOSE_L, 7, f.lastMove);
            else if (d < 1.9f)
                id = fl ? pick(SMID_L, 4, f.lastMove) : pick(MID_L, 6, f.lastMove);
            else
                id = fl ? pick(SFAR_L, 2, f.lastMove) : pick(FAR_L, 2, f.lastMove);
            start_move(f, id);
            f.cd = (&f == &A ? .7f : .35f) + rnd() * .5f;
        } else {
            if (d > 1.1f)
                moveTo(f, e, f.sp * .5f);
            else
                f.vx *= .9f;
        }
    };
    if (koT > 0) {
        koT -= dt;
        if (koT <= 0)
            reset_fight();
    } else {
        ai(A, B);
        ai(B, A);
    }
    for (int pi = 0; pi < 2; pi++) {
        Fighter &f = pi == 0 ? A : B;
        Fighter &e = pi == 0 ? B : A;
        if (!f.moving)
            continue;
        const Move &m = g_mv[f.mv];
        f.mt += dt;
        float u = f.mt / f.mdur > 1 ? 1 : f.mt / f.mdur;
        f.pose = lerpP(f.mfrom, sample(m.keys, u), f.mt / .08f > 1 ? 1 : f.mt / .08f);
        if (!f.mhit && u >= m.hit && m.reach > 0) {
            f.mhit = true;
            float reach = m.reach * f.fh, dx = (e.x - f.x) * f.face;
            if (dx > -f.fh * .2f && dx < reach && (!m.low || !e.air) && fabsf(e.y - f.y) < FH * 1.5f && !e.ko && !e.seq) {
                bool blocked = toastState == T_HELD && &e == &B && !m.low && ((f.x - e.x) > 0 ? 1 : -1) == e.face;
                float hx = (f.x + e.x) / 2, hy = e.y - e.fh * .55f;
                if (blocked) {
                    addSpark(e.x + e.face * e.fh * .45f, hy, 0x9FD3FF);
                    f.vx = -f.face * 220 * k;
                } else {
                    e.hp -= m.dmg * f.dm;
                    e.vx = f.face * m.kb * k * (&f == &A ? 1.15f : .9f);
                    if (m.launch != 0)
                        e.vy = m.launch;
                    if (e.hp <= 0) {
                        e.hp = 0;
                        e.ko = true;
                        e.moving = false;
                        koT = 1.9f;
                        if (e.vy > -380)
                            e.vy = -380;
                    } else
                        start_move(e, FLINCH);
                    addSpark(hx, hy, 0xFFFFFF);
                }
            }
        }
        if (u >= 1)
            f.moving = false;
    }
    if (A.seq)
        step_seq(A, dt);
    if (B.seq)
        step_seq(B, dt);
    for (int i = 0; i < 2; i++) {
        Fighter &f = *both[i];
        if (f.moving || f.seq) {
            float hx, hy;
            handFeet(f.pose, f.fh, &hx, &hy);
            f.hwx = f.x + f.face * hx;
            f.hwy = f.y + hy;
            continue;
        }
        PoseS target;
        if (f.ko)
            target = KOPOSE;
        else if (f.air)
            target = JUMPPOSE;
        else if (fabsf(f.vx) > 45 * k)
            target = runPose(ph * (&f == &A ? .9f : 1.25f));
        else
            target = idlePose(T_now + (&f == &A ? 0 : 1));
        f.pose = lerpP(f.pose, target, dt * (f.ko ? 10 : 16) > 1 ? 1 : dt * (f.ko ? 10 : 16));
        float hx, hy;
        handFeet(f.pose, f.fh, &hx, &hy);
        f.hwx = f.x + f.face * hx;
        f.hwy = f.y + hy;
    }
    for (size_t i = 0; i < glyphs.size(); i++) {
        Glyph &g = glyphs[i];
        g.x += g.vx * dt;
        g.y += g.vy * dt;
        g.vy += 130 * dt;
        g.spin += dt * 10;
        Fighter &e = g.owner == &A ? B : A;
        if (!g.dead && !e.ko && !e.seq && fabsf(g.x - e.x) < e.fh * .4f && fabsf(g.y - (e.y - e.fh * .5f)) < e.fh * .6f) {
            g.dead = true;
            if (toastState == T_HELD && &e == &B)
                addSpark(g.x, g.y, 0x9FD3FF);
            else {
                e.hp -= 6;
                if (e.hp <= 0) {
                    e.hp = 0;
                    e.ko = true;
                    e.moving = false;
                    koT = 1.9f;
                } else if (!e.moving)
                    start_move(e, FLINCH);
                addSpark(g.x, g.y, 0xFFFFFF);
            }
        }
        if (g.x < -20 || g.x > W + 20 || g.y > GY + 10)
            g.dead = true;
    }
    for (size_t i = glyphs.size(); i-- > 0;)
        if (glyphs[i].dead)
            glyphs.erase(glyphs.begin() + i);
    for (size_t i = sparks.size(); i-- > 0;) {
        sparks[i].t -= dt;
        if (sparks[i].t <= 0)
            sparks.erase(sparks.begin() + i);
    }
    for (size_t i = pops.size(); i-- > 0;) {
        pops[i].t -= dt;
        pops[i].y -= dt * 30;
        if (pops[i].t <= 0)
            pops.erase(pops.begin() + i);
    }
    // the real minute hand and the clock digits follow the props
    if (L.an)
        lv_obj_set_flag(g_hand[1], LV_OBJ_FLAG_HIDDEN, handState != HC_CLOCK && handState != HC_GRIPPED);
    if (L.dg) {
        if (pkState >= PK_GRIPPED && pkState <= PK_THROWN) {
            char buf[40];
            int o2 = 0;
            lv_label_set_recolor(g_clock, true);
            for (int i = 0; i < 5; i++) {
                int idx = i < 2 ? i : i - 1;
                if (i != 2 && idx == pkIdx)
                    o2 += snprintf(buf + o2, sizeof(buf) - o2, "#000000 %c#", L.str[i]);
                else
                    buf[o2++] = L.str[i];
            }
            buf[o2] = 0;
            lv_label_set_text(g_clock, buf);
        } else if (lv_label_get_recolor(g_clock)) {
            lv_label_set_recolor(g_clock, false);
            lv_label_set_text(g_clock, L.str);
        }
    }
}

// ---------- drawing ----------
static void dline(float x1, float y1, float x2, float y2, float w, uint32_t col, lv_opa_t opa = LV_OPA_COVER)
{
    lv_draw_line_dsc_t d;
    lv_draw_line_dsc_init(&d);
    d.p1.x = x1 + ox0;
    d.p1.y = y1 + oy0;
    d.p2.x = x2 + ox0;
    d.p2.y = y2 + oy0;
    d.width = (int32_t)(w + .5f) < 1 ? 1 : (int32_t)(w + .5f);
    d.color = lv_color_hex(col);
    d.opa = opa;
    d.round_start = 1;
    d.round_end = 1;
    lv_draw_line(dl, &d);
}
static void dring(float cx, float cy, float r, float w, uint32_t col)
{
    lv_draw_arc_dsc_t a;
    lv_draw_arc_dsc_init(&a);
    a.color = lv_color_hex(col);
    a.width = (int32_t)(w + .5f) < 1 ? 1 : (int32_t)(w + .5f);
    a.center.x = (int32_t)(cx + ox0);
    a.center.y = (int32_t)(cy + oy0);
    a.radius = (uint16_t)(r < 1 ? 1 : r);
    a.start_angle = 0;
    a.end_angle = 360;
    lv_draw_arc(dl, &a);
}
static void drect(float x, float y, float w, float h, int radius, uint32_t col, lv_opa_t opa)
{
    lv_draw_rect_dsc_t d;
    lv_draw_rect_dsc_init(&d);
    d.bg_color = lv_color_hex(col);
    d.bg_opa = opa;
    d.radius = radius;
    lv_area_t a;
    a.x1 = (int32_t)(x + ox0);
    a.y1 = (int32_t)(y + oy0);
    a.x2 = (int32_t)(x + w + ox0);
    a.y2 = (int32_t)(y + h + oy0);
    lv_draw_rect(dl, &d, &a);
}
static void dtext(const char *s, const lv_font_t *f, float cx, float cy, uint32_t col, lv_opa_t opa = LV_OPA_COVER)
{
    lv_draw_label_dsc_t l;
    lv_draw_label_dsc_init(&l);
    l.font = f;
    l.color = lv_color_hex(col);
    l.opa = opa;
    l.text = s;
    l.text_local = 1;
    l.align = LV_TEXT_ALIGN_CENTER;
    int lh = lv_font_get_line_height(f);
    lv_area_t a;
    a.x1 = (int32_t)(cx - 140 + ox0);
    a.x2 = (int32_t)(cx + 140 + ox0);
    a.y1 = (int32_t)(cy - lh / 2 + oy0);
    a.y2 = (int32_t)(cy + lh / 2 + oy0);
    lv_draw_label(dl, &l, &a);
}

static void draw_stick(const Fighter &f, float blade, bool hasBlade, float bladeLen)
{
    const PoseS &p = f.pose;
    float u = f.fh / 10, hipx = p.v[OX] * u, hipy = -4.2f * u + p.v[OY] * u;
    float cr = cosf(p.v[ROT]), sr = sinf(p.v[ROT]);
    auto W2 = [&](float x, float y, float *wx, float *wy) {
        *wx = f.x + f.face * (hipx + x * cr - y * sr);
        *wy = f.y + hipy + x * sr + y * cr;
    };
    float lw = (u * (f.wide ? 0.8f : 0.5f)) < 2 ? 2 : u * (f.wide ? 0.8f : 0.5f);
    float hx0, hy0;
    W2(0, 0, &hx0, &hy0);
    float sx = sinf(p.v[LEAN]) * 3.4f * u, sy = -cosf(p.v[LEAN]) * 3.4f * u, shx, shy;
    W2(sx, sy, &shx, &shy);
    dline(hx0, hy0, shx, shy, lw, f.col);
    float hcx, hcy;
    W2(sx + sinf(p.v[LEAN]) * 1.6f * u, sy - cosf(p.v[LEAN]) * 1.6f * u, &hcx, &hcy);
    dring(hcx, hcy, 1.2f * u, lw, f.col);
    auto limb = [&](float x0, float y0, float a1, float l1, float a2, float l2, float *ex, float *ey) {
        float x1 = x0 + sinf(a1) * l1, y1 = y0 + cosf(a1) * l1, x2 = x1 + sinf(a2) * l2, y2 = y1 + cosf(a2) * l2;
        float ax, ay, bx, by, cx, cy;
        W2(x0, y0, &ax, &ay);
        W2(x1, y1, &bx, &by);
        W2(x2, y2, &cx, &cy);
        dline(ax, ay, bx, by, lw, f.col);
        dline(bx, by, cx, cy, lw, f.col);
        *ex = cx;
        *ey = cy;
    };
    float ex, ey;
    limb(0, 0, p.v[LB0], 2.2f * u, p.v[LB1], 2.1f * u, &ex, &ey);
    limb(0, 0, p.v[LF0], 2.2f * u, p.v[LF1], 2.1f * u, &ex, &ey);
    limb(sx, sy, p.v[AB0], 1.5f * u, p.v[AB1], 1.4f * u, &ex, &ey);
    limb(sx, sy, p.v[AF0], 1.5f * u, p.v[AF1], 1.4f * u, &ex, &ey);
    if (hasBlade) {
        // blade direction in the figure's own frame, mirrored with the face, rotated with the body
        float bx = sinf(blade), by = -cosf(blade);
        float rx = bx * cr - by * sr, ry = bx * sr + by * cr;
        dline(ex, ey, ex + f.face * rx * bladeLen, ey + ry * bladeLen, lw * .8f, 0xFFFFFF);
    }
}

static void draw_all(lv_layer_t *layer)
{
    dl = layer;
    Fighter &A = FA, &B = FB;
    float k = (float)W / 320.0f;
    // health bars: yellow is the battery fighter, red the nodes fighter
    drect(6, 4, W * .38f, 7, 3, 0xFFFFFF, 50);
    drect(6, 4, W * .38f * A.hp / 100.0f, 7, 3, 0xF2C14E, LV_OPA_COVER);
    drect(W - 6 - W * .38f, 4, W * .38f, 7, 3, 0xFFFFFF, 50);
    drect(W - 6 - W * .38f * B.hp / 100.0f, 4, W * .38f * B.hp / 100.0f, 7, 3, 0xE0534A, LV_OPA_COVER);
    dline(8, GY + 2, W - 8, GY + 2, 2, 0x7896D2, 150);
    // toast
    float tw = L.toastW, th = L.toastH;
    const lv_font_t *f14 = &ui_font_montserrat_14;
    auto card = [&](float cx, float cy, float ww, float hh, bool txt) {
        drect(cx - ww / 2, cy - hh / 2, ww, hh, 8, 0x3C6EC8, 235);
        if (txt)
            dtext(toastText, f14, cx, cy, 0xFFFFFF);
    };
    if (toastState == T_IN) {
        float slide = toastAge * 3 < 1 ? toastAge * 3 : 1;
        float sl2 = toastT * 3 < slide ? toastT * 3 : slide;
        card(W / 2.0f, (L.toastY - 30) + sl2 * 34 + th / 2, tw, th, true);
    } else if (toastState == T_GRIPPED) {
        card(W / 2.0f + toastJig * 100, L.toastY + th / 2, tw, th, true);
    } else if (toastState == T_PULLED) {
        card(B.hwx + toastJig * 80, B.hwy - th / 2 + 4, tw, th, true);
    } else if (toastState == T_CARRIED) {
        card(B.hwx, B.hwy - th / 2 - 2, tw * .8f, th, false);
    } else if (toastState == T_HELD) {
        float bx = B.x + B.face * B.fh * .5f, by = B.y - B.fh * .55f;
        drect(bx - B.fh * .25f, by - B.fh * .42f, B.fh * .5f, B.fh * .85f, 8, 0x3C6EC8, 235);
        dtext("msg", f14, bx, by, 0xFFFFFF);
    } else if (toastState == T_CRUMPLE) {
        float cu = toastCt / .4f > 1 ? 1 : toastCt / .4f, bx = B.x + B.face * B.fh * .5f, by = B.y - B.fh * .55f, s2 = 1 - cu;
        drect(bx - B.fh * .25f * s2, by - B.fh * .42f * s2, B.fh * .5f * s2, B.fh * .85f * s2, 6, 0x3C6EC8, 235);
    }
    // stretched or flying minute hand
    if (handState == HC_PULLED) {
        float dx = A.hwx - L.cx, dy = A.hwy - L.cy, d = sqrtf(dx * dx + dy * dy);
        if (d < 1)
            d = 1;
        float len = d < L.r * 1.25f ? d : L.r * 1.25f;
        dline(L.cx, L.cy, L.cx + dx / d * len, L.cy + dy / d * len, 4, 0xFFFFFF);
    } else if (handState == HC_FLYING) {
        float hl = L.r * .39f;
        dline(flyx - cosf(flya) * hl, flyy - sinf(flya) * hl, flyx + cosf(flya) * hl, flyy + sinf(flya) * hl, 4, 0xFFFFFF);
    }
    // fighters
    for (int i = 0; i < 2; i++) {
        Fighter &f = i == 0 ? A : B;
        bool bl = false;
        float ba = .5f;
        if (&f == &A && f.sword) {
            bl = true;
            if (f.moving && g_mv[f.mv].hasBlade) {
                float u = f.mt / f.mdur > 1 ? 1 : f.mt / f.mdur, hs = (u - .25f) / .4f;
                hs = hs < 0 ? 0 : (hs > 1 ? 1 : hs);
                ba = g_mv[f.mv].b0 + (g_mv[f.mv].b1 - g_mv[f.mv].b0) * hs;
            } else if (bladeT < .7f)
                ba = .5f + (-2.6f * (1 - smooth(bladeT / .7f)));
        }
        draw_stick(f, ba, bl, (L.an ? L.r : 60 * k) * .78f);
    }
    // plucked digit
    if (pkState == PK_GRIPPED || pkState == PK_PULLED || pkState == PK_CARRIED) {
        char s[2] = {pkCh, 0};
        const lv_font_t *fnt = lv_obj_get_style_text_font(g_clock, 0);
        float gx = pkState == PK_GRIPPED ? L.dig[pkIdx] : pkHolder->hwx, gy = pkState == PK_GRIPPED ? L.dgY : pkHolder->hwy - L.dgSize * .45f;
        dtext(s, fnt, gx, gy, 0xFFFFFF);
    }
    for (auto &g : glyphs) {
        char s[2] = {g.ch, 0};
        dtext(s, &ui_font_montserrat_20, g.x, g.y, 0xFFFFFF);
    }
    for (auto &s : sparks) {
        float r = 6 + (.28f - s.t) * 70;
        for (int i = 0; i < 7; i++) {
            float a = (float)i * .9f;
            dline(s.x + cosf(a) * r * .5f, s.y + sinf(a) * r * .5f, s.x + cosf(a) * r, s.y + sinf(a) * r, 2, s.col);
        }
    }
    for (auto &p : pops)
        dtext(p.text, f14, p.x, p.y, 0xFFE27A, p.t * 2.5f > 1 ? LV_OPA_COVER : (lv_opa_t)(p.t * 2.5f * 255));
    if (koT > 0)
        dtext("K.O.", &ui_font_montserrat_20, W / 2.0f, H * .5f, 0xFFFFFF);
}

static void arena_draw_cb(lv_event_t *e)
{
    lv_layer_t *layer = lv_event_get_layer(e);
    if (!layer)
        return;
    draw_all(layer);
}

// tight bounding box of a stick figure (all joints, head and the sword when held)
static void stick_bbox(const Fighter &f, float *bx1, float *by1, float *bx2, float *by2)
{
    const PoseS &p = f.pose;
    float u = f.fh / 10, hipx = p.v[OX] * u, hipy = -4.2f * u + p.v[OY] * u;
    float cr = cosf(p.v[ROT]), sr = sinf(p.v[ROT]);
    float x1 = 1e9f, y1 = 1e9f, x2 = -1e9f, y2 = -1e9f;
    auto add = [&](float lx, float ly) {
        float wx = f.x + f.face * (hipx + lx * cr - ly * sr), wy = f.y + hipy + lx * sr + ly * cr;
        if (wx < x1)
            x1 = wx;
        if (wx > x2)
            x2 = wx;
        if (wy < y1)
            y1 = wy;
        if (wy > y2)
            y2 = wy;
    };
    float sx = sinf(p.v[LEAN]) * 3.4f * u, sy = -cosf(p.v[LEAN]) * 3.4f * u;
    add(0, 0);
    add(sx, sy);
    float hx = sx + sinf(p.v[LEAN]) * 1.6f * u, hy = sy - cosf(p.v[LEAN]) * 1.6f * u;
    add(hx - 1.3f * u, hy - 1.3f * u);
    add(hx + 1.3f * u, hy + 1.3f * u);
    const int a1[4] = {LB0, LF0, AB0, AF0};
    const float l1[4] = {2.2f, 2.2f, 1.5f, 1.5f}, l2[4] = {2.1f, 2.1f, 1.4f, 1.4f};
    for (int i = 0; i < 4; i++) {
        float ox = i < 2 ? 0 : sx, oy = i < 2 ? 0 : sy;
        float kx = ox + sinf(p.v[a1[i]]) * l1[i] * u, ky = oy + cosf(p.v[a1[i]]) * l1[i] * u;
        add(kx, ky);
        add(kx + sinf(p.v[a1[i] + 1]) * l2[i] * u, ky + cosf(p.v[a1[i] + 1]) * l2[i] * u);
    }
    float m = u * .5f + 6;
    *bx1 = x1 - m;
    *by1 = y1 - m;
    *bx2 = x2 + m;
    *by2 = y2 + m;
}

// only the parts of the screen that changed are redrawn, a full-screen redraw is far too slow over SPI
static std::vector<lv_area_t> g_prevRects;
static float g_lastHpA = -1, g_lastHpB = -1;
static void addRect(std::vector<lv_area_t> &v, float x1, float y1, float x2, float y2)
{
    lv_area_t a;
    a.x1 = (int32_t)floorf(x1) - 4;
    a.y1 = (int32_t)floorf(y1) - 4;
    a.x2 = (int32_t)ceilf(x2) + 4;
    a.y2 = (int32_t)ceilf(y2) + 4;
    if (a.x1 < 0)
        a.x1 = 0;
    if (a.y1 < 0)
        a.y1 = 0;
    if (a.x2 >= W)
        a.x2 = W - 1;
    if (a.y2 >= H)
        a.y2 = H - 1;
    if (a.x2 >= a.x1 && a.y2 >= a.y1)
        v.push_back(a);
}
static void invalidate_dirty(bool all)
{
    std::vector<lv_area_t> cur;
    if (all) {
        addRect(cur, 0, 0, W, H);
    } else {
        for (int i = 0; i < 2; i++) {
            Fighter &f = i == 0 ? FA : FB;
            float bx1, by1, bx2, by2;
            stick_bbox(f, &bx1, &by1, &bx2, &by2);
            addRect(cur, bx1, by1, bx2, by2);
            if (f.sword && L.an) { // the blade reaches out from the hand
                float br = L.r * .85f;
                addRect(cur, f.hwx - br, f.hwy - br, f.hwx + br, f.hwy + br);
            }
            if (f.seq)
                addRect(cur, f.hwx - 24, f.hwy - 24, f.hwx + 24, f.hwy + 24);
        }
        for (auto &g : glyphs)
            addRect(cur, g.x - 22, g.y - 22, g.x + 22, g.y + 22);
        for (auto &s : sparks)
            addRect(cur, s.x - 30, s.y - 30, s.x + 30, s.y + 30);
        for (auto &p : pops)
            addRect(cur, p.x - 40, p.y - 14, p.x + 40, p.y + 14);
        if (toastState == T_IN || toastState == T_GRIPPED)
            addRect(cur, W / 2.0f - L.toastW / 2 - 12, 0, W / 2.0f + L.toastW / 2 + 12, L.toastY + L.toastH + 36);
        if (toastState == T_PULLED || toastState == T_CARRIED)
            addRect(cur, FB.hwx - L.toastW / 2 - 12, FB.hwy - L.toastH - 12, FB.hwx + L.toastW / 2 + 12, FB.hwy + 12);
        if (handState == HC_PULLED) {
            float x1 = L.cx < FA.hwx ? L.cx : FA.hwx, x2 = L.cx < FA.hwx ? FA.hwx : L.cx;
            float y1 = L.cy < FA.hwy ? L.cy : FA.hwy, y2 = L.cy < FA.hwy ? FA.hwy : L.cy;
            addRect(cur, x1 - 8, y1 - 8, x2 + 8, y2 + 8);
        }
        if (handState == HC_FLYING)
            addRect(cur, flyx - L.r * .5f, flyy - L.r * .5f, flyx + L.r * .5f, flyy + L.r * .5f);
        if (pkState >= PK_GRIPPED && pkState <= PK_CARRIED)
            addRect(cur, L.dig[pkIdx] - L.dgSize, L.dgY - L.dgSize, L.dig[pkIdx] + L.dgSize, L.dgY + L.dgSize);
        if (pkHolder && pkState >= PK_PULLED && pkState <= PK_CARRIED)
            addRect(cur, pkHolder->hwx - L.dgSize, pkHolder->hwy - L.dgSize * 1.2f, pkHolder->hwx + L.dgSize, pkHolder->hwy + L.dgSize * .5f);
        if (L.an && (handState == HC_GRIPPED || handState == HC_HELD))
            addRect(cur, L.cx - L.r - 4, L.cy - L.r - 4, L.cx + L.r + 4, L.cy + L.r + 4);
        if (FA.hp != g_lastHpA || FB.hp != g_lastHpB) {
            addRect(cur, 0, 0, W, 14);
            g_lastHpA = FA.hp;
            g_lastHpB = FB.hp;
        }
        if (koT > 0)
            addRect(cur, W / 2.0f - 60, H * .5f - 24, W / 2.0f + 60, H * .5f + 24);
    }
    for (auto &a : g_prevRects)
        lv_obj_invalidate_area(g_arena, &a);
    for (auto &a : cur)
        lv_obj_invalidate_area(g_arena, &a);
    g_prevRects = cur;
}

static void sm_tick(lv_timer_t *t)
{
    uint32_t now = lv_tick_get();
    float dt = (float)(now - lastTick) / 1000.0f;
    lastTick = now;
    if (dt > .12f)
        dt = .12f; // keep game time close to real time even when frames are slow
    if (!g_arena || lv_obj_has_flag(g_ov, LV_OBJ_FLAG_HIDDEN))
        return;
    sm_step(dt);
    static uint32_t n = 0;
    invalidate_dirty((n++ % 150) == 0); // a full refresh now and then cleans up anything missed
}

} // namespace sm

// ---- hooks used by the screensaver ----
static bool sm_wanted(void)
{
    return g_cfg[13] == 3 && g_bat > 100;
}
static void sm_create(void)
{
    sm::init_tables();
    sm::g_arena = lv_obj_create(g_ov);
    lv_obj_remove_style_all(sm::g_arena);
    lv_obj_add_flag(sm::g_arena, LV_OBJ_FLAG_IGNORE_LAYOUT);
    lv_obj_remove_flag(sm::g_arena, (lv_obj_flag_t)(LV_OBJ_FLAG_CLICKABLE | LV_OBJ_FLAG_SCROLLABLE));
    lv_obj_add_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_event_cb(sm::g_arena, sm::arena_draw_cb, LV_EVENT_DRAW_MAIN, nullptr);
}
// called from refresh(): show or hide the arena and give the rest of the page the layout it needs
static void sm_refresh(uint32_t nodesOn, uint32_t nodesAll)
{
    if (!sm::g_arena)
        return;
    bool on = sm_wanted();
    int hres = lv_display_get_horizontal_resolution(NULL), vres = lv_display_get_vertical_resolution(NULL);
    if (on && lv_obj_has_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN)) {
        sm::W = hres;
        sm::H = vres;
        sm::g_small2 = !(hres > vres) && vres < 330;
        sm::FH = (float)vres * 0.17f;
        float cap = sm::g_small2 ? 42.0f : 78.0f;
        if (sm::FH > cap)
            sm::FH = cap;
        sm::GY = vres - (sm::g_small2 ? 30 : 58);
        sm::hpA0 = g_bat > 100 ? 100.0f : (float)g_bat;
        sm::hpB0 = nodesAll ? 100.0f * (float)nodesOn / (float)nodesAll : 100.0f;
        if (sm::hpA0 < 30)
            sm::hpA0 = 30;
        if (sm::hpB0 < 30)
            sm::hpB0 = 30;
        lv_obj_set_size(sm::g_arena, hres, vres);
        lv_obj_set_pos(sm::g_arena, 0, 0);
        lv_obj_remove_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN);
        lv_obj_move_foreground(sm::g_arena);
        sm::reset_fight();
        sm::lastTick = lv_tick_get();
        if (!sm::g_smTimer)
            sm::g_smTimer = lv_timer_create(sm::sm_tick, 33, nullptr);
        else
            lv_timer_resume(sm::g_smTimer);
    } else if (!on && !lv_obj_has_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN)) {
        lv_obj_add_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN);
        if (sm::g_smTimer)
            lv_timer_pause(sm::g_smTimer);
        lv_obj_remove_flag(g_hand[1], LV_OBJ_FLAG_HIDDEN);
        lv_label_set_recolor(g_clock, false);
    }
    if (on) {
        lv_obj_set_flex_align(g_ov, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
        lv_obj_t *extra[] = {g_last, g_gps, g_chan, g_chanBar, g_link, g_foot, g_imgNote, g_tapNote, g_unread};
        for (lv_obj_t *o : extra)
            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
    } else {
        lv_obj_set_flex_align(g_ov, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    }
}
static void sm_hide(void)
{
    if (sm::g_arena && !lv_obj_has_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN)) {
        lv_obj_add_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN);
        if (sm::g_smTimer)
            lv_timer_pause(sm::g_smTimer);
        lv_obj_remove_flag(g_hand[1], LV_OBJ_FLAG_HIDDEN);
        lv_label_set_recolor(g_clock, false);
    }
}
static void sm_message(const char *from, const char *text)
{
    if (!sm::g_arena || lv_obj_has_flag(sm::g_arena, LV_OBJ_FLAG_HIDDEN) || sm::toastState != sm::T_NONE)
        return;
    snprintf(sm::toastText, sizeof(sm::toastText), "%.10s: %.22s", from ? from : "", text ? text : "");
    sm::toastState = sm::T_IN;
    sm::toastT = 4.2f;
    sm::toastAge = 0;
    sm::toastJig = 0;
}
