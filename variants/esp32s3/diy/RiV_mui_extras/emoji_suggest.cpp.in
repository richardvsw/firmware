// Emoji suggestions while typing: ":fi" in the message box shows matching emoji in a strip above the box, tap one to replace the token
#include "lvgl.h"
#include <ctype.h>
#include <stdint.h>
#include <string.h>
#include "MuiPrefs.h"

#include "emoji_names.inc"

static const int MAX_SUGGESTIONS = 8;

// ---- Node Mentions via @ ----
typedef void (*MentionCallback)(const char *longName, const char *shortName, uint32_t num);
typedef void (*MentionHostFn)(const char *query, MentionCallback cb);
static MentionHostFn g_mentionHost = nullptr;

extern "C" void emoji_mention_host(MentionHostFn fn)
{
    g_mentionHost = fn;
}

// Token starts with @ followed by zero or more chars
static bool find_mention_token(const char *t, char *query, int qsize, int *tokenLen)
{
    int n = (int)strlen(t);
    int i = n;
    while (i > 0 && (isalnum((unsigned char)t[i - 1]) || t[i - 1] == '-' || t[i - 1] == '_'))
        i--;
    if (i < 1 || t[i - 1] != '@')
        return false;
    if (i - 1 > 0 && t[i - 2] != ' ' && t[i - 2] != '
')
        return false;
    int chars = n - i;
    if (chars >= qsize)
        return false;
    for (int k = 0; k < chars; k++)
        query[k] = (char)tolower((unsigned char)t[i + k]);
    query[chars] = 0;
    *tokenLen = chars + 1;
    return true;
}

struct MentionMatch {
    char shortName[8];
    char longName[24];
    uint32_t num;
};
static MentionMatch g_mentionHits[8];
static int g_mentionHitCount = 0;

static void mention_collector(const char *longName, const char *shortName, uint32_t num)
{
    if (g_mentionHitCount >= 8 || !shortName || !shortName[0])
        return;
    MentionMatch &m = g_mentionHits[g_mentionHitCount++];
    strncpy(m.shortName, shortName, sizeof(m.shortName) - 1);
    m.shortName[sizeof(m.shortName) - 1] = 0;
    strncpy(m.longName, longName ? longName : shortName, sizeof(m.longName) - 1);
    m.longName[sizeof(m.longName) - 1] = 0;
    m.num = num;
}

static void pick_mention_cb(lv_event_t *e)
{
    lv_obj_t *label = (lv_obj_t *)lv_event_get_target(e);
    const char *shortName = (const char *)lv_obj_get_user_data(label);
    if (!shortName || !g_ta)
        return;
    char query[16];
    int tokenLen = 0;
    if (!find_mention_token(lv_textarea_get_text(g_ta), query, sizeof(query), &tokenLen))
        return;
    g_picking = true;
    lv_textarea_set_cursor_pos(g_ta, LV_TEXTAREA_CURSOR_LAST);
    for (int k = 0; k < tokenLen; k++)
        lv_textarea_delete_char(g_ta);
    char insertText[32];
    snprintf(insertText, sizeof(insertText), "@%s ", shortName);
    lv_textarea_add_text(g_ta, insertText);
    g_picking = false;
    hide_strip();
}

extern "C" bool emoji_reply_active(void);
extern "C" void emoji_recent_note(const char *txt) __attribute__((weak));
static lv_obj_t *g_strip = nullptr;
static lv_obj_t *g_ta = nullptr;
static bool g_picking = false;

static int utf8_encode(uint32_t cp, char *out)
{
    if (cp < 0x80) {
        out[0] = (char)cp;
        out[1] = 0;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        out[2] = 0;
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        out[3] = 0;
        return 3;
    }
    out[0] = (char)(0xF0 | (cp >> 18));
    out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
    out[3] = (char)(0x80 | (cp & 0x3F));
    out[4] = 0;
    return 4;
}

// token is a colon that starts the text or follows a space, then one or more letters up to the end of the text
static bool find_token(const char *t, char *query, int qsize, int *tokenLen)
{
    int n = (int)strlen(t);
    int i = n;
    while (i > 0 && isalpha((unsigned char)t[i - 1]))
        i--;
    int letters = n - i;
    if (letters < 1 || letters >= qsize || i < 1 || t[i - 1] != ':')
        return false;
    if (i - 1 > 0 && t[i - 2] != ' ')
        return false;
    for (int k = 0; k < letters; k++)
        query[k] = (char)tolower((unsigned char)t[i + k]);
    query[letters] = 0;
    *tokenLen = letters + 1;
    return true;
}

// 0 = first word starts with the query, 1 = a later word does, -1 = no match
static int match_rank(const char *words, const char *q)
{
    size_t ql = strlen(q);
    const char *p = words;
    int word = 0;
    while (*p) {
        while (*p == ' ')
            p++;
        if (!*p)
            break;
        if (strncmp(p, q, ql) == 0)
            return word == 0 ? 0 : 1;
        while (*p && *p != ' ')
            p++;
        word++;
    }
    return -1;
}

static void hide_strip(void)
{
    if (g_strip)
        lv_obj_add_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
}

static void pick_cb(lv_event_t *e)
{
    lv_obj_t *label = (lv_obj_t *)lv_event_get_target(e);
    uint32_t code = (uint32_t)(uintptr_t)lv_obj_get_user_data(label);
    char query[16];
    int tokenLen = 0;
    if (!g_ta || !find_token(lv_textarea_get_text(g_ta), query, sizeof(query), &tokenLen))
        return;
    char utf8[5];
    utf8_encode(code, utf8);
    g_picking = true;
    lv_textarea_set_cursor_pos(g_ta, LV_TEXTAREA_CURSOR_LAST);
    for (int k = 0; k < tokenLen; k++)
        lv_textarea_delete_char(g_ta);
    lv_textarea_add_text(g_ta, utf8);
    if (emoji_recent_note)
        emoji_recent_note(utf8);
    g_picking = false;
    hide_strip();
}

static void text_changed_cb(lv_event_t *e)
{
    if (g_picking || !g_strip || !g_ta)
        return;
    const char *fullText = lv_textarea_get_text(g_ta);
    char query[16];
    int tokenLen = 0;

    // Check for @mention trigger first
    if (g_mentionHost && find_mention_token(fullText, query, sizeof(query), &tokenLen)) {
        g_mentionHitCount = 0;
        g_mentionHost(query, mention_collector);
        if (g_mentionHitCount > 0) {
            lv_obj_clean(g_strip);
            for (int i = 0; i < g_mentionHitCount; i++) {
                // Filter by query if query has letters
                if (query[0]) {
                    char lwr[24];
                    for (int k = 0; g_mentionHits[i].shortName[k] && k < 23; k++)
                        lwr[k] = (char)tolower((unsigned char)g_mentionHits[i].shortName[k]);
                    lwr[strlen(g_mentionHits[i].shortName)] = 0;
                    if (!strstr(lwr, query)) {
                        for (int k = 0; g_mentionHits[i].longName[k] && k < 23; k++)
                            lwr[k] = (char)tolower((unsigned char)g_mentionHits[i].longName[k]);
                        lwr[strlen(g_mentionHits[i].longName)] = 0;
                        if (!strstr(lwr, query)) continue;
                    }
                }
                char pill[32];
                snprintf(pill, sizeof(pill), "@%s", g_mentionHits[i].shortName);
                lv_obj_t *chip = lv_label_create(g_strip);
                lv_label_set_text(chip, pill);
                lv_obj_set_style_pad_hor(chip, 8, 0);
                lv_obj_set_style_pad_ver(chip, 4, 0);
                lv_obj_set_style_bg_color(chip, lv_color_hex(0x238636), 0);
                lv_obj_set_style_bg_opa(chip, LV_OPA_COVER, 0);
                lv_obj_set_style_text_color(chip, lv_color_hex(0xFFFFFF), 0);
                lv_obj_set_style_radius(chip, 6, 0);
                lv_obj_set_user_data(chip, (void *)g_mentionHits[i].shortName);
                lv_obj_add_flag(chip, LV_OBJ_FLAG_CLICKABLE);
                lv_obj_add_event_cb(chip, pick_mention_cb, LV_EVENT_CLICKED, nullptr);
            }
            if (lv_obj_get_child_count(g_strip) > 0) {
                lv_obj_remove_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
                lv_obj_align_to(g_strip, g_ta, LV_ALIGN_OUT_TOP_LEFT, 0, emoji_reply_active() ? -40 : -2);
                lv_obj_move_foreground(g_strip);
                return;
            }
        }
    }

    if (!find_token(fullText, query, sizeof(query), &tokenLen)) {
        hide_strip();
        return;
    }
    uint32_t hits[MAX_SUGGESTIONS];
    int count = 0;
    for (int pass = 0; pass < 2; pass++) {
        for (unsigned i = 0; i < sizeof(emoji_names) / sizeof(emoji_names[0]) && count < MAX_SUGGESTIONS; i++) {
            if (match_rank(emoji_names[i].words, query) == pass)
                hits[count++] = emoji_names[i].code;
        }
    }
    if (count == 0) {
        hide_strip();
        return;
    }
    lv_obj_clean(g_strip);
    for (int i = 0; i < count; i++) {
        char utf8[5];
        utf8_encode(hits[i], utf8);
        lv_obj_t *label = lv_label_create(g_strip);
        lv_label_set_text(label, utf8);
        lv_obj_set_style_pad_all(label, 5, 0);
        lv_obj_set_user_data(label, (void *)(uintptr_t)hits[i]);
        lv_obj_add_flag(label, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_add_event_cb(label, pick_cb, LV_EVENT_CLICKED, nullptr);
    }
    lv_obj_remove_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
    lv_obj_align_to(g_strip, g_ta, LV_ALIGN_OUT_TOP_LEFT, 0, emoji_reply_active() ? -40 : -2);
    lv_obj_move_foreground(g_strip);
}

extern "C" void emoji_suggest_init(lv_obj_t *ta)
{
    if (g_strip || !ta)
        return;
    g_ta = ta;
    lv_obj_t *parent = lv_obj_get_parent(ta);
    g_strip = lv_obj_create(parent);
    lv_obj_set_size(g_strip, LV_SIZE_CONTENT, 34);
    lv_obj_set_flex_flow(g_strip, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(g_strip, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_remove_flag(g_strip, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_style_bg_color(g_strip, lv_color_hex(0xDFE3EE), 0);
    lv_obj_set_style_bg_opa(g_strip, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(g_strip, 0, 0);
    lv_obj_set_style_radius(g_strip, 6, 0);
    lv_obj_set_style_pad_all(g_strip, 2, 0);
    lv_obj_set_style_pad_gap(g_strip, 0, 0);
    lv_obj_add_flag(g_strip, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_event_cb(ta, text_changed_cb, LV_EVENT_VALUE_CHANGED, nullptr);
}

// Setting: show the sender's long name instead of the 4 character short name in group chat bubbles, kept in NVS. The switch for it
// is in the advanced settings panel.
static int g_nameMode = 0; // 0 short name, 1 long name, 2 short name chip and long name
static bool g_namesLoaded = false;

static void names_load(void)
{
    if (g_namesLoaded)
        return;
    g_namesLoaded = true;
    Preferences prefs;
    if (prefs.begin("chatui", true)) {
        int m = prefs.getInt("chatnames", -1);
        g_nameMode = (m >= 0 && m <= 2) ? m : (prefs.getBool("longnames", false) ? 1 : 0);
        prefs.end();
    }
}

extern "C" int emoji_name_mode(void)
{
    names_load();
    return g_nameMode;
}

// the long name is in the header for the modes long and both
extern "C" bool emoji_long_names(void)
{
    return emoji_name_mode() != 0;
}

extern "C" int emoji_name_mode_cycle(void)
{
    names_load();
    g_nameMode = (g_nameMode + 1) % 3;
    Preferences prefs;
    if (prefs.begin("chatui", false)) {
        prefs.putInt("chatnames", g_nameMode);
        prefs.end();
    }
    return g_nameMode;
}

extern "C" bool emoji_long_names_toggle(void)
{
    emoji_name_mode_cycle();
    return emoji_long_names();
}

extern "C" bool emoji_hops_enabled(void)
{
    Preferences prefs;
    if (prefs.begin("chatui", true)) {
        bool en = prefs.getBool("show_hops", true);
        prefs.end();
        return en;
    }
    return true;
}

extern "C" bool emoji_hops_toggle(void)
{
    bool curr = emoji_hops_enabled();
    bool next = !curr;
    Preferences prefs;
    if (prefs.begin("chatui", false)) {
        prefs.putBool("show_hops", next);
        prefs.end();
    }
    return next;
}

extern "C" bool emoji_snr_enabled(void)
{
    Preferences prefs;
    if (prefs.begin("chatui", true)) {
        bool en = prefs.getBool("show_snr", true);
        prefs.end();
        return en;
    }
    return true;
}

extern "C" bool emoji_snr_toggle(void)
{
    bool curr = emoji_snr_enabled();
    bool next = !curr;
    Preferences prefs;
    if (prefs.begin("chatui", false)) {
        prefs.putBool("show_snr", next);
        prefs.end();
    }
    return next;
}

// Replies and reactions carry the id of the message they answer. Remember the last few text messages so a reply can show a
// quote line with what it answers, like the phone app does.
struct QuoteEntry {
    uint32_t id;
    char text[40];
};
static QuoteEntry g_quotes[16];
static int g_quoteNext = 0;

static void quote_store(uint32_t id, const char *text, size_t len)
{
    if (id == 0)
        return;
    QuoteEntry &e = g_quotes[g_quoteNext];
    g_quoteNext = (g_quoteNext + 1) % 16;
    e.id = id;
    size_t n = len < 34 ? len : 34;
    if (len > 34)
        while (n > 0 && ((unsigned char)text[n] & 0xC0) == 0x80)
            n--;
    memcpy(e.text, text, n);
    for (size_t i = 0; i < n; i++)
        if (e.text[i] == '\n')
            e.text[i] = ' ';
    if (len > 34) {
        e.text[n++] = '.';
        e.text[n++] = '.';
    }
    e.text[n] = 0;
}

extern "C" void emoji_quote_record(uint32_t id, const char *text)
{
    quote_store(id, text, strlen(text));
}

// returns the text to show: for a reply or a reaction a quote line comes first, then the message
extern "C" size_t emoji_quote_compose(uint32_t id, uint32_t replyId, uint32_t emojiFlag, const char *payload, size_t size, char *out,
                                      size_t outSize)
{
    size_t pos = 0;
    if (replyId != 0 || emojiFlag != 0) {
        const char *orig = nullptr;
        for (int i = 0; i < 16; i++)
            if (g_quotes[i].id == replyId && replyId != 0)
                orig = g_quotes[i].text;
        int w = snprintf(out, outSize, "> %s\n", orig ? orig : "replying to a message");
        pos = (w < 0) ? 0 : ((size_t)w < outSize ? (size_t)w : outSize - 1);
    }
    quote_store(id, payload, size);
    size_t room = outSize - 1 - pos;
    size_t n = size < room ? size : room;
    memcpy(out + pos, payload, n);
    out[pos + n] = 0;
    return pos + n;
}

extern "C" lv_obj_t *emoji_textarea(void)
{
    return g_ta;
}

// ---- MQTT Client Proxy Safeguard & Force Override ----
// Mode 0: Auto Safeguard (Disables proxy to client when Wi-Fi is connected, avoiding loops/duplicates)
// Mode 1: Force Override ON (Manually forces proxy to client active)
// Mode 2: Force Override OFF (Manually forces proxy to client inactive)
extern "C" int emoji_mqtt_proxy_mode(void)
{
    Preferences prefs;
    if (prefs.begin("chatui", true)) {
        int m = prefs.getInt("mqtt_proxy_mode", 0);
        prefs.end();
        return (m >= 0 && m <= 2) ? m : 0;
    }
    return 0;
}

extern "C" int emoji_mqtt_proxy_mode_cycle(void)
{
    int next = (emoji_mqtt_proxy_mode() + 1) % 3;
    Preferences prefs;
    if (prefs.begin("chatui", false)) {
        prefs.putInt("mqtt_proxy_mode", next);
        prefs.end();
    }
    return next;
}

extern "C" bool emoji_effective_mqtt_proxy(bool configProxy, bool isNetworkConnected)
{
    int mode = emoji_mqtt_proxy_mode();
    if (mode == 1) return true;  // Force ON override
    if (mode == 2) return false; // Force OFF override
    // Mode 0: Auto Safeguard - disable client proxy if WiFi network is active
    if (isNetworkConnected) return false;
    return configProxy;
}
