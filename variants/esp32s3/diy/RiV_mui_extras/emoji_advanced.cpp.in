{

    if (g_namesLabel)

        lv_label_set_text(lv_obj_get_child(g_namesLabel, 0),

                          emoji_name_mode() == 1 ? "Chat names: long" : (emoji_name_mode() == 2 ? "Chat names: both" : "Chat names: short"));

}



