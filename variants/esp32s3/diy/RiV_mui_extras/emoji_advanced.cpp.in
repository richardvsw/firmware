    close_panel(g_radioPanel);

}



static void radio_save_cb(lv_event_t *e) {

    if (!g_radioDd) return;

    int sel = (int)lv_dropdown_get_selected(g_radioDd);

    FILE *fp = fopen("/usr/data/radio_mode.txt", "w");

    if (fp) {

        if (sel == 0) fputs("sim\n", fp);

        else if (sel == 1) fputs("usb\n", fp);

        else if (sel == 2) fputs("wifi\n", fp);

        fclose(fp);

    }

    lv_label_set_text(g_radioStatus, "Radio mode saved! Restart daemon to apply.");

}



static void build_radio_panel(void) {

    lv_obj_t *content;

    g_radioPanel = make_panel("Radio Interface", radio_back_cb, &content);



    make_section_header(content, "SELECT RADIO HARDWARE");

    g_radioDd = make_dropdown(content, "Radio Type", "Simulated (sim)\nUSB LoRa Dongle (SX1262/CH341)\nWi-Fi / TCP Remote Radio");



    make_section_header(content, "HARDWARE OPTIONS");

    g_taRadioUsb = make_field(content, "USB Device (/dev/ttyUSB0 or ch341)", 31, false);

    g_taRadioWifi = make_field(content, "Remote Radio IP (e.g. 192.168.4.1:4403)", 31, false);



    // Read current mode

    FILE *fp = fopen("/usr/data/radio_mode.txt", "r");

    if (fp) {

        char buf[32] = {0};

        if (fgets(buf, sizeof(buf), fp)) {

            if (strstr(buf, "usb")) lv_dropdown_set_selected(g_radioDd, 1);

            else if (strstr(buf, "wifi")) lv_dropdown_set_selected(g_radioDd, 2);

            else lv_dropdown_set_selected(g_radioDd, 0);

        }

        fclose(fp);

    }



    g_radioStatus = make_status(content);

    make_save_cancel(content, radio_save_cb, radio_back_cb);



    lv_obj_t *pad = lv_obj_create(content);

    lv_obj_remove_style_all(pad);

    lv_obj_set_size(pad, 10, 150);

}



static void radio_open_cb(lv_event_t *e) {

    if (!g_radioPanel)

        build_radio_panel();

    open_panel(g_radioPanel);

}

