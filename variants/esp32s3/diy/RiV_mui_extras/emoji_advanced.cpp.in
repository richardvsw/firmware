static lv_obj_t *g_swEnabled = nullptr, *g_swEnc = nullptr, *g_swTls = nullptr;

static lv_obj_t *g_taAddress = nullptr, *g_taUser = nullptr, *g_taPass = nullptr, *g_taRoot = nullptr;



// Dynamic theme colors inherited from MUI Themes

static uint32_t g_themeBg = 0x303030;

static uint32_t g_themeTopBg = 0x436C70;

static uint32_t g_themeTopText = 0xE0E0E0;

static uint32_t g_themeItemBg = 0x404040;

static uint32_t g_themeItemText = 0xF0F0F0;

static uint32_t g_themeBtnBg = 0x505050;

static uint32_t g_themeBtnText = 0xAAFBFF;

static uint32_t g_themeAccent = 0xAAFBFF;

static uint32_t g_themeBorder = 0x808080;

static uint32_t g_themePressedBg = 0x303030;



#define COL_BG g_themeBg

#define COL_BAR g_themeTopBg

#define COL_BTN g_themeBtnBg

#define COL_FIELD g_themeItemBg



struct PanelRecord {

    lv_obj_t *root;

    lv_obj_t *bar;

    lv_obj_t *back;

    lv_obj_t *title;

    lv_obj_t *content;

};

static std::vector<PanelRecord> g_panelRecords;



static void emoji_advanced_retheme_all(void)

{

    for (auto &p : g_panelRecords) {

        if (p.root && lv_obj_is_valid(p.root))

            lv_obj_set_style_bg_color(p.root, lv_color_hex(g_themeBg), 0);

        if (p.bar && lv_obj_is_valid(p.bar))

            lv_obj_set_style_bg_color(p.bar, lv_color_hex(g_themeTopBg), 0);

        if (p.back && lv_obj_is_valid(p.back)) {

            lv_obj_set_style_bg_color(p.back, lv_color_hex(g_themeBtnBg), 0);

            lv_obj_t *lbl = lv_obj_get_child(p.back, 0);

            if (lbl && lv_obj_is_valid(lbl))

                lv_obj_set_style_text_color(lbl, lv_color_hex(g_themeBtnText), 0);

        }

        if (p.title && lv_obj_is_valid(p.title))

            lv_obj_set_style_text_color(p.title, lv_color_hex(g_themeTopText), 0);

    }

}



extern "C" void emoji_advanced_theme(uint32_t bg, uint32_t topBg, uint32_t topText,

                                     uint32_t itemBg, uint32_t itemText,

                                     uint32_t btnBg, uint32_t btnText,

                                     uint32_t accent, uint32_t border,

                                     uint32_t pressedBg)

{

    g_themeBg = bg;

    g_themeTopBg = topBg;

    g_themeTopText = topText;

    g_themeItemBg = itemBg;

    g_themeItemText = itemText;

    g_themeBtnBg = btnBg;

    g_themeBtnText = btnText;

    g_themeAccent = accent;

    g_themeBorder = border;

    g_themePressedBg = pressedBg;



    emoji_advanced_retheme_all();

}



static void hide_kb(void)

{

    if (g_kb)

        lv_obj_add_flag(g_kb, LV_OBJ_FLAG_HIDDEN);

}



// ---- joystick and encoder navigation for the panels ----

// Only real controls take part (buttons, switches, text boxes, drop downs). While a panel is open the controls of the screens below

// are taken out of the input group and put back when the last panel closes, so the cursor can only be on something that is on screen.

// The focused control is drawn with a bright outline, so the cursor position is always visible.

static lv_obj_t *g_panelStack[8];

static int g_panelDepth = 0;

static lv_obj_t *g_savedGrp[200];

static int g_savedN = 0;

static lv_obj_t *g_savedFocus = nullptr;

static lv_style_t g_hl;

static bool g_hlInit = false;



static void hl_init(void)

{

    if (g_hlInit)

        return;

    g_hlInit = true;

    lv_style_init(&g_hl);

    lv_style_set_outline_width(&g_hl, 3);

    lv_style_set_outline_color(&g_hl, lv_color_hex(0xFFD54A));

    lv_style_set_outline_opa(&g_hl, LV_OPA_COVER);

    lv_style_set_outline_pad(&g_hl, 2);

}



static bool focusable(lv_obj_t *o)

{

    return lv_obj_check_type(o, &lv_button_class) || lv_obj_check_type(o, &lv_switch_class) || lv_obj_check_type(o, &lv_textarea_class) ||

           lv_obj_check_type(o, &lv_dropdown_class);

}



static void panel_group_add(lv_obj_t *obj, lv_group_t *g)

{

    if (focusable(obj)) {

        lv_group_add_obj(g, obj);

        lv_obj_remove_style(obj, &g_hl, LV_STATE_FOCUSED);

        lv_obj_add_style(obj, &g_hl, LV_STATE_FOCUSED);

    }

    for (uint32_t i = 0; i < lv_obj_get_child_count(obj); i++)

        panel_group_add(lv_obj_get_child(obj, i), g);

}



static void panel_group_remove(lv_obj_t *obj)

{

    if (focusable(obj)) {

        lv_group_remove_obj(obj);

        lv_obj_remove_style(obj, &g_hl, LV_STATE_FOCUSED);

    }

    for (uint32_t i = 0; i < lv_obj_get_child_count(obj); i++)

        panel_group_remove(lv_obj_get_child(obj, i));

}



static lv_obj_t *first_focusable(lv_obj_t *o)

{

    if (lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN))

        return nullptr;

    if (focusable(o))

        return o;

    for (uint32_t i = 0; i < lv_obj_get_child_count(o); i++) {

        lv_obj_t *r = first_focusable(lv_obj_get_child(o, i));

        if (r)

            return r;

    }

    return nullptr;

}



static void panel_focus_first(lv_obj_t *p)

{

    lv_group_t *g = lv_group_get_default();

    if (!g)

        return;

    // the content is the second child of a panel (bar first), fall back to the back button

    lv_obj_t *content = lv_obj_get_child_count(p) > 1 ? lv_obj_get_child(p, 1) : p;

    lv_obj_t *f = first_focusable(content);

    if (!f)

        f = first_focusable(p);

    if (f)

        lv_group_focus_obj(f);

    lv_group_set_editing(g, false);

}



// take the controls of the screens below out of the group

static void group_isolate(lv_group_t *g)

{

    g_savedN = 0;

    g_savedFocus = lv_group_get_focused(g);

    uint32_t n = lv_group_get_obj_count(g);

    if (n > 200)

        n = 200;

    for (uint32_t i = 0; i < n; i++)

        g_savedGrp[g_savedN++] = lv_group_get_obj_by_index(g, i);

    for (int i = 0; i < g_savedN; i++)

        lv_group_remove_obj(g_savedGrp[i]);

}



static void group_restore(lv_group_t *g)

{

    for (int i = 0; i < g_savedN; i++)

        if (lv_obj_is_valid(g_savedGrp[i]))

            lv_group_add_obj(g, g_savedGrp[i]);

    g_savedN = 0;

    if (g_savedFocus && lv_obj_is_valid(g_savedFocus))

        lv_group_focus_obj(g_savedFocus);

    g_savedFocus = nullptr;

}



static void open_panel(lv_obj_t *p)

{

    lv_obj_remove_flag(p, LV_OBJ_FLAG_HIDDEN);

    lv_obj_move_foreground(p);

    hl_init();

    lv_group_t *g = lv_group_get_default();

    if (g) {

        if (g_panelDepth == 0)

            group_isolate(g);

        else

            panel_group_remove(g_panelStack[g_panelDepth - 1]); // the panel below stays visible but is not navigable

        panel_group_add(p, g);

        if (g_panelDepth < 8)

            g_panelStack[g_panelDepth++] = p;

        panel_focus_first(p);

    }

}



static void close_panel(lv_obj_t *p)

{

    hide_kb();

    lv_group_t *g = lv_group_get_default();

    if (g) {

        panel_group_remove(p);

        if (g_panelDepth > 0 && g_panelStack[g_panelDepth - 1] == p)

            g_panelDepth--;

        if (g_panelDepth > 0) {

            panel_group_add(g_panelStack[g_panelDepth - 1], g);

            panel_focus_first(g_panelStack[g_panelDepth - 1]);

        } else {

            group_restore(g);

        }

    }

    lv_obj_add_flag(p, LV_OBJ_FLAG_HIDDEN);

}



// returns the lv_button; child 0 is the lv_label (use lv_obj_get_child(btn,0) to set text)

static lv_obj_t *make_label_button(lv_obj_t *parent, const char *text, uint32_t bg, lv_event_cb_t cb)

{

    lv_obj_t *b = lv_button_create(parent);

    lv_obj_set_style_bg_color(b, lv_color_hex(bg), 0);

    lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);

    lv_obj_set_style_radius(b, 8, 0);

    lv_obj_set_style_pad_hor(b, 14, 0);

    lv_obj_set_style_pad_ver(b, 10, 0);

    lv_obj_t *l = lv_label_create(b);

    lv_label_set_text(l, text);

    lv_obj_set_style_text_color(l, lv_color_hex(g_themeBtnText), 0);

    if (cb)

        lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, nullptr);

    return b;

}



// full screen panel with a title bar, a back button and a scrolling column for the content

static lv_obj_t *make_panel(const char *title, lv_event_cb_t backCb, lv_obj_t **contentOut)

{

    lv_obj_t *root = lv_obj_create(g_screen);

    lv_obj_remove_style_all(root);

    lv_obj_set_size(root, lv_pct(100), lv_pct(100));

    lv_obj_set_style_bg_color(root, lv_color_hex(g_themeBg), 0);

    lv_obj_set_style_bg_opa(root, LV_OPA_COVER, 0);

    lv_obj_remove_flag(root, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_set_flex_flow(root, LV_FLEX_FLOW_COLUMN);

    lv_obj_set_style_pad_all(root, 0, 0);

    lv_obj_set_style_pad_row(root, 0, 0);



    // Title / Top Bar (Native MUI TopPanel Style)

    lv_obj_t *bar = lv_obj_create(root);

    lv_obj_remove_style_all(bar);

    lv_obj_set_size(bar, lv_pct(100), 40);

    add_style_top_panel_style(bar);

    lv_obj_set_style_bg_color(bar, lv_color_hex(g_themeTopBg), 0);

    lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);

    lv_obj_set_style_border_width(bar, 0, 0);

    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);



    lv_obj_t *back = lv_button_create(bar);

    lv_obj_set_size(back, 64, 28);

    add_style_settings_button_style(back);

    lv_obj_set_style_shadow_width(back, 0, 0);

    lv_obj_set_style_radius(back, 6, 0);

    lv_obj_align(back, LV_ALIGN_LEFT_MID, 6, 0);

    if (backCb)

        lv_obj_add_event_cb(back, backCb, LV_EVENT_CLICKED, nullptr);



    lv_obj_t *bl = lv_label_create(back);

    lv_label_set_text(bl, LV_SYMBOL_LEFT " Back");

    lv_obj_set_style_align(bl, LV_ALIGN_CENTER, 0);



    lv_obj_t *t = lv_label_create(bar);

    lv_label_set_text_fmt(t, "%s %s", LV_SYMBOL_SETTINGS, title);

    lv_obj_set_style_text_color(t, lv_color_hex(g_themeTopText), 0);

    lv_obj_set_style_text_font(t, &lv_font_montserrat_16, 0);

    lv_obj_align(t, LV_ALIGN_LEFT_MID, 78, 0);



    lv_obj_t *content = lv_obj_create(root);

    lv_obj_remove_style_all(content);

    lv_obj_set_width(content, lv_pct(100));

    lv_obj_set_flex_grow(content, 1);

    lv_obj_set_style_pad_top(content, 10, 0);

    lv_obj_set_style_pad_bottom(content, 12, 0);

    lv_obj_set_style_pad_left(content, 0, 0);

    lv_obj_set_style_pad_right(content, 0, 0);

    lv_obj_set_style_pad_row(content, 2, 0);

    lv_obj_set_flex_flow(content, LV_FLEX_FLOW_COLUMN);

    lv_obj_set_flex_align(content, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    lv_obj_set_scroll_dir(content, LV_DIR_VER);

    lv_obj_set_scrollbar_mode(content, LV_SCROLLBAR_MODE_AUTO);

    *contentOut = content;



    lv_obj_add_flag(root, LV_OBJ_FLAG_HIDDEN);

    g_panelRecords.push_back({root, bar, back, t, content});

    return root;

}



static lv_obj_t *make_status(lv_obj_t *content);

static void make_save_cancel(lv_obj_t *content, lv_event_cb_t save, lv_event_cb_t cancel);

static lv_obj_t *make_action_button(lv_obj_t *content, const char *text, lv_event_cb_t cb, uint32_t color = 0);



// ---- MQTT form ----



static void show_keyboard_for(lv_obj_t *ta)

{

    if (g_kb) {

        lv_obj_remove_flag(g_kb, LV_OBJ_FLAG_HIDDEN);

        lv_obj_move_foreground(g_kb);

        lv_keyboard_set_textarea(g_kb, ta);

    }

    if (g_showKb && ta) {

        lv_group_focus_obj(ta);

        g_showKb(ta);

    }

}



static void ta_click_cb(lv_event_t *e)

{

    lv_obj_t *ta = (lv_obj_t *)lv_event_get_target(e);

    show_keyboard_for(ta);

}



static void kb_btn_click_cb(lv_event_t *e)

{

    lv_obj_t *ta = (lv_obj_t *)lv_event_get_user_data(e);

    if (ta)

        show_keyboard_for(ta);

}



static lv_obj_t *make_field(lv_obj_t *content, const char *label, uint32_t maxLen, bool password)

{

    lv_obj_t *l = lv_label_create(content);

    lv_label_set_text(l, label);

    lv_obj_set_style_text_color(l, lv_color_hex(g_themeAccent), 0);

    lv_obj_set_style_pad_left(l, 4, 0);

    lv_obj_set_style_pad_top(l, 4, 0);



    lv_obj_t *row = lv_obj_create(content);

    lv_obj_remove_style_all(row);

    lv_obj_set_size(row, LV_PCT(95), 36);

    lv_obj_set_style_align(row, LV_ALIGN_TOP_MID, 0);

    lv_obj_remove_flag(row, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);

    lv_obj_set_flex_align(row, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    lv_obj_set_style_pad_column(row, 6, 0);



    lv_obj_t *ta = lv_textarea_create(row);

    lv_obj_set_flex_grow(ta, 1);

    lv_textarea_set_one_line(ta, true);

    lv_textarea_set_max_length(ta, maxLen);

    lv_textarea_set_password_mode(ta, password);

    lv_obj_set_style_bg_color(ta, lv_color_hex(g_themeItemBg), 0);

    lv_obj_set_style_text_color(ta, lv_color_hex(g_themeItemText), 0);

    lv_obj_set_style_border_color(ta, lv_color_hex(g_themeBorder), 0);

    lv_obj_set_style_border_width(ta, 1, 0);

    lv_obj_set_style_radius(ta, 6, 0);

    lv_obj_set_style_pad_hor(ta, 8, 0);

    lv_obj_set_style_pad_ver(ta, 6, 0);

    lv_obj_add_event_cb(ta, ta_click_cb, LV_EVENT_CLICKED, nullptr);



    // Keyboard trigger button with authentic MUI keyboard icon

    lv_obj_t *kbBtn = lv_button_create(row);

    lv_obj_set_size(kbBtn, 36, 32);

    lv_obj_set_style_radius(kbBtn, 6, 0);

    lv_obj_set_style_bg_color(kbBtn, lv_color_hex(0xffffff), 0);

    lv_obj_set_style_bg_image_src(kbBtn, &img_keyboard_image, 0);

    lv_obj_set_style_bg_image_recolor(kbBtn, lv_color_hex(0x373737), 0);

    lv_obj_set_style_bg_image_recolor_opa(kbBtn, 255, 0);

    lv_obj_set_style_shadow_width(kbBtn, 0, 0);

    lv_obj_add_event_cb(kbBtn, kb_btn_click_cb, LV_EVENT_CLICKED, ta);



    return ta;

}



static lv_obj_t *make_switch_row(lv_obj_t *content, const char *label)

{

    lv_obj_t *row = lv_obj_create(content);

    lv_obj_remove_style_all(row);

    lv_obj_set_size(row, LV_PCT(95), 34);

    lv_obj_set_style_align(row, LV_ALIGN_TOP_MID, 0);

    lv_obj_remove_flag(row, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_t *l = lv_label_create(row);

    lv_label_set_text(l, label);

    lv_obj_set_style_text_color(l, lv_color_hex(g_themeItemText), 0);

    lv_obj_align(l, LV_ALIGN_LEFT_MID, 2, 0);

    lv_obj_t *sw = lv_switch_create(row);

    lv_obj_align(sw, LV_ALIGN_RIGHT_MID, 2, 0);

    lv_obj_set_style_bg_color(sw, lv_color_hex(0x67EA94), LV_PART_INDICATOR | LV_STATE_CHECKED);

    return sw;

}



static void set_switch(lv_obj_t *sw, bool on)

{

    if (on)

        lv_obj_add_state(sw, LV_STATE_CHECKED);

    else

        lv_obj_remove_state(sw, LV_STATE_CHECKED);

}



static void show_pass_cb(lv_event_t *e)

{

    lv_obj_t *l = (lv_obj_t *)lv_event_get_target(e);

    bool hidden = lv_textarea_get_password_mode(g_taPass);

    lv_textarea_set_password_mode(g_taPass, !hidden);

    lv_label_set_text(lv_obj_get_child(l, 0), hidden ? "Hide password" : "Show password");

}



static void mqtt_load(void)

{

    meshtastic_ModuleConfig_MQTTConfig *c = (meshtastic_ModuleConfig_MQTTConfig *)g_mqttCfg();

    set_switch(g_swEnabled, c->enabled);

    set_switch(g_swEnc, c->encryption_enabled);

    set_switch(g_swTls, c->tls_enabled);

    const char *rawAddr = c->address;

    if (rawAddr && rawAddr[0] == '\'' && rawAddr[strlen(rawAddr) - 1] == '\'') {

        char clean[64];

        size_t len = strlen(rawAddr);

        if (len >= 2 && len < sizeof(clean) + 2) {

            strncpy(clean, rawAddr + 1, len - 2);

            clean[len - 2] = 0;

            lv_textarea_set_text(g_taAddress, clean);

        } else {

            lv_textarea_set_text(g_taAddress, rawAddr);

        }

    } else {

        lv_textarea_set_text(g_taAddress, rawAddr ? rawAddr : "");

    }

    lv_textarea_set_text(g_taUser, c->username);

    lv_textarea_set_text(g_taPass, c->password);

    lv_textarea_set_text(g_taRoot, c->root[0] ? c->root : "msh/ID");

    lv_label_set_text(g_mqttStatus, "");

}



static void copy_text(char *dst, size_t size, lv_obj_t *ta)

{

    strncpy(dst, lv_textarea_get_text(ta), size - 1);

    dst[size - 1] = 0;

}



static void mqtt_save_cb(lv_event_t *e)

{

    meshtastic_ModuleConfig_MQTTConfig *c = (meshtastic_ModuleConfig_MQTTConfig *)g_mqttCfg();

    c->enabled = lv_obj_has_state(g_swEnabled, LV_STATE_CHECKED);

    c->encryption_enabled = lv_obj_has_state(g_swEnc, LV_STATE_CHECKED);

    c->tls_enabled = lv_obj_has_state(g_swTls, LV_STATE_CHECKED);

    copy_text(c->address, sizeof(c->address), g_taAddress);

    size_t alen = strlen(c->address);

    if (alen >= 2 && c->address[0] == '\'' && c->address[alen - 1] == '\'') {

        memmove(c->address, c->address + 1, alen - 2);

        c->address[alen - 2] = 0;

    }

    copy_text(c->username, sizeof(c->username), g_taUser);

    copy_text(c->password, sizeof(c->password), g_taPass);

    copy_text(c->root, sizeof(c->root), g_taRoot);

    g_sendMqtt();

    hide_kb();

    lv_label_set_text(g_mqttStatus, "Saved, the node applies it after a restart");

}



static void mqtt_back_cb(lv_event_t *e)

{

    close_panel(g_mqttPanel);

}



static bool check_mqtt_connection(const char *address, int port, char *errOut, size_t errLen)

{

#if defined(HAS_POSIX_SOCKETS)

    if (!address || !address[0]) {

        snprintf(errOut, errLen, "No address provided");

        return false;

    }

    char host[80];

    int p = port;

    const char *colon = strchr(address, ':');

    if (colon) {

        size_t hlen = colon - address;

        if (hlen >= sizeof(host)) hlen = sizeof(host) - 1;

        strncpy(host, address, hlen);

        host[hlen] = 0;

        p = atoi(colon + 1);

        if (p <= 0) p = port;

    } else {

        strncpy(host, address, sizeof(host) - 1);

        host[sizeof(host) - 1] = 0;

    }



    struct addrinfo hints, *res = nullptr;

    memset(&hints, 0, sizeof(hints));

    hints.ai_family = AF_INET;

    hints.ai_socktype = SOCK_STREAM;

    char portStr[16];

    snprintf(portStr, sizeof(portStr), "%d", p);

    if (getaddrinfo(host, portStr, &hints, &res) != 0 || !res) {

        snprintf(errOut, errLen, "DNS lookup failed for %s", host);

        return false;

    }

    int sock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);

    if (sock < 0) {

        freeaddrinfo(res);

        snprintf(errOut, errLen, "Socket create failed");

        return false;

    }

    struct timeval tv = {3, 0};

    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, (char *)&tv, sizeof(tv));

    setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, (char *)&tv, sizeof(tv));

    int ret = connect(sock, res->ai_addr, res->ai_addrlen);

    close(sock);

    freeaddrinfo(res);

    if (ret == 0) {

        snprintf(errOut, errLen, "Connected to %s:%d OK!", host, p);

        return true;

    } else {

        snprintf(errOut, errLen, "Cannot connect to %s:%d", host, p);

        return false;

    }

#else

    snprintf(errOut, errLen, "Socket test not available");

    return false;

#endif

}



static void mqtt_check_conn_cb(lv_event_t *e)

{

    const char *addr = lv_textarea_get_text(g_taAddress);

    bool tls = lv_obj_has_state(g_swTls, LV_STATE_CHECKED);

    int defaultPort = tls ? 8883 : 1883;

    char statusBuf[96];

    bool ok = check_mqtt_connection(addr, defaultPort, statusBuf, sizeof(statusBuf));

    lv_label_set_text(g_mqttStatus, statusBuf);

    lv_obj_set_style_text_color(g_mqttStatus, lv_color_hex(ok ? 0x67EA94 : 0xF2A0A0), 0);

}



static void mqtt_cancel_cb(lv_event_t *e)

{

    close_panel(g_mqttPanel);

}



static void build_mqtt_panel(void)

{

    lv_obj_t *content;

    g_mqttPanel = make_panel("MQTT", mqtt_back_cb, &content);

    g_swEnabled = make_switch_row(content, "MQTT enabled");

    g_taAddress = make_field(content, "Address", 63, false);

    g_taUser = make_field(content, "Username", 63, false);

    g_taPass = make_field(content, "Password", 31, true);

    make_action_button(content, "Show / Hide password", show_pass_cb);

    g_swEnc = make_switch_row(content, "Encryption enabled");

    g_swTls = make_switch_row(content, "TLS enabled");

    g_taRoot = make_field(content, "Root topic", 31, false);

    make_action_button(content, "Test broker connection", mqtt_check_conn_cb);

    g_mqttStatus = lv_label_create(content);

    lv_label_set_text(g_mqttStatus, "");

    lv_obj_set_style_align(g_mqttStatus, LV_ALIGN_TOP_MID, 0);

    lv_obj_set_style_text_align(g_mqttStatus, LV_TEXT_ALIGN_CENTER, 0);

    lv_obj_set_width(g_mqttStatus, LV_PCT(95));

    lv_label_set_long_mode(g_mqttStatus, LV_LABEL_LONG_WRAP);

    lv_obj_set_style_text_color(g_mqttStatus, lv_color_hex(0x8FE0A8), 0);

    make_save_cancel(content, mqtt_save_cb, mqtt_cancel_cb);

    // room under the last button so the keyboard does not hide it

    lv_obj_t *pad = lv_obj_create(content);

    lv_obj_remove_style_all(pad);

    lv_obj_set_size(pad, 10, 150);

}



static void mqtt_open_cb(lv_event_t *e)

{

    if (!g_mqttPanel)

        build_mqtt_panel();

    mqtt_load();

    open_panel(g_mqttPanel);

}



