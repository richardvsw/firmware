}



// ---- Nodes: how many nodes are saved, remove the ones not heard for a while, and what the node stores ----

static uint32_t (*g_nodesFn)(uint32_t, bool, uint32_t *) = nullptr;

static std::set<uint32_t> g_nodeProt;

extern "C" void emoji_nodes_host(uint32_t (*fn)(uint32_t, bool, uint32_t *))

{

    g_nodesFn = fn;

}

// favorites and ignored nodes are remembered from the node list the node sends, they are never removed from here

extern "C" void emoji_node_flags(uint32_t num, bool fav, bool ign)

{

    if (fav || ign)

        g_nodeProt.insert(num);

    else

        g_nodeProt.erase(num);

}

extern "C" bool emoji_node_protected(uint32_t num)

{

    return g_nodeProt.count(num) != 0;

}



static lv_obj_t *g_ndPanel = nullptr, *g_ndInfo = nullptr, *g_ndDd = nullptr, *g_ndPrev = nullptr, *g_ndBtn = nullptr, *g_ndStatus = nullptr,

                *g_ndStore = nullptr;

static bool g_ndArmed = false;

static uint32_t g_ndStale = 0;

static const uint32_t ND_DAYS[5] = {1, 3, 7, 14, 30};



static void nd_size(char *out, size_t n, uint64_t b)

{

    if (b < 1024)

        snprintf(out, n, "%u B", (unsigned)b);

    else if (b < 1024ull * 1024)

        snprintf(out, n, "%.1f KB", (double)b / 1024.0);

    else if (b < 1024ull * 1024 * 1024)

        snprintf(out, n, "%.1f MB", (double)b / (1024.0 * 1024.0));

    else

        snprintf(out, n, "%.1f GB", (double)b / (1024.0 * 1024.0 * 1024.0));

}

static uint32_t nd_file(const char *path)

{

#if defined(HAS_LITTLEFS)

    File f = LittleFS.open(path, "r");

    if (!f)

        return 0;

    uint32_t s = (uint32_t)f.size();

    f.close();

    return s;

#else

    FILE *f = fopen(path, "rb");

    if (!f)

        return 0;

    fseek(f, 0, SEEK_END);

    long s = ftell(f);

    fclose(f);

    return s > 0 ? (uint32_t)s : 0;

#endif

}

static void nd_storage_text(char *out, size_t n)

{

    char a[24], b[24], c[24];

    int o = 0;

    nd_size(a, sizeof(a), nd_file("/prefs/nodes.proto"));

    o += snprintf(out + o, n - o, "Node list: %s\n", a);

    uint32_t cfg = nd_file("/prefs/config.proto") + nd_file("/prefs/module.proto") + nd_file("/prefs/channels.proto") + nd_file("/prefs/device.proto");

    nd_size(a, sizeof(a), cfg);

    o += snprintf(out + o, n - o, "Settings files: %s\n", a);

    nd_size(a, sizeof(a), nd_file("/prefs/uiconfig.proto"));

    o += snprintf(out + o, n - o, "Screen settings: %s\n", a);

    uint32_t files = 0, bytes = 0;

#if defined(HAS_LITTLEFS)

    File d = LittleFS.open("/messages");

    if (d && d.isDirectory()) {

        File e = d.openNextFile();

        while (e) {

            files++;

            bytes += (uint32_t)e.size();

            e.close();

            e = d.openNextFile();

        }

        d.close();

    }

#endif

    nd_size(a, sizeof(a), bytes);

    o += snprintf(out + o, n - o, "Chat log: %s in %u files (100 KB, 25 files at most, the oldest go first)\n", a, (unsigned)files);

#if defined(HAS_LITTLEFS)

    nd_size(a, sizeof(a), LittleFS.usedBytes());

    nd_size(b, sizeof(b), LittleFS.totalBytes());

#else

    nd_size(a, sizeof(a), 0);

    nd_size(b, sizeof(b), 0);

#endif

    o += snprintf(out + o, n - o, "Internal storage: %s of %s used", a, b);

    if (emoji_sd_status) {

        char pk[160];

        emoji_sd_status(pk, sizeof(pk));

        o += snprintf(out + o, n - o, "\n%s", pk);

    } else

        o += snprintf(out + o, n - o, "\nSD emoji pack: this build has no SD pack, the emoji are built in");

#if defined(HAS_STATVFS)

    struct statvfs sv;

    const char *sdPaths[] = {"/mnt/sd_0", "/usr/data/mnt/sd_0", "/sdcard"};

    for (int i = 0; i < 3; i++) {

        if (statvfs(sdPaths[i], &sv) == 0 && sv.f_blocks > 0) {

            double totalGB = ((double)sv.f_blocks * (double)sv.f_frsize) / (1024.0 * 1024.0 * 1024.0);

            double freeGB = ((double)sv.f_bavail * (double)sv.f_frsize) / (1024.0 * 1024.0 * 1024.0);

            double usedGB = totalGB > freeGB ? (totalGB - freeGB) : 0.0;

            o += snprintf(out + o, n - o, "\nSD card (%s): %.1f GB of %.1f GB used", sdPaths[i], usedGB, totalGB);

            break;

        }

    }

#elif defined(HAS_SDCARD)

    if (sdCard && sdCard->cardSize() > 1) {

        nd_size(a, sizeof(a), sdCard->usedBytes());

        nd_size(c, sizeof(c), sdCard->cardSize());

        o += snprintf(out + o, n - o, "\nSD card: %s of %s used", a, c);

    }

#endif

}

static void nd_refresh(void)

{

    char t[720];

    uint32_t st[8] = {0, 0, 0, 0, 0, 0, 0, 0};

    uint32_t days = ND_DAYS[lv_dropdown_get_selected(g_ndDd) < 5 ? lv_dropdown_get_selected(g_ndDd) : 2];

    g_ndStale = g_nodesFn ? g_nodesFn(days, false, st) : 0;

    if (g_nodesFn) {

        snprintf(t, sizeof(t), "Saved: %u of %u nodes\nHeard: last hour %u, last day %u, last week %u", (unsigned)st[0], (unsigned)st[4],

                 (unsigned)st[1], (unsigned)st[2], (unsigned)st[3]);

        lv_label_set_text(g_ndInfo, t);

        if (g_ndStale)

            snprintf(t, sizeof(t), "%u node%s would be removed. Favorites, ignored nodes, nodes with a chat and your own node stay.", (unsigned)g_ndStale,

                     g_ndStale == 1 ? "" : "s");

        else

            snprintf(t, sizeof(t), "Nothing to remove at this age.");

        lv_label_set_text(g_ndPrev, t);

    } else {

        lv_label_set_text(g_ndInfo, "The node list is not available in this build.");

        lv_label_set_text(g_ndPrev, "");

    }

    g_ndArmed = false;

    lv_label_set_text(lv_obj_get_child(g_ndBtn, 0), "Remove old nodes");

    nd_storage_text(t, sizeof(t));

    lv_label_set_text(g_ndStore, t);

}

static void nd_back_cb(lv_event_t *e)

{

    close_panel(g_ndPanel);

}

static void nd_dd_cb(lv_event_t *e)

{

    lv_label_set_text(g_ndStatus, "");

    nd_refresh();

}

static void nd_remove_cb(lv_event_t *e)

{

    if (!g_nodesFn)

        return;

    if (g_ndStale == 0) {

        lv_label_set_text(g_ndStatus, "Nothing to remove");

        return;

    }

    if (!g_ndArmed) {

        g_ndArmed = true;

        char t[48];

        snprintf(t, sizeof(t), "Tap again to remove %u nodes", (unsigned)g_ndStale);

        lv_label_set_text(lv_obj_get_child(g_ndBtn, 0), t);

        lv_label_set_text(g_ndStatus, "");

        return;

    }

    uint32_t st[8] = {0, 0, 0, 0, 0, 0, 0, 0};

    uint32_t days = ND_DAYS[lv_dropdown_get_selected(g_ndDd) < 5 ? lv_dropdown_get_selected(g_ndDd) : 2];

    uint32_t n = g_nodesFn(days, true, st);

    nd_refresh();

    uint32_t after[8] = {0, 0, 0, 0, 0, 0, 0, 0};

    g_nodesFn(days, false, after);

    char t[80];

    snprintf(t, sizeof(t), "Removed %u node%s, %u left", (unsigned)n, n == 1 ? "" : "s", (unsigned)after[0]);

    lv_label_set_text(g_ndStatus, t);

}

static void nd_open_cb(lv_event_t *e)

{

    if (!g_ndPanel) {

        lv_obj_t *content;

        g_ndPanel = make_panel("Nodes", nd_back_cb, &content);

        g_ndInfo = lv_label_create(content);

        lv_label_set_long_mode(g_ndInfo, LV_LABEL_LONG_WRAP);

        lv_obj_set_width(g_ndInfo, lv_pct(100));

        lv_obj_set_style_text_color(g_ndInfo, lv_color_hex(0xFFFFFF), 0);

        g_ndDd = make_dropdown(content, "Remove nodes not heard for", "1 day\n3 days\n7 days\n14 days\n30 days");

        lv_dropdown_set_selected(g_ndDd, 2);

        lv_obj_add_event_cb(g_ndDd, nd_dd_cb, LV_EVENT_VALUE_CHANGED, nullptr);

        g_ndPrev = lv_label_create(content);

        lv_label_set_long_mode(g_ndPrev, LV_LABEL_LONG_WRAP);

        lv_obj_set_width(g_ndPrev, lv_pct(100));

        lv_obj_set_style_text_color(g_ndPrev, lv_color_hex(0xF2A0A0), 0);

        g_ndBtn = make_action_button(content, "Remove old nodes", nd_remove_cb, 0x8A2F36);

        g_ndStatus = make_status(content);

        lv_obj_t *h = lv_label_create(content);

        lv_label_set_text(h, "Storage");

        lv_obj_set_style_pad_left(h, 4, 0);

        lv_obj_set_style_text_color(h, lv_color_hex(0xB8BEE6), 0);

        g_ndStore = lv_label_create(content);

        lv_label_set_long_mode(g_ndStore, LV_LABEL_LONG_WRAP);

        lv_obj_set_width(g_ndStore, LV_PCT(95));

        lv_obj_set_style_pad_left(g_ndStore, 4, 0);

        lv_obj_set_style_text_color(g_ndStore, lv_color_hex(0x9FD3FF), 0);

        lv_obj_t *pad = lv_obj_create(content);

        lv_obj_remove_style_all(pad);

        lv_obj_set_size(pad, 10, 120);

    }

    lv_label_set_text(g_ndStatus, "");

    nd_refresh();

    open_panel(g_ndPanel);

}



static void build_adv_panel(void)

{

    lv_obj_t *content;

    g_advPanel = make_panel("Advanced settings", adv_back_cb, &content);

    lv_obj_t *names = make_nav(content, "", names_cb);

    g_namesLabel = names;

    names_text();

    make_nav(content, "MQTT", mqtt_open_cb);

    make_nav(content, "Set Clock", ck_open_cb);

#if defined(ARCH_PORTDUINO)

    make_nav(content, "Radio Hardware (Portduino)", radio_open_cb);

#endif

    if (g_nodesFn)

        make_nav(content, "Nodes", nd_open_cb);

    if (g_loraCfg) {

        make_nav(content, "LoRa Extras", lora_open_cb);

        make_nav(content, "Position", pos_open_cb);

        make_nav(content, "GPS Status", gps_open_cb);

        make_nav(content, "Quiet Hours", qh_open_cb);

        make_nav(content, "Power & I2C", i2c_open_cb);

        make_nav(content, "Screensaver", ss_open_cb);

        if (g_extCfg)

            make_nav(content, "Notification Output", nt_open_cb);

        make_nav(content, "Security", sec_open_cb);

    }

}



static void adv_open_cb(lv_event_t *e)

{

    if (!g_advPanel)

        build_adv_panel();

    names_text();

    open_panel(g_advPanel);

}



// adds "Advanced settings" to the settings list, right below the button given

extern "C" void emoji_settings_init(lv_obj_t *anchor, lv_obj_t *screen, lv_obj_t *keyboard, void *(*mqttCfg)(void),

                                    void (*sendMqtt)(void), void (*showKb)(lv_obj_t *))

{

    if (g_screen || !anchor || !screen)

        return;

    g_screen = screen;

    g_kb = keyboard;

    g_mqttCfg = mqttCfg;

    g_sendMqtt = sendMqtt;

    g_showKb = showKb;

    lv_obj_t *parent = lv_obj_get_parent(anchor);

    lv_obj_t *btn = lv_button_create(parent);

    lv_obj_set_pos(btn, 0, 0);

    lv_obj_set_size(btn, LV_PCT(95), 30);

    add_style_settings_button_style(btn);

    lv_obj_set_style_align(btn, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);

    lv_obj_set_style_shadow_width(btn, 0, LV_PART_MAIN | LV_STATE_DEFAULT);

    lv_obj_set_style_pad_left(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);

    lv_obj_set_style_pad_right(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);

    lv_obj_set_style_bg_color(btn, lv_color_hex(0x4db270), LV_PART_MAIN | LV_STATE_PRESSED);

    lv_obj_set_style_text_color(btn, lv_color_hex(0x015114), LV_PART_MAIN | LV_STATE_PRESSED);

    lv_obj_t *label = lv_label_create(btn);

    lv_obj_set_size(label, LV_PCT(100), LV_SIZE_CONTENT);

    lv_label_set_long_mode(label, LV_LABEL_LONG_DOT);

    lv_obj_set_style_align(label, LV_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);

    lv_label_set_text(label, "Advanced settings");

    lv_obj_add_event_cb(btn, adv_open_cb, LV_EVENT_CLICKED, nullptr);

    hl_init();

    lv_obj_add_style(btn, &g_hl, LV_STATE_FOCUSED);

    {

        lv_group_t *grp = lv_group_get_default();

        if (grp)

            lv_group_add_obj(grp, btn);

    }

    lv_obj_move_to_index(btn, lv_obj_get_index(anchor) + 1);

}


extern "C" void emoji_message_alert(void)
{
    if (g_extPin < 0) return;
    if (emoji_quiet_now && emoji_quiet_now()) return;
    static volatile bool s_alertBusy = false;
    if (s_alertBusy) return;
    s_alertBusy = true;
#if defined(ARCH_ESP32) || defined(ARDUINO_ARCH_ESP32) || defined(ESP32)
    static auto alert_fn = [](void *arg) {
        pinMode(g_extPin, OUTPUT);
        rtttl_play(g_welTune[0] ? g_welTune : "msg:d=16,o=6,b=180:c,e,g,c7", g_extPin);
        digitalWrite(g_extPin, LOW);
        s_alertBusy = false;
        vTaskDelete(NULL);
    };
    BaseType_t ret = xTaskCreatePinnedToCore(alert_fn, "msg_alert", 3072, NULL, 1, NULL, 1);
    if (ret != pdPASS) {
        s_alertBusy = false;
    }
#else
    std::thread([]() {
        pinMode(g_extPin, OUTPUT);
        rtttl_play(g_welTune[0] ? g_welTune : "msg:d=16,o=6,b=180:c,e,g,c7", g_extPin);
        digitalWrite(g_extPin, LOW);
        s_alertBusy = false;
    }).detach();
#endif
}
