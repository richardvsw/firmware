// quiet hours, kept on the device

static bool qh_on(void)

{

    Preferences p;

    p.begin("chatui", true);

    bool v = p.getBool("qhon", false);

    p.end();

    return v;

}

static int qh_hour(const char *key, int def)

{

    Preferences p;

    p.begin("chatui", true);

    int v = p.getInt(key, def);

    p.end();

    return v;

}

extern "C" bool emoji_quiet_now(void)

{

    if (!qh_on())

        return false;

    time_t now = time(nullptr);

    if (now < 1700000000)

        return false; // clock not set

    struct tm t;

    localtime_r(&now, &t);

    int from = qh_hour("qhfrom", 22), to = qh_hour("qhto", 6), h = t.tm_hour;

    if (from == to)

        return false;

    return from < to ? (h >= from && h < to) : (h >= from || h < to);

}

static lv_obj_t *g_qhPanel = nullptr, *g_qhStatus, *g_swQh, *g_ddFrom, *g_ddTo;

static void qh_back_cb(lv_event_t *e)

{

    close_panel(g_qhPanel);

}

static void qh_save_cb(lv_event_t *e)

{

    Preferences p;

    p.begin("chatui", false);

    p.putBool("qhon", lv_obj_has_state(g_swQh, LV_STATE_CHECKED));

    p.putInt("qhfrom", lv_dropdown_get_selected(g_ddFrom));

    p.putInt("qhto", lv_dropdown_get_selected(g_ddTo));

    p.end();

    lv_label_set_text(g_qhStatus, "Saved");

}

static void qh_open_cb(lv_event_t *e)

{

    if (!g_qhPanel) {

        static char hours[24 * 6 + 1];

        hours[0] = 0;

        for (int i = 0; i < 24; i++)

            sprintf(hours + strlen(hours), "%02d:00%s", i, i < 23 ? "\n" : "");

        lv_obj_t *content;

        g_qhPanel = make_panel("Quiet hours", qh_back_cb, &content);

        g_swQh = make_switch_row(content, "Quiet hours on");

        g_ddFrom = make_dropdown(content, "From", hours);

        g_ddTo = make_dropdown(content, "To", hours);

        lv_obj_t *n = make_status(content);

        lv_label_set_text(n, "A received message does not wake the screen in this window. Needs the clock to be set.");

        lv_obj_set_style_text_color(n, lv_color_hex(0xB8BEE6), 0);

        g_qhStatus = make_status(content);

        make_save_cancel(content, qh_save_cb, qh_back_cb);

    }

    set_switch(g_swQh, qh_on());

    lv_dropdown_set_selected(g_ddFrom, qh_hour("qhfrom", 22));

    lv_dropdown_set_selected(g_ddTo, qh_hour("qhto", 6));

    lv_label_set_text(g_qhStatus, "");

    open_panel(g_qhPanel);

}



// security: new private key

static lv_obj_t *g_secPanel = nullptr, *g_secStatus, *g_regenBtn;

static bool g_regenArmed = false;

static void sec_back_cb(lv_event_t *e)

{

    g_regenArmed = false;

    lv_label_set_text(lv_obj_get_child(g_regenBtn, 0), "Regenerate private key");

    close_panel(g_secPanel);

}

static void regen_cb(lv_event_t *e)

{

    if (!g_regenArmed) {

        g_regenArmed = true;

        lv_label_set_text(lv_obj_get_child(g_regenBtn, 0), "Tap again to confirm");

        lv_label_set_text(g_secStatus, "New identity key, the node restarts. Nodes that cached the old key must see your nodeinfo again before direct messages work.");

        return;

    }

    g_regenArmed = false;

    meshtastic_Config_SecurityConfig *c = (meshtastic_Config_SecurityConfig *)g_secCfg();

#if defined(ARCH_ESP32) || defined(ARDUINO_ARCH_ESP32) || defined(ESP32)

    esp_fill_random(c->private_key.bytes, 32);

#else

    for (size_t i = 0; i < 32; i++) {

        c->private_key.bytes[i] = (uint8_t)(rand() & 0xFF);

    }

#endif

    c->private_key.bytes[0] &= 248;

    c->private_key.bytes[31] &= 127;

    c->private_key.bytes[31] |= 64;

    c->private_key.size = 32;

    c->public_key.size = 0;

    g_sendSec();

    lv_label_set_text(lv_obj_get_child(g_regenBtn, 0), "Regenerate private key");

    lv_label_set_text(g_secStatus, "Sent, the node restarts");

}

static void sec_open_cb(lv_event_t *e)

{

    if (!g_secPanel) {

        lv_obj_t *content;

        g_secPanel = make_panel("Security", sec_back_cb, &content);

        g_regenBtn = make_action_button(content, "Regenerate private key", regen_cb, 0x8A2F36);

        g_secStatus = make_status(content);

        lv_obj_set_style_text_color(g_secStatus, lv_color_hex(0xF2A0A0), 0);

    }

    lv_label_set_text(g_secStatus, "");

    open_panel(g_secPanel);

}



// GPS status from our own node's position reports

struct GpsSnap {

    bool valid;

    uint32_t at, sats, fixType, time;

    float hdop, pdop, vdop, speedKmh, heading;

    int32_t alt, lat, lon;

};

static GpsSnap g_gps = {};

extern "C" void emoji_gps_record(const void *pp)

{

    const meshtastic_Position *p = (const meshtastic_Position *)pp;

    g_gps.valid = true;

    g_gps.at = millis();

    g_gps.sats = p->sats_in_view;

    g_gps.fixType = p->fix_type;

    g_gps.hdop = p->HDOP / 100.0f;

    g_gps.pdop = p->PDOP / 100.0f;

    g_gps.vdop = p->VDOP / 100.0f;

    g_gps.speedKmh = p->ground_speed * 3.6f;

    g_gps.heading = p->ground_track / 100000.0f;

    g_gps.alt = p->altitude;

    g_gps.lat = p->latitude_i;

    g_gps.lon = p->longitude_i;

    g_gps.time = p->time;

}



extern "C" bool emoji_gps_snapshot(uint32_t *sats, uint32_t *fix, float *hdop)

{

    if (!g_gps.valid || millis() - g_gps.at > 1800000)

        return false; // no report for 30 minutes

    *sats = g_gps.sats;

    *fix = g_gps.fixType;

    *hdop = g_gps.hdop;

    return true;

}



static lv_obj_t *g_gpsPanel = nullptr, *g_gpsText = nullptr;

static void gps_refresh(void)

{

    if (!g_gpsText)

        return;

    if (!g_gps.valid) {

        lv_label_set_text(g_gpsText, "No position received from the node yet.\nThe node reports its position on the broadcast interval, wait for a fix.");

        return;

    }

    const char *fix = g_gps.fixType == 3 ? "3D" : (g_gps.fixType == 2 ? "2D" : (g_gps.fixType == 1 ? "none" : "unknown"));

    char buf[320];

    uint32_t t = g_gps.time;

    snprintf(buf, sizeof(buf),

             "Satellites: %u\nFix: %s\nHDOP: %.1f   PDOP: %.1f   VDOP: %.1f\nSpeed: %.1f km/h\nHeading: %.0f deg\nAltitude: %d m\n"

             "Position: %.5f %.5f\nGPS time (UTC): %02u:%02u:%02u\nReported %u s ago",

             (unsigned)g_gps.sats, fix, g_gps.hdop, g_gps.pdop, g_gps.vdop, g_gps.speedKmh, g_gps.heading, (int)g_gps.alt,

             g_gps.lat * 1e-7, g_gps.lon * 1e-7, (unsigned)((t / 3600) % 24), (unsigned)((t / 60) % 60), (unsigned)(t % 60),

             (unsigned)((millis() - g_gps.at) / 1000));

    lv_label_set_text(g_gpsText, buf);

}

static void gps_timer_cb(lv_timer_t *tm)

{

    if (g_gpsPanel && !lv_obj_has_flag(g_gpsPanel, LV_OBJ_FLAG_HIDDEN))

        gps_refresh();

}

static void gps_back_cb(lv_event_t *e)

{

    close_panel(g_gpsPanel);

}

static void gps_open_cb(lv_event_t *e)

{

    if (!g_gpsPanel) {

        lv_obj_t *content;

        g_gpsPanel = make_panel("GPS status", gps_back_cb, &content);

        g_gpsText = lv_label_create(content);

        lv_label_set_long_mode(g_gpsText, LV_LABEL_LONG_WRAP);

        lv_obj_set_width(g_gpsText, lv_pct(100));

        lv_obj_set_style_text_color(g_gpsText, lv_color_hex(0xFFFFFF), 0);

        lv_timer_create(gps_timer_cb, 1000, nullptr);

    }

    gps_refresh();

    open_panel(g_gpsPanel);

}



// set clock: the GPS time, NTP, the time zone, and a time set by hand

enum RTCQuality { RTCQualityNone = 0, RTCQualityDevice = 1, RTCQualityFromNet = 2, RTCQualityNTP = 3, RTCQualityGPS = 4 };

enum RTCSetResult { RTCSetResultNotSet = 0, RTCSetResultSuccess = 1, RTCSetResultInvalidTime = 3, RTCSetResultError = 4 };

RTCQuality getRTCQuality();

RTCSetResult perhapsSetRTC(RTCQuality q, const struct timeval *tv, bool forceUpdate);



static CfgFn g_netCfg = nullptr, g_devCfg = nullptr;

static VoidFn g_sendNet = nullptr, g_sendDev = nullptr;

extern "C" void emoji_settings_host3(void *(*net)(void), void (*sendNet)(void), void *(*dev)(void), void (*sendDev)(void))

{

    g_netCfg = net;

    g_sendNet = sendNet;

    g_devCfg = dev;

    g_sendDev = sendDev;

}



static lv_obj_t *g_ckPanel = nullptr, *g_ckNow = nullptr, *g_ckGps = nullptr, *g_ckNtp = nullptr, *g_ckTz = nullptr, *g_ckMsg = nullptr;

static lv_obj_t *g_ckVal[5];

static int g_ck[5]; // year, month, day, hour, minute of the time set by hand

static const int CK_TZ[] = {-660, -600, -540, -480, -420, -360, -300, -240, -180, -120, -60, 0,   60,  120, 180, 210,

                            240,  270,  300,  330,  345,  360,  390,  420,  480,  540,  570, 600, 660, 720, 780, 840};

static const int CK_TZ_N = sizeof(CK_TZ) / sizeof(CK_TZ[0]);

static bool g_ckTzExtra = false; // the list starts with "Current setting" when the node has a time zone that is not in the list



static void ck_tz_posix(int min, char *out, size_t n)

{

    if (min == 0) {

        snprintf(out, n, "UTC0");

        return;

    }

    int a = min < 0 ? -min : min, h = a / 60, m = a % 60;

    char name[16], off[16];

    if (m)

        snprintf(name, sizeof(name), "%c%02d%02d", min < 0 ? '-' : '+', h, m);

    else

        snprintf(name, sizeof(name), "%c%02d", min < 0 ? '-' : '+', h);

    if (m)

        snprintf(off, sizeof(off), "%s%d:%02d", min < 0 ? "" : "-", h, m);

    else

        snprintf(off, sizeof(off), "%s%d", min < 0 ? "" : "-", h);

    snprintf(out, n, "<%s>%s", name, off);

}



static bool ck_gps_time(uint32_t *t, uint32_t *ageS)

{

    if (!g_gps.valid || g_gps.time < 1700000000)

        return false;

    uint32_t a = (millis() - g_gps.at) / 1000;

    if (a > 1800)

        return false;

    *t = g_gps.time + a;

    *ageS = a;

    return true;

}



static int ck_dim(int y, int m)

{

    static const int D[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    if (m == 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0))

        return 29;

    return D[(m - 1) % 12];

}



static void ck_show_fields(void)

{

    char t[8];

    for (int i = 0; i < 5; i++) {

        snprintf(t, sizeof(t), i == 0 ? "%04d" : "%02d", g_ck[i]);

        if (g_ckVal[i])

            lv_label_set_text(g_ckVal[i], t);

    }

}



static void ck_msg(const char *m)

{

    if (g_ckMsg)

        lv_label_set_text(g_ckMsg, m);

}



static void ck_refresh(void)

{

    if (!g_ckNow)

        return;

    char buf[200];

    RTCQuality q = getRTCQuality();

    if (q == RTCQualityNone) {

        snprintf(buf, sizeof(buf), "--:--:--\nsource: not set");

    } else {

        time_t now = time(nullptr);

        struct tm t;

        localtime_r(&now, &t);

        const char *src = q == RTCQualityGPS ? "GPS" : (q == RTCQualityNTP ? "NTP" : (q == RTCQualityFromNet ? "another node" : "by hand"));

        snprintf(buf, sizeof(buf), "%04d-%02d-%02d  %02d:%02d:%02d\nsource: %s", t.tm_year + 1900, t.tm_mon + 1, t.tm_mday, t.tm_hour, t.tm_min,

                 t.tm_sec, src);

    }

    lv_label_set_text(g_ckNow, buf);

    uint32_t gt, age;

    if (ck_gps_time(&gt, &age))

        snprintf(buf, sizeof(buf), "%02u:%02u:%02u UTC\nreported %u min ago", (unsigned)((gt / 3600) % 24), (unsigned)((gt / 60) % 60),

                 (unsigned)(gt % 60), (unsigned)(age / 60));

    else

        snprintf(buf, sizeof(buf), "--:--:--\nno GPS time yet, the node sends its position on the broadcast interval");

    lv_label_set_text(g_ckGps, buf);

}



static void ck_timer_cb(lv_timer_t *tm)

{

    if (g_ckPanel && !lv_obj_has_flag(g_ckPanel, LV_OBJ_FLAG_HIDDEN))

        ck_refresh();

}



static void ck_use_gps_cb(lv_event_t *e)

{

    uint32_t gt, age;

    if (!ck_gps_time(&gt, &age)) {

        ck_msg("No GPS time yet. Wait for a fix, and check that the GPS is on.");

        return;

    }

    struct timeval tv = {(time_t)gt, 0};

    perhapsSetRTC(RTCQualityGPS, &tv, true);

    ck_msg("Clock set from the GPS time.");

    ck_refresh();

}



static void ck_ntp_cb(lv_event_t *e)

{

    const char *srv = lv_textarea_get_text(g_ckNtp);

    if (!srv || !srv[0])

        srv = "pool.ntp.org";

    if (g_netCfg) {

        meshtastic_Config_NetworkConfig *nc = (meshtastic_Config_NetworkConfig *)g_netCfg();

        if (nc && strncmp(nc->ntp_server, srv, sizeof(nc->ntp_server) - 1) != 0) {

            strncpy(nc->ntp_server, srv, sizeof(nc->ntp_server) - 1);

            nc->ntp_server[sizeof(nc->ntp_server) - 1] = 0;

            if (g_sendNet)

                g_sendNet();

        }

    }

#if defined(HAS_POSIX_SOCKETS)

    struct addrinfo hints, *res = nullptr;

    memset(&hints, 0, sizeof(hints));

    hints.ai_family = AF_INET;

    hints.ai_socktype = SOCK_DGRAM;

    if (getaddrinfo(srv, "123", &hints, &res) != 0 || !res) {

        ck_msg("NTP DNS lookup failed. Check server address or internet connection.");

        return;

    }

    int sock = socket(res->ai_family, res->ai_socktype, res->ai_protocol);

    if (sock < 0) {

        freeaddrinfo(res);

        ck_msg("Could not create UDP socket.");

        return;

    }

    struct timeval tv_timeout = {3, 0};

    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, (char *)&tv_timeout, sizeof(tv_timeout));

    setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, (char *)&tv_timeout, sizeof(tv_timeout));



    uint8_t packet[48];

    memset(packet, 0, sizeof(packet));

    packet[0] = 0x1B; // LI 0, VN 3, Mode 3 (Client)



    if (sendto(sock, packet, sizeof(packet), 0, res->ai_addr, res->ai_addrlen) < 0) {

        close(sock);

        freeaddrinfo(res);

        ck_msg("Failed to send NTP request packet.");

        return;

    }

    freeaddrinfo(res);



    int rec = recv(sock, packet, sizeof(packet), 0);

    close(sock);

    if (rec < 48) {

        ck_msg("No answer from NTP server. Check internet connection.");

        return;

    }



    uint32_t secs = ((uint32_t)packet[40] << 24) | ((uint32_t)packet[41] << 16) |

                    ((uint32_t)packet[42] << 8) | ((uint32_t)packet[43]);

    if (secs < 2208988800UL) {

        ck_msg("Invalid NTP timestamp received.");

        return;

    }

    time_t epoch = (time_t)(secs - 2208988800UL);

    struct timeval tv = {epoch, 0};

    perhapsSetRTC(RTCQualityNTP, &tv, true);

    ck_msg("Clock set from NTP server.");

    ck_refresh();

#elif defined(HAS_WIFI_NTP)

    if (WiFi.status() != WL_CONNECTED) {

        ck_msg("Wi-Fi is not connected. Turn it on in the network settings first.");

        return;

    }

    WiFiUDP udp;

    NTPClient client(udp, srv);

    client.begin();

    bool ok = client.forceUpdate();

    unsigned long epoch = client.getEpochTime();

    client.end();

    if (!ok || epoch < 1700000000) {

        ck_msg("No answer from the NTP server. Check the address and the internet connection.");

        return;

    }

    struct timeval tv = {(time_t)epoch, 0};

    perhapsSetRTC(RTCQualityNTP, &tv, true);

    ck_msg("Clock set from the NTP server.");

    ck_refresh();

#else

    ck_msg("Wi-Fi NTP is not available on this platform.");

#endif

}



static void ck_step_cb(lv_event_t *e)

{

    intptr_t u = (intptr_t)lv_event_get_user_data(e);

    int f = (int)(u >> 1), d = (u & 1) ? 1 : -1;

    int lo = f == 0 ? 2024 : (f == 1 || f == 2 ? 1 : 0);

    int hi = f == 0 ? 2099 : (f == 1 ? 12 : (f == 2 ? ck_dim(g_ck[0], g_ck[1]) : (f == 3 ? 23 : 59)));

    int v = g_ck[f] + d;

    if (v > hi)

        v = lo;

    if (v < lo)

        v = hi;

    g_ck[f] = v;

    if (g_ck[2] > ck_dim(g_ck[0], g_ck[1]))

        g_ck[2] = ck_dim(g_ck[0], g_ck[1]);

    ck_show_fields();

    ck_msg("");

}



static void ck_set_cb(lv_event_t *e)

{

    struct tm t;

    memset(&t, 0, sizeof(t));

    t.tm_year = g_ck[0] - 1900;

    t.tm_mon = g_ck[1] - 1;

    t.tm_mday = g_ck[2];

    t.tm_hour = g_ck[3];

    t.tm_min = g_ck[4];

    t.tm_isdst = -1;

    time_t secs = mktime(&t);

    struct timeval tv = {secs, 0};

    perhapsSetRTC(RTCQualityDevice, &tv, true);

    ck_msg("Clock set. A GPS or NTP time will replace it.");

    ck_refresh();

}



static void ck_tz_cb(lv_event_t *e)

{

    int sel = (int)lv_dropdown_get_selected(g_ckTz);

    if (g_ckTzExtra) {

        if (sel == 0)

            return; // the current setting stays

        sel--;

    }

    if (sel < 0 || sel >= CK_TZ_N)

        return;

    char tz[24];

    ck_tz_posix(CK_TZ[sel], tz, sizeof(tz));

    setenv("TZ", tz, 1);

    tzset();

    if (g_devCfg) {

        meshtastic_Config_DeviceConfig *dc = (meshtastic_Config_DeviceConfig *)g_devCfg();

        if (dc) {

            strncpy(dc->tzdef, tz, sizeof(dc->tzdef) - 1);

            dc->tzdef[sizeof(dc->tzdef) - 1] = 0;

            if (g_sendDev)

                g_sendDev();

        }

    }

    ck_msg("Time zone set.");

    ck_refresh();

}



static void ck_back_cb(lv_event_t *e)

{

    close_panel(g_ckPanel);

}



static lv_obj_t *ck_heading(lv_obj_t *content, const char *text)

{

    lv_obj_t *l = lv_label_create(content);

    lv_label_set_text(l, text);

    lv_obj_set_style_text_color(l, lv_color_hex(0xB8BEE6), 0);

    return l;

}



static lv_obj_t *ck_value_label(lv_obj_t *content)

{

    lv_obj_t *l = lv_label_create(content);

    lv_label_set_long_mode(l, LV_LABEL_LONG_WRAP);

    lv_obj_set_width(l, lv_pct(100));

    lv_obj_set_style_text_color(l, lv_color_hex(0xFFFFFF), 0);

    lv_obj_set_style_bg_color(l, lv_color_hex(0x2A2E4D), 0);

    lv_obj_set_style_bg_opa(l, LV_OPA_COVER, 0);

    lv_obj_set_style_radius(l, 8, 0);

    lv_obj_set_style_pad_all(l, 8, 0);

    lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);

    return l;

}



static void ck_open_cb(lv_event_t *e)

{

    if (!g_ckPanel) {

        lv_obj_t *content;

        g_ckPanel = make_panel("Set clock", ck_back_cb, &content);

        ck_heading(content, "Time now");

        g_ckNow = ck_value_label(content);

        ck_heading(content, "GPS time");

        g_ckGps = ck_value_label(content);

        make_action_button(content, "Use GPS time", ck_use_gps_cb, 0x216ad8);

        g_ckNtp = make_field(content, "NTP server", 32, false);

        make_action_button(content, "Sync from NTP (needs Wi-Fi)", ck_ntp_cb, 0x216ad8);

        // the time zone, the list starts with the current setting when it is not one of the whole offsets

        const char *cur = "";

        if (g_devCfg) {

            meshtastic_Config_DeviceConfig *dc = (meshtastic_Config_DeviceConfig *)g_devCfg();

            if (dc)

                cur = dc->tzdef;

        }

        char opts[900], one[24];

        opts[0] = 0;

        int sel = -1;

        for (int i = 0; i < CK_TZ_N; i++) {

            ck_tz_posix(CK_TZ[i], one, sizeof(one));

            if (strcmp(cur, one) == 0)

                sel = i;

        }

        g_ckTzExtra = sel < 0;

        if (g_ckTzExtra)

            strcat(opts, "Current setting\n");

        for (int i = 0; i < CK_TZ_N; i++) {

            int a = CK_TZ[i] < 0 ? -CK_TZ[i] : CK_TZ[i];

            char lab[24];

            snprintf(lab, sizeof(lab), "UTC%c%02d:%02d%s", CK_TZ[i] < 0 ? '-' : '+', a / 60, a % 60, i + 1 < CK_TZ_N ? "\n" : "");

            strcat(opts, lab);

        }

        g_ckTz = make_dropdown(content, "Time zone", opts);

        lv_dropdown_set_selected(g_ckTz, g_ckTzExtra ? 0 : (uint32_t)sel);

        lv_obj_add_event_cb(g_ckTz, ck_tz_cb, LV_EVENT_VALUE_CHANGED, nullptr);

        ck_heading(content, "Or set by hand");

        lv_obj_t *row = lv_obj_create(content);

        lv_obj_remove_style_all(row);

        lv_obj_set_size(row, lv_pct(100), LV_SIZE_CONTENT);

        lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);

        lv_obj_set_flex_align(row, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START);

        lv_obj_remove_flag(row, LV_OBJ_FLAG_SCROLLABLE);

        static const char *const CAP[5] = {"year", "month", "day", "hour", "min"};

        for (int i = 0; i < 5; i++) {

            lv_obj_t *col = lv_obj_create(row);

            lv_obj_remove_style_all(col);

            lv_obj_set_size(col, lv_pct(19), LV_SIZE_CONTENT);

            lv_obj_set_flex_flow(col, LV_FLEX_FLOW_COLUMN);

            lv_obj_set_flex_align(col, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

            lv_obj_set_style_pad_row(col, 3, 0);

            lv_obj_remove_flag(col, LV_OBJ_FLAG_SCROLLABLE);

            lv_obj_t *plus = lv_button_create(col);

            lv_obj_set_size(plus, lv_pct(100), 28);

            add_style_settings_button_style(plus);

            lv_obj_set_style_shadow_width(plus, 0, 0);

            lv_obj_set_style_pad_all(plus, 0, 0);

            lv_obj_add_event_cb(plus, ck_step_cb, LV_EVENT_CLICKED, (void *)(intptr_t)((i << 1) | 1));

            lv_obj_t *pl = lv_label_create(plus);

            lv_label_set_text(pl, "+");

            lv_obj_center(pl);

            g_ckVal[i] = lv_label_create(col);

            lv_obj_set_style_text_color(g_ckVal[i], lv_color_hex(0xFFFFFF), 0);

            lv_obj_t *minus = lv_button_create(col);

            lv_obj_set_size(minus, lv_pct(100), 28);

            add_style_settings_button_style(minus);

            lv_obj_set_style_shadow_width(minus, 0, 0);

            lv_obj_set_style_pad_all(minus, 0, 0);

            lv_obj_add_event_cb(minus, ck_step_cb, LV_EVENT_CLICKED, (void *)(intptr_t)(i << 1));

            lv_obj_t *ml = lv_label_create(minus);

            lv_label_set_text(ml, "-");

            lv_obj_center(ml);

            lv_obj_t *cap = lv_label_create(col);

            lv_label_set_text(cap, CAP[i]);

            lv_obj_set_style_text_color(cap, lv_color_hex(0xB8BEE6), 0);

        }

        make_action_button(content, "Set clock", ck_set_cb, 0x216ad8);

        g_ckMsg = make_status(content);

        lv_timer_create(ck_timer_cb, 1000, nullptr);

    }

    // the fields start from the time the node has now

    time_t now = time(nullptr);

    struct tm t;

    if (getRTCQuality() == RTCQualityNone) {

        t = {};

        t.tm_year = 2026 - 1900;

        t.tm_mon = 0;

        t.tm_mday = 1;

        t.tm_hour = 12;

    } else {

        localtime_r(&now, &t);

    }

    g_ck[0] = t.tm_year + 1900;

    g_ck[1] = t.tm_mon + 1;

    g_ck[2] = t.tm_mday;

    g_ck[3] = t.tm_hour;

    g_ck[4] = t.tm_min;

    ck_show_fields();

    if (g_netCfg) {

        meshtastic_Config_NetworkConfig *nc = (meshtastic_Config_NetworkConfig *)g_netCfg();

        lv_textarea_set_text(g_ckNtp, nc && nc->ntp_server[0] ? nc->ntp_server : "meshtastic.pool.ntp.org");

    }

    ck_msg("");

    ck_refresh();

    open_panel(g_ckPanel);

}



// screensaver settings

extern "C" int emoji_ss_cfg_get(int key) __attribute__((weak));

extern "C" void emoji_ss_cfg_set(int key, int val) __attribute__((weak));

extern "C" void emoji_led_set_pin(int pin) __attribute__((weak));

#ifdef HAS_SDCARD

extern SdFs SDFs;

#endif

extern "C" bool emoji_sd_ready(void) __attribute__((weak));

extern "C" void emoji_ss_img_get(char *out, size_t size) __attribute__((weak));

extern "C" void emoji_ss_img_set(const char *path) __attribute__((weak));

extern "C" void emoji_ss_preview(void) __attribute__((weak));



// image picker: the JPEG files in the /screensaver folder of the SD card

static bool img_name(const char *nm)

{

    size_t l = strlen(nm);

    if (l > 4 && strcasecmp(nm + l - 4, ".jpg") == 0)

        return true;

    return l > 5 && strcasecmp(nm + l - 5, ".jpeg") == 0;

}



static lv_obj_t *g_pickPanel = nullptr, *g_pickList = nullptr, *g_ssImgBtn = nullptr;

static char g_pickNames[60][44];

static int g_pickCount = 0;

static void pick_back_cb(lv_event_t *e)

{

    close_panel(g_pickPanel);

}

static lv_obj_t *g_ssSlidePtr = nullptr;

static void ss_img_label(const char *name)

{

    if (!g_ssImgBtn)

        return;

    char label[100];

    snprintf(label, sizeof(label), "Image: %s", name[0] ? name : "first one in /screensaver");

    lv_label_set_text(lv_obj_get_child(g_ssImgBtn, 0), label);

}

static void pick_entry_cb(lv_event_t *e)

{

    int idx = (int)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    if (idx < 0 || idx >= g_pickCount)

        return;

    if (emoji_ss_img_set)

        emoji_ss_img_set(g_pickNames[idx]);

    // picking one picture means one picture, the slideshow is only ever the whole folder

    if (emoji_ss_cfg_set)

        emoji_ss_cfg_set(16, 0);

    if (g_ssSlidePtr)

        lv_dropdown_set_selected(g_ssSlidePtr, 0);

    ss_img_label(g_pickNames[idx]);

    close_panel(g_pickPanel);

}

static void pick_fill(void)

{

    lv_obj_clean(g_pickList);

    g_pickCount = 0;

    lv_obj_t *h = lv_label_create(g_pickList);

    lv_label_set_long_mode(h, LV_LABEL_LONG_WRAP);

    lv_obj_set_width(h, lv_pct(100));

    lv_obj_set_style_text_color(h, lv_color_hex(0xB8BEE6), 0);

    lv_label_set_text(h, "JPEG files in the /screensaver folder of the SD card, 320 x 480 pixels");

#ifdef HAS_SDCARD

    if (!emoji_sd_ready || !emoji_sd_ready()) {

        lv_obj_t *m = lv_label_create(g_pickList);

        lv_label_set_text(m, "No SD card found. Insert one and restart.");

        lv_obj_set_style_text_color(m, lv_color_hex(0xF2A0A0), 0);

        return;

    }

    ISpiLock::Guard bus; // the SD card shares its SPI bus with the screen and the radio, take the host's lock like the display library does

    if (!SDFs.exists("/screensaver"))

        SDFs.mkdir("/screensaver");

    FsFile d = SDFs.open("/screensaver");

    if (!d || !d.isDir()) {

        lv_obj_t *m = lv_label_create(g_pickList);

        lv_label_set_text(m, "Cannot open /screensaver");

        return;

    }

    FsFile e;

    while (g_pickCount < 60 && e.openNext(&d, O_RDONLY)) {

        char nm[44];

        e.getName(nm, sizeof(nm));

        bool dir = e.isDir();

        e.close();

        if (dir || nm[0] == '.' || !img_name(nm))

            continue;

        snprintf(g_pickNames[g_pickCount], sizeof(g_pickNames[0]), "%s", nm);

        char label[60];

        snprintf(label, sizeof(label), LV_SYMBOL_IMAGE " %s", nm);

        lv_obj_t *b = make_action_button(g_pickList, label, pick_entry_cb);

        lv_obj_set_user_data(b, (void *)(uintptr_t)g_pickCount);

        g_pickCount++;

    }

    d.close();

    if (g_pickCount == 0) {

        lv_obj_t *m = lv_label_create(g_pickList);

        lv_label_set_text(m, "No pictures yet. Copy baseline JPEG files into /screensaver on the SD card.");

    }

#else

    lv_obj_t *m = lv_label_create(g_pickList);

    lv_label_set_text(m, "This build has no SD card support.");

#endif

}

static void pick_open_cb(lv_event_t *e)

{

    if (!g_pickPanel) {

        lv_obj_t *content;

        g_pickPanel = make_panel("Choose image", pick_back_cb, &content);

        g_pickList = content;

    }

    pick_fill();

    open_panel(g_pickPanel);

}

static void preview_cb(lv_event_t *e)

{

    if (emoji_ss_preview)

        emoji_ss_preview();

}

static lv_obj_t *g_ssPanel = nullptr, *g_ssStatus, *g_ssSw[12], *g_ssDim, *g_ssOff, *g_ssTap, *g_ssLook, *g_ssClock, *g_ssSecs, *g_ssSlide,

                *g_ssSlideT;

static void ss_back_cb(lv_event_t *e)

{

    close_panel(g_ssPanel);

}

static void ss_save_cb(lv_event_t *e)

{

    if (!emoji_ss_cfg_set)

        return;

    for (int k = 0; k < 12; k++)

        if (g_ssSw[k])

            emoji_ss_cfg_set(k, lv_obj_has_state(g_ssSw[k], LV_STATE_CHECKED) ? 1 : 0);

    emoji_ss_cfg_set(1, lv_dropdown_get_selected(g_ssDim));

    emoji_ss_cfg_set(2, lv_dropdown_get_selected(g_ssOff));

    emoji_ss_cfg_set(3, lv_dropdown_get_selected(g_ssTap) == 0 ? 1 : 2); // 1 single tap, 2 long press

    emoji_ss_cfg_set(13, lv_dropdown_get_selected(g_ssLook));

    emoji_ss_cfg_set(14, lv_dropdown_get_selected(g_ssClock));

    emoji_ss_cfg_set(15, lv_obj_has_state(g_ssSecs, LV_STATE_CHECKED) ? 1 : 0);

    emoji_ss_cfg_set(16, lv_dropdown_get_selected(g_ssSlide));

    emoji_ss_cfg_set(17, lv_dropdown_get_selected(g_ssSlideT));

    lv_label_set_text(g_ssStatus, "Saved");

}

static void ss_open_cb(lv_event_t *e)

{

    if (!emoji_ss_cfg_get)

        return;

    crumb("ss_open start");

    if (!g_ssPanel) {

        lv_obj_t *content;

        g_ssPanel = make_panel("Screensaver", ss_back_cb, &content);

        static const char *const names[12] = {"Screensaver on", "", "", "", "Battery", "Nodes online", "Unread badge", "Last message (privacy)",

                                              "GPS (sats, fix)", "Channel use bar", "MQTT / Wi-Fi status", "Uptime"};

        make_section_header(content, "GENERAL");

        g_ssSw[0] = make_switch_row(content, names[0]);

        g_ssLook = make_dropdown(content, "Style", "Clock page\nImage and clock\nImage only\nStickman arena (plugged in)");

        g_ssTap = make_dropdown(content, "Unlock", "Single tap\nLong press (0.8 s)");

        lv_obj_t *prev = make_action_button(content, "Preview screensaver", preview_cb);



        make_section_header(content, "DIMMING & TIMEOUT");

        g_ssDim = make_dropdown(content, "Dim brightness", "10%\n25%\n50%");

        g_ssOff = make_dropdown(content, "Turn off backlight after", "5 seconds\n10 seconds\n30 seconds\n1 minute\n2 minutes\nNever");



        make_section_header(content, "CLOCK DISPLAY");

        g_ssClock = make_dropdown(content, "Clock style", "Digital\nAnalog\nAnalog and digital");

        g_ssSecs = make_switch_row(content, "Seconds hand");



        make_section_header(content, "WALLPAPER & SLIDESHOW");

        g_ssImgBtn = make_action_button(content, "Image: first one in /screensaver", pick_open_cb);

        g_ssSlide = make_dropdown(content, "Image selection", "Selected image only\nSlideshow of all pictures in /screensaver");

        g_ssSlidePtr = g_ssSlide;

        g_ssSlideT = make_dropdown(content, "Slideshow interval", "5 seconds\n10 seconds\n30 seconds\n1 minute");



        make_section_header(content, "STATUS OVERLAYS");

        for (int k = 4; k < 12; k++)

            g_ssSw[k] = make_switch_row(content, names[k]);

        g_ssStatus = make_status(content);

        make_save_cancel(content, ss_save_cb, ss_back_cb);

        lv_obj_t *pad = lv_obj_create(content);

        lv_obj_remove_style_all(pad);

        lv_obj_set_size(pad, 10, 150);

    }

    crumb("ss_open panel built");

    for (int k = 0; k < 12; k++)

        if (g_ssSw[k])

            set_switch(g_ssSw[k], emoji_ss_cfg_get(k) != 0);

    lv_dropdown_set_selected(g_ssDim, emoji_ss_cfg_get(1));

    lv_dropdown_set_selected(g_ssOff, emoji_ss_cfg_get(2));

    lv_dropdown_set_selected(g_ssTap, emoji_ss_cfg_get(3) == 2 ? 1 : 0);

    lv_dropdown_set_selected(g_ssLook, emoji_ss_cfg_get(13));

    if (emoji_ss_img_get) {

        char cur[96];

        emoji_ss_img_get(cur, sizeof(cur));

        ss_img_label(cur);

    }

    lv_dropdown_set_selected(g_ssSlide, emoji_ss_cfg_get(16));

    lv_dropdown_set_selected(g_ssSlideT, emoji_ss_cfg_get(17));

    lv_dropdown_set_selected(g_ssClock, emoji_ss_cfg_get(14));

    set_switch(g_ssSecs, emoji_ss_cfg_get(15) != 0);

    crumb("ss_open fields filled");

    lv_label_set_text(g_ssStatus, "The dim time is the normal screen timeout in Settings");

    open_panel(g_ssPanel);

    crumb("ss_open done");

}



// RTTTL ringtone: presets, a small player for the test button

// RTTTL ringtone presets

static const char *const RING_NAME[17] = {"Beep", "Alert", "Chime", "Siren", "Knock", "Ping", "Doorbell", "SOS", "Rising", "Falling", "Arpeggio", "Cuckoo", "Ode to Joy", "Twinkle", "Fur Elise", "Jingle Bells", "Custom"};

static const char *const RING_TUNE[16] = {

    "beep:d=16,o=6,b=200:c,e,g,c7",

    "alert:d=8,o=6,b=180:a,p,a,p,a",

    "chime:d=8,o=6,b=140:e,c,g5,2c",

    "siren:d=8,o=5,b=160:a,d6,a,d6,a,d6",

    "knock:d=16,o=5,b=200:8c,p,8c,p,4c",

    "ping:d=16,o=7,b=240:e,8p,e6",

    "bell:d=4,o=6,b=120:e,2c",

    "sos:d=16,o=6,b=200:c,p,c,p,c,8p,8c,p,8c,p,8c,8p,c,p,c,p,c",

    "rise:d=16,o=5,b=200:c,d,e,f,g,a,b,c6",

    "fall:d=16,o=6,b=200:c,b5,a5,g5,f5,e5,d5,c5",

    "arp:d=16,o=5,b=180:c,e,g,c6,g,e,c",

    "cuckoo:d=4,o=6,b=100:g,e",

    "joy:d=4,o=5,b=140:e,e,f,g,g,f,e,d,c,c,d,e,8e.,16d,2d",

    "twinkle:d=4,o=5,b=120:c,c,g,g,a,a,2g,f,f,e,e,d,d,2c",

    "elise:d=16,o=6,b=125:e,d#,e,d#,e,b5,d,c,8a5",

    "jingle:d=8,o=5,b=180:e,e,4e,e,e,4e,e,g,c.,16d,2e"};



static void tone_pin(int pin, float freq, uint32_t ms)

{

    if (freq < 50.0f) {

        delay(ms);

        return;

    }

    uint32_t halfUs = (uint32_t)(500000.0f / freq);

    uint32_t cycles = (uint32_t)((float)ms * 1000.0f / (2.0f * (float)halfUs));

    for (uint32_t i = 0; i < cycles; i++) {

        digitalWrite(pin, HIGH);

        delayMicroseconds(halfUs);

        digitalWrite(pin, LOW);

        delayMicroseconds(halfUs);

    }

}



static void rtttl_play(const char *s, int pin)

{

    int d = 4, o = 6, b = 63;

    const char *p = strchr(s, ':');

    if (!p)

        return;

    p++;

    while (*p && *p != ':') {

        char k = *p++;

        if (*p == '=')

            p++;

        int v = 0;

        while (*p >= '0' && *p <= '9')

            v = v * 10 + (*p++ - '0');

        if (k == 'd')

            d = v;

        else if (k == 'o')

            o = v;

        else if (k == 'b')

            b = v;

        if (*p == ',')

            p++;

    }

    if (*p == ':')

        p++;

    if (b <= 0 || d <= 0)

        return;

    uint32_t whole = 240000 / (uint32_t)b;

    for (int count = 0; *p && count < 60; count++) {

        int dur = 0;

        while (*p >= '0' && *p <= '9')

            dur = dur * 10 + (*p++ - '0');

        if (dur == 0)

            dur = d;

        int note = -1;

        switch (*p) {

        case 'c': note = 0; break;

        case 'd': note = 2; break;

        case 'e': note = 4; break;

        case 'f': note = 5; break;

        case 'g': note = 7; break;

        case 'a': note = 9; break;

        case 'b': note = 11; break;

        default: break; // p is a pause

        }

        if (*p)

            p++;

        if (*p == '#') {

            note++;

            p++;

        }

        bool dotted = false;

        if (*p == '.') {

            dotted = true;

            p++;

        }

        int oct = o;

        if (*p >= '0' && *p <= '9')

            oct = *p++ - '0';

        if (*p == '.') {

            dotted = true;

            p++;

        }

        uint32_t ms = whole / (uint32_t)dur;

        if (dotted)

            ms += ms / 2;

        if (note >= 0) {

            float freq = 440.0f * powf(2.0f, (float)((oct + 1) * 12 + note - 69) / 12.0f);

            tone_pin(pin, freq, ms * 9 / 10);

            delay(ms / 10);

        } else {

            delay(ms);

        }

        while (*p && *p != ',')

            p++;

        if (*p == ',')

            p++;

    }

}



// notification output on one GPIO: LED or buzzer, written to the External Notification config

static CfgFn g_extCfg = nullptr;

static VoidFn g_sendExt = nullptr;

typedef void (*RingFn)(const char *);

static RingFn g_sendRing = nullptr;

static lv_obj_t *g_ntRingDd = nullptr, *g_ntRingTa = nullptr;

static int g_extPin = 48;



// welcome sound: a ringtone at boot, played from its own task so the screen does not wait for it

#define RING_COUNT ((int)(sizeof(RING_TUNE) / sizeof(RING_TUNE[0])))

static char g_welTune[232];

#if defined(ARCH_ESP32) || defined(ARDUINO_ARCH_ESP32) || defined(ESP32)

static void welcome_task(void *arg)

{

    pinMode(g_extPin, OUTPUT);

    rtttl_play(g_welTune, g_extPin);

    digitalWrite(g_extPin, LOW);

    vTaskDelete(NULL);

}

#else

#include <thread>

static void welcome_task()

{

    pinMode(g_extPin, OUTPUT);

    rtttl_play(g_welTune, g_extPin);

    digitalWrite(g_extPin, LOW);

}

#endif

static void welcome_start(void)

{

    Preferences wp;

    wp.begin("chatui", true);

    int idx = wp.getInt("welidx", 0);

    bool buz = wp.getBool("welbuz", false);

    String txt = wp.getString("weltxt", "");

    wp.end();

    if (idx <= 0 || !buz)

        return;

    snprintf(g_welTune, sizeof(g_welTune), "%s", idx <= RING_COUNT ? RING_TUNE[idx - 1] : txt.c_str());

#if defined(ARCH_ESP32) || defined(ARDUINO_ARCH_ESP32) || defined(ESP32)

    xTaskCreate(welcome_task, "welcome", 4096, NULL, 1, NULL);

#else

    std::thread(welcome_task).detach();

#endif

}

static lv_obj_t *g_ntWelDd = nullptr;

static lv_obj_t *g_ntPanel = nullptr, *g_ntStatus, *g_ntMode, *g_ntMsg, *g_ntBell, *g_ntLed, *g_ntPinTa = nullptr;

static void nt_back_cb(lv_event_t *e)

{

    close_panel(g_ntPanel);

}

static void nt_ring_cb(lv_event_t *e)

{

    uint32_t sel = lv_dropdown_get_selected(g_ntRingDd);

    if (sel < 16)

        lv_textarea_set_text(g_ntRingTa, RING_TUNE[sel]);

}

static void nt_save_cb(lv_event_t *e)

{

    if (g_ntPinTa) {

        const char *pStr = lv_textarea_get_text(g_ntPinTa);

        if (pStr && pStr[0]) {

            int p = atoi(pStr);

            if (p >= 0 && p <= 255) {

                g_extPin = p;

                Preferences rp;

                rp.begin("chatui", false);

                rp.putInt("extpin", g_extPin);

                rp.end();

                if (emoji_led_set_pin)

                    emoji_led_set_pin(g_extPin);

            }

        }

    }

    meshtastic_ModuleConfig_ExternalNotificationConfig *c = (meshtastic_ModuleConfig_ExternalNotificationConfig *)g_extCfg();

    uint32_t mode = lv_dropdown_get_selected(g_ntMode);

    bool msg = lv_obj_has_state(g_ntMsg, LV_STATE_CHECKED), bell = lv_obj_has_state(g_ntBell, LV_STATE_CHECKED);

    if (mode == 0) {

        if (c->output == (uint32_t)g_extPin)

            c->output = 0;

        if (c->output_buzzer == (uint32_t)g_extPin)

            c->output_buzzer = 0;

        c->enabled = (c->output || c->output_buzzer || c->output_vibra);

    } else if (mode == 1 && lv_dropdown_get_selected(g_ntLed) > 0) {

        // the display firmware drives the LED itself, the module leaves the pin alone

        if (c->output == (uint32_t)g_extPin)

            c->output = 0;

        if (c->output_buzzer == (uint32_t)g_extPin)

            c->output_buzzer = 0;

        c->enabled = (c->output || c->output_buzzer || c->output_vibra);

    } else if (mode == 1) {

        c->output = g_extPin;

        if (c->output_buzzer == (uint32_t)g_extPin)

            c->output_buzzer = 0;

        c->use_pwm = false;

        c->active = true;

        c->enabled = true;

        c->alert_message = msg;

        c->alert_bell = bell;

        c->alert_message_buzzer = false;

        c->alert_bell_buzzer = false;

        if (c->output_ms == 0)

            c->output_ms = 1000;

    } else {

        c->output_buzzer = g_extPin;

        if (c->output == (uint32_t)g_extPin)

            c->output = 0;

        c->use_pwm = true;

        c->enabled = true;

        c->alert_message_buzzer = msg;

        c->alert_bell_buzzer = bell;

        c->alert_message = false;

        c->alert_bell = false;

        if (c->output_ms == 0)

            c->output_ms = 1000;

    }

    if (emoji_ss_cfg_set)

        emoji_ss_cfg_set(12, (mode == 1) ? (int)lv_dropdown_get_selected(g_ntLed) : 0);

    {

        Preferences wp;

        wp.begin("chatui", false);

        uint32_t wsel = lv_dropdown_get_selected(g_ntWelDd);

        wp.putInt("welidx", (int)wsel);

        wp.putBool("welbuz", mode == 2);

        if ((int)wsel > RING_COUNT)

            wp.putString("weltxt", lv_textarea_get_text(g_ntRingTa));

        wp.end();

    }

    g_sendExt();

    if (mode == 2 && g_sendRing && lv_textarea_get_text(g_ntRingTa)[0]) {

        g_sendRing(lv_textarea_get_text(g_ntRingTa));

        Preferences rp;

        rp.begin("chatui", false);

        rp.putString("ring", lv_textarea_get_text(g_ntRingTa));

        rp.end();

    }

    lv_label_set_text(g_ntStatus, "Saved, the node restarts to apply it");

}

static void nt_test_cb(lv_event_t *e)

{

    uint32_t mode = lv_dropdown_get_selected(g_ntMode);

    if (mode == 0 || (mode == 1 && lv_dropdown_get_selected(g_ntLed) > 0))

        return; // the status LED modes need no test

    pinMode(g_extPin, OUTPUT);

    if (mode == 1) {

        digitalWrite(g_extPin, HIGH);

        delay(400);

        digitalWrite(g_extPin, LOW);

    } else {

        rtttl_play(lv_textarea_get_text(g_ntRingTa), g_extPin);

        digitalWrite(g_extPin, LOW);

    }

}

// ---- ringtone files on the SD card (/rtttl) and the composer ----

static int g_rtTarget = 0; // 0 the Ringtone field, 1 the composer

static lv_obj_t *g_rtPickPanel = nullptr, *g_rtPickList = nullptr;

static char g_rtNames[40][44];

static int g_rtCount = 0;

static void rt_status(const char *t);



static bool rt_name_ok(const char *nm)

{

    size_t l = strlen(nm);

    return (l > 4 && strcasecmp(nm + l - 4, ".txt") == 0) || (l > 6 && strcasecmp(nm + l - 6, ".rtttl") == 0);

}

// the tune title (text before the first colon) as a safe file name

static void rt_title(const char *text, char *out, size_t n)

{

    size_t o = 0;

    for (const char *p = text; *p && *p != ':' && o + 1 < n && o < 20; p++)

        if ((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || *p == '_' || *p == '-')

            out[o++] = *p;

    out[o] = 0;

    if (o == 0)

        snprintf(out, n, "tune");

}

#ifdef HAS_SDCARD

static bool rt_sd_ok(void)

{

    return emoji_sd_ready && emoji_sd_ready();

}

static bool rt_save_file(const char *text, char *nameOut, size_t n)

{

    if (!rt_sd_ok())

        return false;

    ISpiLock::Guard bus; // the SD card shares its SPI bus with the screen and the radio, take the host's lock like the display library does

    if (!SDFs.exists("/rtttl"))

        SDFs.mkdir("/rtttl");

    char t[24], path[64];

    rt_title(text, t, sizeof(t));

    snprintf(path, sizeof(path), "/rtttl/%s.txt", t);

    FsFile f = SDFs.open(path, O_WRONLY | O_CREAT | O_TRUNC);

    if (!f)

        return false;

    size_t len = strlen(text);

    bool ok = f.write((const uint8_t *)text, len) == len;

    f.close();

    snprintf(nameOut, n, "%s.txt", t);

    return ok;

}

static bool rt_read_file(const char *name, char *out, size_t n)

{

    if (!rt_sd_ok())

        return false;

    ISpiLock::Guard bus; // the SD card shares its SPI bus with the screen and the radio, take the host's lock like the display library does

    char path[64];

    snprintf(path, sizeof(path), "/rtttl/%s", name);

    FsFile f = SDFs.open(path, O_RDONLY);

    if (!f)

        return false;

    int got = f.read((uint8_t *)out, n - 1);

    f.close();

    if (got <= 0)

        return false;

    out[got] = 0;

    for (char *c = out; *c; c++)

        if (*c == '\r' || *c == '\n') { // one tune per file, the first line

            *c = 0;

            break;

        }

    return out[0] != 0;

}

#endif



// ---- composer state ----

struct CpNote {

    int8_t semi; // 0..11, -1 for a rest

    uint8_t dur;

    uint8_t oct;

    bool dot;

};

static CpNote g_cpN[60];

static int g_cpCount = 0;

static int g_cpDur = 8, g_cpOct = 5, g_cpBpm = 140;

static bool g_cpDot = false, g_cpBusy = false;

static char g_cpName[16] = "tune";

static lv_obj_t *g_cpPanel = nullptr, *g_cpNameTa = nullptr, *g_cpTextTa = nullptr, *g_cpInfo = nullptr, *g_cpStatus = nullptr;

static lv_obj_t *g_cpDurBtn[6], *g_cpDotBtn = nullptr, *g_cpOctBtn = nullptr, *g_cpBpmBtn = nullptr;

static lv_obj_t *g_cpSeq = nullptr, *g_cpChip[60];

static int g_cpSel = -1;

static void cp_seq_rebuild(void);

static const int CP_DUR[6] = {1, 2, 4, 8, 16, 32};

static const char *const CP_NOTE[12] = {"c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"};



static void cp_build(char *out, size_t n)

{

    int o = snprintf(out, n, "%s:d=4,o=5,b=%d:", g_cpName, g_cpBpm);

    for (int i = 0; i < g_cpCount && o + 12 < (int)n; i++) {

        const CpNote &c = g_cpN[i];

        if (i)

            out[o++] = ',';

        if (c.dur != 4)

            o += snprintf(out + o, n - o, "%d", c.dur);

        if (c.semi < 0)

            out[o++] = 'p';

        else

            o += snprintf(out + o, n - o, "%s", CP_NOTE[c.semi]);

        if (c.dot)

            out[o++] = '.';

        if (c.semi >= 0 && c.oct != 5)

            o += snprintf(out + o, n - o, "%d", c.oct);

    }

    out[o] = 0;

}

static void cp_labels(void)

{

    for (int i = 0; i < 6; i++)

        lv_obj_set_style_bg_color(g_cpDurBtn[i], lv_color_hex(CP_DUR[i] == g_cpDur ? 0x2F7D4F : COL_BTN), 0);

    lv_obj_set_style_bg_color(g_cpDotBtn, lv_color_hex(g_cpDot ? 0x2F7D4F : COL_BTN), 0);

    char b[24];

    snprintf(b, sizeof(b), "oct %d", g_cpOct);

    lv_label_set_text(lv_obj_get_child(g_cpOctBtn, 0), b);

    snprintf(b, sizeof(b), "%d +", g_cpBpm);

    lv_label_set_text(lv_obj_get_child(g_cpBpmBtn, 0), b);

}

static void cp_refresh(void)

{

    char t[300];

    cp_build(t, sizeof(t));

    g_cpBusy = true;

    lv_textarea_set_text(g_cpTextTa, t);

    g_cpBusy = false;

    char b[64];

    snprintf(b, sizeof(b), "%d notes, %d / 230 characters", g_cpCount, (int)strlen(t));

    lv_label_set_text(g_cpInfo, b);

    lv_obj_set_style_text_color(g_cpInfo, lv_color_hex(strlen(t) > 230 ? 0xF2A0A0 : 0xB8BEE6), 0);

    cp_labels();

    cp_seq_rebuild();

}

// read an RTTTL line back into the composer

static bool cp_parse(const char *s)

{

    const char *p = strchr(s, ':');

    if (!p)

        return false;

    size_t nl = (size_t)(p - s);

    int d = 4, o = 5, b = 140;

    char name[16];

    size_t k = 0;

    for (size_t i = 0; i < nl && k + 1 < sizeof(name); i++)

        if (s[i] != ' ')

            name[k++] = s[i];

    name[k] = 0;

    p++;

    while (*p && *p != ':') {

        char key = *p++;

        if (*p == '=')

            p++;

        int v = 0;

        while (*p >= '0' && *p <= '9')

            v = v * 10 + (*p++ - '0');

        if (key == 'd')

            d = v;

        else if (key == 'o')

            o = v;

        else if (key == 'b')

            b = v;

        if (*p == ',')

            p++;

    }

    if (*p == ':')

        p++;

    CpNote tmp[60];

    int n = 0;

    while (*p && n < 60) {

        while (*p == ' ' || *p == ',')

            p++;

        if (!*p)

            break;

        int dur = 0;

        while (*p >= '0' && *p <= '9')

            dur = dur * 10 + (*p++ - '0');

        if (dur == 0)

            dur = d;

        int semi = -2;

        switch (*p) {

        case 'c': case 'C': semi = 0; break;

        case 'd': case 'D': semi = 2; break;

        case 'e': case 'E': semi = 4; break;

        case 'f': case 'F': semi = 5; break;

        case 'g': case 'G': semi = 7; break;

        case 'a': case 'A': semi = 9; break;

        case 'b': case 'B': semi = 11; break;

        case 'p': case 'P': semi = -1; break;

        default: break;

        }

        if (semi == -2) { // not a note, skip to the next comma

            while (*p && *p != ',')

                p++;

            continue;

        }

        p++;

        if (*p == '#' && semi >= 0) {

            semi++;

            p++;

        }

        bool dot = false;

        if (*p == '.') {

            dot = true;

            p++;

        }

        int oct = o;

        if (*p >= '0' && *p <= '9')

            oct = *p++ - '0';

        if (*p == '.') {

            dot = true;

            p++;

        }

        if (oct < 3)

            oct = 3;

        if (oct > 7)

            oct = 7;

        tmp[n].semi = (int8_t)(semi > 11 ? 11 : semi);

        tmp[n].dur = (uint8_t)(dur < 1 ? 4 : (dur > 32 ? 32 : dur));

        tmp[n].oct = (uint8_t)oct;

        tmp[n].dot = dot;

        n++;

        while (*p && *p != ',')

            p++;

    }

    memcpy(g_cpN, tmp, sizeof(CpNote) * n);

    g_cpCount = n;

    g_cpBpm = b < 40 ? 40 : (b > 300 ? 300 : b);

    snprintf(g_cpName, sizeof(g_cpName), "%s", name[0] ? name : "tune");

    return true;

}

static void cp_say(const char *t)

{

    lv_label_set_text(g_cpStatus, t);

}

static void cp_back_cb(lv_event_t *e)

{

    close_panel(g_cpPanel);

}

static void cp_key_cb(lv_event_t *e)

{

    int semi = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    if (g_cpCount >= 60)

        return;

    g_cpN[g_cpCount].semi = (int8_t)semi;

    g_cpN[g_cpCount].dur = (uint8_t)g_cpDur;

    g_cpN[g_cpCount].oct = (uint8_t)g_cpOct;

    g_cpN[g_cpCount].dot = g_cpDot;

    g_cpCount++;

    if (semi >= 0 && g_extPin >= 0) { // a short preview of the key on the buzzer

        char one[40];

        snprintf(one, sizeof(one), "k:d=%d,o=%d,b=%d:%s%s", g_cpDur, g_cpOct, g_cpBpm < 140 ? 140 : g_cpBpm, CP_NOTE[semi], g_cpDot ? "." : "");

        pinMode(g_extPin, OUTPUT);

        rtttl_play(one, g_extPin);

        digitalWrite(g_extPin, LOW);

    }

    cp_refresh();

}

static void cp_dur_cb(lv_event_t *e)

{

    g_cpDur = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    cp_labels();

}

static void cp_dot_cb(lv_event_t *e)

{

    g_cpDot = !g_cpDot;

    cp_labels();

}

static void cp_oct_cb(lv_event_t *e)

{

    int d = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    g_cpOct += d;

    if (g_cpOct < 4)

        g_cpOct = 4;

    if (g_cpOct > 7)

        g_cpOct = 7;

    cp_labels();

}

static void cp_bpm_cb(lv_event_t *e)

{

    int d = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    g_cpBpm += d;

    if (g_cpBpm < 40)

        g_cpBpm = 40;

    if (g_cpBpm > 300)

        g_cpBpm = 300;

    cp_refresh();

}

static void cp_del_cb(lv_event_t *e)

{

    if (g_cpSel >= 0 && g_cpSel < g_cpCount) { // the selected note, else the last one

        memmove(&g_cpN[g_cpSel], &g_cpN[g_cpSel + 1], sizeof(CpNote) * (g_cpCount - g_cpSel - 1));

        g_cpCount--;

    } else if (g_cpCount > 0)

        g_cpCount--;

    g_cpSel = -1;

    cp_refresh();

}

static void cp_clear_cb(lv_event_t *e)

{

    g_cpCount = 0;

    cp_refresh();

}

static void cp_play_cb(lv_event_t *e)

{

    if (g_extPin < 0 || g_cpCount == 0)

        return;

    char t[300];

    cp_build(t, sizeof(t));

    pinMode(g_extPin, OUTPUT);

    rtttl_play(t, g_extPin);

    digitalWrite(g_extPin, LOW);

}

static void cp_name_cb(lv_event_t *e)

{

    if (g_cpBusy)

        return;

    char t[24];

    rt_title(lv_textarea_get_text(g_cpNameTa), t, sizeof(t));

    snprintf(g_cpName, sizeof(g_cpName), "%.12s", t);

    char txt[300];

    cp_build(txt, sizeof(txt));

    g_cpBusy = true;

    lv_textarea_set_text(g_cpTextTa, txt);

    g_cpBusy = false;

}

static void cp_text_cb(lv_event_t *e)

{

    if (g_cpBusy)

        return;

    if (cp_parse(lv_textarea_get_text(g_cpTextTa))) {

        char b[64];

        snprintf(b, sizeof(b), "%d notes", g_cpCount);

        lv_label_set_text(g_cpInfo, b);

        cp_labels();

    }

}

static void cp_save_cb(lv_event_t *e)

{

    char t[300], nm[40], msg[80];

    cp_build(t, sizeof(t));

    if (g_cpCount == 0) {

        cp_say("Nothing to save yet");

        return;

    }

    if (strlen(t) > 230) {

        cp_say("Too long, 230 characters at most");

        return;

    }

#ifdef HAS_SDCARD

    if (!rt_sd_ok()) {

        cp_say("No SD card found");

        return;

    }

    if (rt_save_file(t, nm, sizeof(nm))) {

        snprintf(msg, sizeof(msg), "Saved /rtttl/%s", nm);

        cp_say(msg);

    } else

        cp_say("Could not write the file");

#else

    cp_say("This build has no SD card support");

#endif

}

static void rt_pick_open(int target);

static void cp_load_cb(lv_event_t *e)

{

    rt_pick_open(1);

}

static void cp_use_cb(lv_event_t *e)

{

    char t[300];

    cp_build(t, sizeof(t));

    if (g_cpCount == 0 || strlen(t) > 230) {

        cp_say(g_cpCount == 0 ? "Nothing to use yet" : "Too long, 230 characters at most");

        return;

    }

    lv_textarea_set_text(g_ntRingTa, t);

    rt_status("Tune copied to the Ringtone field, press Save to keep it");

    close_panel(g_cpPanel);

}



static lv_obj_t *rt_row(lv_obj_t *content)

{

    lv_obj_t *r = lv_obj_create(content);

    lv_obj_remove_style_all(r);

    lv_obj_set_size(r, lv_pct(100), LV_SIZE_CONTENT);

    lv_obj_set_flex_flow(r, LV_FLEX_FLOW_ROW_WRAP);

    lv_obj_set_style_pad_column(r, 4, 0);

    lv_obj_set_style_pad_row(r, 4, 0);

    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);

    return r;

}

static lv_obj_t *cp_btn(lv_obj_t *row, const char *text, uint32_t col, lv_event_cb_t cb, intptr_t ud)

{

    lv_obj_t *b = make_label_button(row, text, col, cb);

    lv_obj_set_style_pad_hor(b, 7, 0);

    lv_obj_set_style_pad_ver(b, 7, 0);

    lv_obj_set_user_data(b, (void *)ud);

    return b;

}

// a row whose buttons share the width equally, nothing wraps

static lv_obj_t *cp_eq_row(lv_obj_t *content)

{

    lv_obj_t *r = lv_obj_create(content);

    lv_obj_remove_style_all(r);

    lv_obj_set_size(r, lv_pct(100), LV_SIZE_CONTENT);

    lv_obj_set_flex_flow(r, LV_FLEX_FLOW_ROW);

    lv_obj_set_style_pad_column(r, 4, 0);

    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);

    return r;

}

static lv_obj_t *cp_btn_eq(lv_obj_t *row, const char *text, uint32_t col, lv_event_cb_t cb, intptr_t ud)

{

    lv_obj_t *b = make_label_button(row, text, col, cb);

    lv_obj_set_style_pad_hor(b, 2, 0);

    lv_obj_set_style_pad_ver(b, 9, 0);

    lv_obj_set_width(b, 1);

    lv_obj_set_flex_grow(b, 1);

    lv_obj_set_user_data(b, (void *)ud);

    lv_obj_center(lv_obj_get_child(b, 0));

    return b;

}

static void cp_chip_cb(lv_event_t *e)

{

    int idx = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    g_cpSel = (g_cpSel == idx) ? -1 : idx;

    for (int i = 0; i < g_cpCount; i++)

        lv_obj_set_style_bg_color(g_cpChip[i], lv_color_hex(i == g_cpSel ? 0x4A73D6 : 0x2A3B66), 0);

}

// the notes as chips, tap one to select it for Del

static void cp_seq_rebuild(void)

{

    if (!g_cpSeq)

        return;

    g_cpSel = -1;

    lv_obj_clean(g_cpSeq);

    if (g_cpCount == 0) {

        lv_obj_t *l = lv_label_create(g_cpSeq);

        lv_label_set_text(l, "no notes yet, tap a key");

        lv_obj_set_style_text_color(l, lv_color_hex(0x7F89B5), 0);

        return;

    }

    for (int i = 0; i < g_cpCount; i++) {

        char t[20];

        const CpNote &c = g_cpN[i];

        if (c.semi < 0)

            snprintf(t, sizeof(t), "rest 1/%d%s", c.dur, c.dot ? "." : "");

        else {

            snprintf(t, sizeof(t), "%s%d 1/%d%s", CP_NOTE[c.semi], c.oct, c.dur, c.dot ? "." : "");

            if (t[0] >= 'a' && t[0] <= 'z')

                t[0] -= 32;

        }

        lv_obj_t *b = make_label_button(g_cpSeq, t, 0x2A3B66, cp_chip_cb);

        lv_obj_set_style_pad_hor(b, 6, 0);

        lv_obj_set_style_pad_ver(b, 3, 0);

        lv_obj_set_user_data(b, (void *)(intptr_t)i);

        g_cpChip[i] = b;

    }

    lv_group_t *g = lv_group_get_default();

    if (g)

        panel_group_add(g_cpSeq, g); // the new chips get the focus outline for the joystick

}

// one octave of a piano: white keys side by side, the black keys on top of them

static void cp_piano(lv_obj_t *content)

{

    lv_obj_t *piano = lv_obj_create(content);

    lv_obj_remove_style_all(piano);

    lv_obj_set_size(piano, lv_pct(100), 92);

    lv_obj_remove_flag(piano, LV_OBJ_FLAG_SCROLLABLE);

    lv_obj_update_layout(piano);

    int pw = lv_obj_get_width(piano);

    if (pw < 100)

        pw = lv_display_get_horizontal_resolution(NULL) - 16;

    int kw = pw / 7;

    static const char *const wn[7] = {"C", "D", "E", "F", "G", "A", "B"};

    static const int ws[7] = {0, 2, 4, 5, 7, 9, 11};

    for (int i = 0; i < 7; i++) {

        lv_obj_t *k = lv_button_create(piano);

        lv_obj_set_size(k, kw - 2, 90);

        lv_obj_set_pos(k, i * kw, 0);

        lv_obj_set_style_bg_color(k, lv_color_hex(0xE8EEF9), 0);

        lv_obj_set_style_bg_color(k, lv_color_hex(0x9FD3FF), LV_STATE_PRESSED);

        lv_obj_set_style_bg_opa(k, LV_OPA_COVER, 0);

        lv_obj_set_style_radius(k, 6, 0);

        lv_obj_set_style_pad_all(k, 0, 0);

        lv_obj_set_style_shadow_width(k, 0, 0);

        lv_obj_t *l = lv_label_create(k);

        lv_label_set_text(l, wn[i]);

        lv_obj_set_style_text_color(l, lv_color_hex(0x222222), 0);

        lv_obj_align(l, LV_ALIGN_BOTTOM_MID, 0, -4);

        lv_obj_set_user_data(k, (void *)(intptr_t)ws[i]);

        lv_obj_add_event_cb(k, cp_key_cb, LV_EVENT_CLICKED, nullptr);

    }

    static const char *const bn[5] = {"C#", "D#", "F#", "G#", "A#"};

    static const int bs[5] = {1, 3, 6, 8, 10};

    static const int bpos[5] = {1, 2, 4, 5, 6}; // between white key bpos-1 and bpos

    int bw = kw * 6 / 10;

    for (int i = 0; i < 5; i++) {

        lv_obj_t *k = lv_button_create(piano);

        lv_obj_set_size(k, bw, 56);

        lv_obj_set_pos(k, bpos[i] * kw - bw / 2, 0);

        lv_obj_set_style_bg_color(k, lv_color_hex(0x101830), 0);

        lv_obj_set_style_bg_color(k, lv_color_hex(0x4A73D6), LV_STATE_PRESSED);

        lv_obj_set_style_bg_opa(k, LV_OPA_COVER, 0);

        lv_obj_set_style_border_width(k, 1, 0);

        lv_obj_set_style_border_color(k, lv_color_hex(0x3A4A74), 0);

        lv_obj_set_style_radius(k, 4, 0);

        lv_obj_set_style_pad_all(k, 0, 0);

        lv_obj_set_style_shadow_width(k, 0, 0);

        lv_obj_t *l = lv_label_create(k);

        lv_label_set_text(l, bn[i]);

        lv_obj_set_style_text_color(l, lv_color_hex(0xCFD8F0), 0);

        lv_obj_set_style_text_font(l, &ui_font_montserrat_12, 0);

        lv_obj_align(l, LV_ALIGN_BOTTOM_MID, 0, -3);

        lv_obj_set_user_data(k, (void *)(intptr_t)bs[i]);

        lv_obj_add_event_cb(k, cp_key_cb, LV_EVENT_CLICKED, nullptr);

    }

}

static void cp_open_cb(lv_event_t *e)

{

    if (!g_cpPanel) {

        lv_obj_t *content;

        g_cpPanel = make_panel("Ringtone composer", cp_back_cb, &content);

        // name and tempo

        lv_obj_t *r = cp_eq_row(content);

        g_cpNameTa = lv_textarea_create(r);

        lv_textarea_set_one_line(g_cpNameTa, true);

        lv_textarea_set_max_length(g_cpNameTa, 12);

        lv_textarea_set_placeholder_text(g_cpNameTa, "Name");

        lv_obj_set_width(g_cpNameTa, 1);

        lv_obj_set_flex_grow(g_cpNameTa, 3);

        lv_obj_set_style_bg_color(g_cpNameTa, lv_color_hex(COL_FIELD), 0);

        lv_obj_set_style_text_color(g_cpNameTa, lv_color_hex(0x1F2937), 0);

        lv_obj_add_event_cb(g_cpNameTa, ta_click_cb, LV_EVENT_CLICKED, nullptr);

        lv_obj_add_event_cb(g_cpNameTa, cp_name_cb, LV_EVENT_VALUE_CHANGED, nullptr);

        cp_btn_eq(r, "- bpm", COL_BTN, cp_bpm_cb, -10);

        g_cpBpmBtn = cp_btn_eq(r, "140 +", COL_BTN, cp_bpm_cb, 10);

        // note length

        r = cp_eq_row(content);

        for (int i = 0; i < 6; i++) {

            char l[8];

            snprintf(l, sizeof(l), "1/%d", CP_DUR[i]);

            g_cpDurBtn[i] = cp_btn_eq(r, l, COL_BTN, cp_dur_cb, CP_DUR[i]);

        }

        // dotted, octave, rest

        r = cp_eq_row(content);

        g_cpDotBtn = cp_btn_eq(r, "dotted", COL_BTN, cp_dot_cb, 0);

        cp_btn_eq(r, "oct -", COL_BTN, cp_oct_cb, -1);

        g_cpOctBtn = cp_btn_eq(r, "oct 5", 0x3A4468, cp_oct_cb, 0);

        cp_btn_eq(r, "oct +", COL_BTN, cp_oct_cb, 1);

        cp_btn_eq(r, "rest", COL_BTN, cp_key_cb, -1);

        // the piano

        cp_piano(content);

        // the notes

        g_cpSeq = lv_obj_create(content);

        lv_obj_remove_style_all(g_cpSeq);

        lv_obj_set_size(g_cpSeq, lv_pct(100), 64);

        lv_obj_set_style_bg_color(g_cpSeq, lv_color_hex(0x101830), 0);

        lv_obj_set_style_bg_opa(g_cpSeq, LV_OPA_COVER, 0);

        lv_obj_set_style_radius(g_cpSeq, 8, 0);

        lv_obj_set_style_pad_all(g_cpSeq, 5, 0);

        lv_obj_set_style_pad_column(g_cpSeq, 4, 0);

        lv_obj_set_style_pad_row(g_cpSeq, 4, 0);

        lv_obj_set_flex_flow(g_cpSeq, LV_FLEX_FLOW_ROW_WRAP);

        lv_obj_set_scroll_dir(g_cpSeq, LV_DIR_VER);

        r = cp_eq_row(content);

        cp_btn_eq(r, "Del", 0x8A2F36, cp_del_cb, 0);

        cp_btn_eq(r, "Clear", 0x8A2F36, cp_clear_cb, 0);

        cp_btn_eq(r, "Play", 0x2F7D4F, cp_play_cb, 0);

        // the RTTTL text

        g_cpTextTa = make_field(content, "Ringtone (RTTTL), you can edit it here", 230, false);

        lv_obj_add_event_cb(g_cpTextTa, cp_text_cb, LV_EVENT_VALUE_CHANGED, nullptr);

        g_cpInfo = lv_label_create(content);

        lv_label_set_text(g_cpInfo, "");

        lv_obj_set_style_text_color(g_cpInfo, lv_color_hex(0xB8BEE6), 0);

        r = cp_eq_row(content);

        cp_btn_eq(r, "Save to SD", COL_BTN, cp_save_cb, 0);

        cp_btn_eq(r, "Load from SD", COL_BTN, cp_load_cb, 0);

        cp_btn_eq(r, "Use", 0x2F7D4F, cp_use_cb, 0);

        g_cpStatus = make_status(content);

        lv_obj_t *pad = lv_obj_create(content);

        lv_obj_remove_style_all(pad);

        lv_obj_set_size(pad, 10, 150);

    }

    if (!cp_parse(lv_textarea_get_text(g_ntRingTa))) {

        g_cpCount = 0;

        snprintf(g_cpName, sizeof(g_cpName), "tune");

    }

    g_cpBusy = true;

    lv_textarea_set_text(g_cpNameTa, g_cpName);

    g_cpBusy = false;

    lv_label_set_text(g_cpStatus, "");

    cp_refresh();

    open_panel(g_cpPanel);

}



// ---- list of the files in /rtttl ----

static void rt_pick_back_cb(lv_event_t *e)

{

    close_panel(g_rtPickPanel);

}

static void rt_pick_entry_cb(lv_event_t *e)

{

    int idx = (int)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_target(e));

    if (idx < 0 || idx >= g_rtCount)

        return;

#ifdef HAS_SDCARD

    char t[300];

    if (!rt_read_file(g_rtNames[idx], t, sizeof(t))) {

        if (g_rtTarget == 1)

            cp_say("Could not read that file");

        else

            rt_status("Could not read that file");

        close_panel(g_rtPickPanel);

        return;

    }

    t[230] = 0; // the node takes 230 characters at most

    if (g_rtTarget == 1) {

        if (cp_parse(t)) {

            g_cpBusy = true;

            lv_textarea_set_text(g_cpNameTa, g_cpName);

            g_cpBusy = false;

            cp_refresh();

            cp_say("Loaded");

        } else

            cp_say("That file is not an RTTTL tune");

    } else {

        lv_textarea_set_text(g_ntRingTa, t);

        rt_status("Loaded, press Test output to hear it and Save to keep it");

    }

#endif

    close_panel(g_rtPickPanel);

}

static void rt_pick_fill(void)

{

    lv_obj_clean(g_rtPickList);

    g_rtCount = 0;

    lv_obj_t *h = lv_label_create(g_rtPickList);

    lv_label_set_long_mode(h, LV_LABEL_LONG_WRAP);

    lv_obj_set_width(h, lv_pct(100));

    lv_obj_set_style_text_color(h, lv_color_hex(0xB8BEE6), 0);

    lv_label_set_text(h, "Text files in the /rtttl folder of the SD card, one RTTTL tune on the first line of each");

#ifdef HAS_SDCARD

    if (!rt_sd_ok()) {

        lv_obj_t *m = lv_label_create(g_rtPickList);

        lv_label_set_text(m, "No SD card found. Insert one and restart.");

        lv_obj_set_style_text_color(m, lv_color_hex(0xF2A0A0), 0);

        return;

    }

    ISpiLock::Guard bus; // the SD card shares its SPI bus with the screen and the radio, take the host's lock like the display library does

    if (!SDFs.exists("/rtttl"))

        SDFs.mkdir("/rtttl");

    FsFile d = SDFs.open("/rtttl");

    if (!d || !d.isDir()) {

        lv_obj_t *m = lv_label_create(g_rtPickList);

        lv_label_set_text(m, "Cannot open /rtttl");

        return;

    }

    FsFile f;

    while (g_rtCount < 40 && f.openNext(&d, O_RDONLY)) {

        char nm[44];

        f.getName(nm, sizeof(nm));

        bool dir = f.isDir();

        f.close();

        if (dir || nm[0] == '.' || !rt_name_ok(nm))

            continue;

        snprintf(g_rtNames[g_rtCount], sizeof(g_rtNames[0]), "%s", nm);

        char label[60];

        snprintf(label, sizeof(label), LV_SYMBOL_AUDIO " %s", nm);

        lv_obj_t *b = make_action_button(g_rtPickList, label, rt_pick_entry_cb);

        lv_obj_set_user_data(b, (void *)(uintptr_t)g_rtCount);

        g_rtCount++;

    }

    d.close();

    if (g_rtCount == 0) {

        lv_obj_t *m = lv_label_create(g_rtPickList);

        lv_label_set_text(m, "No tunes yet. Save one from here, or copy .txt files into /rtttl on the SD card.");

    }

#else

    lv_obj_t *m = lv_label_create(g_rtPickList);

    lv_label_set_text(m, "This build has no SD card support.");

#endif

}

static void rt_pick_open(int target)

{

    g_rtTarget = target;

    if (!g_rtPickPanel) {

        lv_obj_t *content;

        g_rtPickPanel = make_panel("Load ringtone", rt_pick_back_cb, &content);

        g_rtPickList = content;

    }

    rt_pick_fill();

    open_panel(g_rtPickPanel);

}

static void rt_load_cb(lv_event_t *e)

{

    rt_pick_open(0);

}

static void rt_status(const char *t)

{

    if (g_ntStatus)

        lv_label_set_text(g_ntStatus, t);

}

static void rt_save_cb(lv_event_t *e)

{

    const char *t = lv_textarea_get_text(g_ntRingTa);

    if (!t[0]) {

        rt_status("Nothing to save, the Ringtone field is empty");

        return;

    }

#ifdef HAS_SDCARD

    char nm[40], msg[80];

    if (!rt_sd_ok()) {

        rt_status("No SD card found");

        return;

    }

    if (rt_save_file(t, nm, sizeof(nm))) {

        snprintf(msg, sizeof(msg), "Saved /rtttl/%s", nm);

        rt_status(msg);

    } else

        rt_status("Could not write the file");

#else

    rt_status("This build has no SD card support");

#endif

}



static void nt_open_cb(lv_event_t *e)

{

    if (!g_ntPanel) {

        lv_obj_t *content;

        g_ntPanel = make_panel("Notification output", nt_back_cb, &content);

        g_ntPinTa = make_field(content, "GPIO output pin", 6, false);

        g_ntMode = make_dropdown(content, "Output mode", "Off\nLED\nBuzzer");

        g_ntLed = make_dropdown(content, "LED behaviour", "Incoming chat\nAlways on\nGPS fix\nUnread messages\nLow battery\nCharging");

        g_ntRingDd = make_dropdown(content, "Buzzer ringtone", "Beep\nAlert\nChime\nSiren\nKnock\nPing\nDoorbell\nSOS\nRising\nFalling\nArpeggio\nCuckoo\nOde to Joy\nTwinkle\nFur Elise\nJingle Bells\nCustom");

        lv_obj_add_event_cb(g_ntRingDd, nt_ring_cb, LV_EVENT_VALUE_CHANGED, nullptr);

        g_ntRingTa = make_field(content, "Ringtone (RTTTL, 230 characters at most)", 230, false);

        {

            lv_obj_t *rr = rt_row(content);

            cp_btn(rr, "Load", COL_BTN, rt_load_cb, 0);

            cp_btn(rr, "Save", COL_BTN, rt_save_cb, 0);

            cp_btn(rr, "Composer", 0x2F7D4F, cp_open_cb, 0);

        }

        {

            Preferences rp;

            rp.begin("chatui", true);

            String saved = rp.getString("ring", RING_TUNE[0]);

            rp.end();

            lv_textarea_set_text(g_ntRingTa, saved.c_str());

        }

        {

            static char welOpts[640];

            snprintf(welOpts, sizeof(welOpts), "Off");

            for (int i = 0; i < RING_COUNT; i++)

                snprintf(welOpts + strlen(welOpts), sizeof(welOpts) - strlen(welOpts), "\n%s", RING_NAME[i]);

            snprintf(welOpts + strlen(welOpts), sizeof(welOpts) - strlen(welOpts), "\nCurrent ringtone text");

            g_ntWelDd = make_dropdown(content, "Welcome sound at boot (buzzer only)", welOpts);

        }

        g_ntMsg = make_switch_row(content, "Alert on new message");

        g_ntBell = make_switch_row(content, "Alert on bell");

        lv_obj_t *test = make_action_button(content, "Test output", nt_test_cb);

        g_ntStatus = make_status(content);

        make_save_cancel(content, nt_save_cb, nt_back_cb);

        lv_obj_t *ntPad = lv_obj_create(content);

        lv_obj_remove_style_all(ntPad);

        lv_obj_set_size(ntPad, 10, 150);

    }

    {

        Preferences rp;

        rp.begin("chatui", true);

        g_extPin = rp.getInt("extpin", g_extPin);

        rp.end();

        char pinStr[16];

        snprintf(pinStr, sizeof(pinStr), "%d", g_extPin);

        lv_textarea_set_text(g_ntPinTa, pinStr);

    }

    meshtastic_ModuleConfig_ExternalNotificationConfig *c = (meshtastic_ModuleConfig_ExternalNotificationConfig *)g_extCfg();

    uint32_t mode = 0;

    int ledMode = emoji_ss_cfg_get ? emoji_ss_cfg_get(12) : 0;

    if (ledMode > 0)

        mode = 1;

    else if (c->enabled && c->output == (uint32_t)g_extPin)

        mode = 1;

    else if (c->enabled && c->output_buzzer == (uint32_t)g_extPin)

        mode = 2;

    lv_dropdown_set_selected(g_ntMode, mode);

    {

        Preferences wp;

        wp.begin("chatui", true);

        lv_dropdown_set_selected(g_ntWelDd, (uint32_t)wp.getInt("welidx", 0));

        wp.end();

    }

    lv_dropdown_set_selected(g_ntLed, ledMode > 0 ? ledMode : 0);

    set_switch(g_ntMsg, c->alert_message || c->alert_message_buzzer);

    set_switch(g_ntBell, c->alert_bell || c->alert_bell_buzzer);

    lv_label_set_text(g_ntStatus, "");

    open_panel(g_ntPanel);

}

extern "C" void emoji_settings_host2(void *(*ext)(void), void (*sendExt)(void), int pin, void (*sendRing)(const char *))

{

    if (pin < 0)

        return; // no LED or buzzer on this board, the panel stays hidden

    g_sendRing = sendRing;

    g_extCfg = ext;

    g_sendExt = sendExt;

    {

        Preferences rp;

        rp.begin("chatui", true);

        g_extPin = rp.getInt("extpin", pin);

        rp.end();

    }

    if (emoji_led_set_pin)

        emoji_led_set_pin(g_extPin);

    welcome_start();

}



// power: battery INA address and an I2C bus scan

static CfgFn g_powCfg = nullptr;

static VoidFn g_sendPow = nullptr;

static lv_obj_t *g_i2cPanel = nullptr, *g_i2cStatus, *g_i2cList, *g_ddIna;

static void i2c_back_cb(lv_event_t *e)

{

    close_panel(g_i2cPanel);

}

static void i2c_scan_cb(lv_event_t *e)

{

#if defined(HAS_WIRE)

    char buf[160];

    int n = 0;

    buf[0] = 0;

    for (uint8_t a = 0x08; a < 0x78 && strlen(buf) < sizeof(buf) - 8; a++) {

        Wire.beginTransmission(a);

        if (Wire.endTransmission() == 0) {

            sprintf(buf + strlen(buf), "%s0x%02X", n ? "  " : "", a);

            n++;

        }

    }

    lv_label_set_text(g_i2cList, n ? buf : "No device answered");

#else

    lv_label_set_text(g_i2cList, "I2C scan not supported on this platform");

#endif

}

static void ina_save_cb(lv_event_t *e)

{

    meshtastic_Config_PowerConfig *c = (meshtastic_Config_PowerConfig *)g_powCfg();

    uint32_t sel = lv_dropdown_get_selected(g_ddIna);

    c->device_battery_ina_address = sel == 0 ? 0 : (sel == 1 ? 0x40 : (sel == 2 ? 0x41 : (sel == 3 ? 0x44 : 0x45)));

    g_sendPow();

    lv_label_set_text(g_i2cStatus, "Saved, the node applies it after a restart");

}

static void i2c_open_cb(lv_event_t *e)

{

    if (!g_i2cPanel) {

        lv_obj_t *content;

        g_i2cPanel = make_panel("Power and I2C", i2c_back_cb, &content);

        g_ddIna = make_dropdown(content, "Battery INA I2C address", "Off\n0x40\n0x41\n0x44\n0x45");

        g_i2cStatus = make_status(content);

        make_save_cancel(content, ina_save_cb, i2c_back_cb);

        lv_obj_t *sc = make_action_button(content, "Scan I2C bus", i2c_scan_cb);

        g_i2cList = make_status(content);

        lv_obj_set_style_text_color(g_i2cList, lv_color_hex(0xFFFFFF), 0);

    }

    meshtastic_Config_PowerConfig *c = (meshtastic_Config_PowerConfig *)g_powCfg();

    uint32_t a = c->device_battery_ina_address;

    lv_dropdown_set_selected(g_ddIna, a == 0x40 ? 1 : (a == 0x41 ? 2 : (a == 0x44 ? 3 : (a == 0x45 ? 4 : 0))));

    lv_label_set_text(g_i2cStatus, "");

    lv_label_set_text(g_i2cList, "");

    open_panel(g_i2cPanel);

}



extern "C" void emoji_settings_host(void *(*lora)(void), void *(*pos)(void), void *(*sec)(void), void *(*pow)(void),

                                    void (*sendLora)(void), void (*sendPos)(void), void (*sendSec)(void), void (*sendPow)(void))

{

    g_loraCfg = lora, g_posCfg = pos, g_secCfg = sec, g_powCfg = pow;

    g_sendLora = sendLora, g_sendPos = sendPos, g_sendSec = sendSec, g_sendPow = sendPow;

}



