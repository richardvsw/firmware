// ---- Channels (Android App Parity: Uplink, Downlink, Position, Mute) ----

typedef void *(*ChanGetFn)(int);

typedef void (*ChanSendFn)(int);

typedef int (*ChanMaxFn)(void);

static ChanGetFn g_chanGet = nullptr;

static ChanSendFn g_chanSend = nullptr;

static ChanMaxFn g_chanMax = nullptr;



extern "C" void emoji_settings_channels(void *(*getChan)(int), void (*sendChan)(int), int (*maxChan)(void))

{

    g_chanGet = getChan;

    g_chanSend = sendChan;

    g_chanMax = maxChan;

}



static lv_obj_t *g_chPanel = nullptr;

static lv_obj_t *g_chDd = nullptr;

static lv_obj_t *g_chNameTa = nullptr;

static lv_obj_t *g_chPskTa = nullptr;

static lv_obj_t *g_chRoleDd = nullptr;

static lv_obj_t *g_chSwUplink = nullptr;

static lv_obj_t *g_chSwDownlink = nullptr;

static lv_obj_t *g_chSwPosition = nullptr;

static lv_obj_t *g_chSwPrecise = nullptr;

static lv_obj_t *g_chSwMute = nullptr;

static lv_obj_t *g_chStatus = nullptr;



static const char b64_table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";



static std::string psk_to_base64(const uint8_t *data, size_t len) {

    if (!data || len == 0) return "";

    std::string out;

    int val = 0, valb = -6;

    for (size_t i = 0; i < len; i++) {

        val = (val << 8) + data[i];

        valb += 8;

        while (valb >= 0) {

            out.push_back(b64_table[(val >> valb) & 0x3F]);

            valb -= 6;

        }

    }

    if (valb > -6) out.push_back(b64_table[((val << 8) >> (valb + 8)) & 0x3F]);

    while (out.size() % 4) out.push_back('=');

    return out;

}



static bool base64_to_psk(const char *in, uint8_t *out, size_t &out_len) {

    if (!in) { out_len = 0; return false; }

    int T[256];

    memset(T, -1, sizeof(T));

    for (int i = 0; i < 64; i++) T[(uint8_t)b64_table[i]] = i;

    int val = 0, valb = -8;

    out_len = 0;

    for (size_t i = 0; in[i]; i++) {

        uint8_t c = (uint8_t)in[i];

        if (c == '=') break;

        if (T[c] == -1) continue;

        val = (val << 6) + T[c];

        valb += 6;

        if (valb >= 0) {

            if (out_len < 32)

                out[out_len++] = (uint8_t)((val >> valb) & 0xFF);

            valb -= 8;

        }

    }

    return true;

}



static void ch_back_cb(lv_event_t *e)

{

    close_panel(g_chPanel);

}



static void update_precise_switch_state(void)

{

    if (!g_chSwPosition || !g_chSwPrecise || !g_chDd) return;

    int idx = (int)lv_dropdown_get_selected(g_chDd);

    const char *name = g_chNameTa ? lv_textarea_get_text(g_chNameTa) : "";

    const char *pskStr = g_chPskTa ? lv_textarea_get_text(g_chPskTa) : "";

    bool isPublic = (idx == 0 || (pskStr && strcmp(pskStr, "AQ==") == 0) ||

                     (name && strcmp(name, "LongFast") == 0) ||

                     (!name || strlen(name) == 0));

    bool posEnabled = lv_obj_has_state(g_chSwPosition, LV_STATE_CHECKED);



    if (!posEnabled) {

        lv_obj_add_state(g_chSwPrecise, LV_STATE_DISABLED);

        lv_obj_remove_state(g_chSwPrecise, LV_STATE_CHECKED);

    } else if (isPublic) {

        lv_obj_add_state(g_chSwPrecise, LV_STATE_DISABLED);

        lv_obj_remove_state(g_chSwPrecise, LV_STATE_CHECKED);

    } else {

        lv_obj_remove_state(g_chSwPrecise, LV_STATE_DISABLED);

    }

}



static void ch_pos_sw_cb(lv_event_t *e)

{

    update_precise_switch_state();

}



static void ch_precise_sw_cb(lv_event_t *e)

{

    int idx = (int)lv_dropdown_get_selected(g_chDd);

    const char *name = g_chNameTa ? lv_textarea_get_text(g_chNameTa) : "";

    const char *pskStr = g_chPskTa ? lv_textarea_get_text(g_chPskTa) : "";

    bool isPublic = (idx == 0 || (pskStr && strcmp(pskStr, "AQ==") == 0) ||

                     (name && strcmp(name, "LongFast") == 0) ||

                     (!name || strlen(name) == 0));

    if (isPublic) {

        lv_obj_remove_state(g_chSwPrecise, LV_STATE_CHECKED);

        lv_obj_add_state(g_chSwPrecise, LV_STATE_DISABLED);

        if (g_chStatus) lv_label_set_text(g_chStatus, "Precise location disabled on public channels");

    }

}



static void ch_gen_psk_cb(lv_event_t *e)

{

    uint8_t rand_bytes[32];

#if defined(ARCH_PORTDUINO)

    FILE *f = fopen("/dev/urandom", "rb");

    if (f) {

        size_t n = fread(rand_bytes, 1, 32, f);

        (void)n;

        fclose(f);

    } else {

        for (int i = 0; i < 32; i++) rand_bytes[i] = (uint8_t)(rand() & 0xFF);

    }

#else

    for (int i = 0; i < 32; i++) rand_bytes[i] = (uint8_t)(rand() & 0xFF);

#endif

    std::string b64 = psk_to_base64(rand_bytes, 32);

    if (g_chPskTa)

        lv_textarea_set_text(g_chPskTa, b64.c_str());

    if (g_chStatus)

        lv_label_set_text(g_chStatus, "Generated new 256-bit AES key");

    update_precise_switch_state();

}



static void ch_default_psk_cb(lv_event_t *e)

{

    if (g_chPskTa)

        lv_textarea_set_text(g_chPskTa, "AQ==");

    if (g_chStatus)

        lv_label_set_text(g_chStatus, "Reset to default public key (AQ==)");

    update_precise_switch_state();

}



static void ch_load_idx(int idx)

{

    if (!g_chanGet) return;

    meshtastic_Channel *ch = (meshtastic_Channel *)g_chanGet(idx);

    if (!ch) return;



    lv_textarea_set_text(g_chNameTa, ch->settings.name);



    std::string b64Psk = psk_to_base64(ch->settings.psk.bytes, ch->settings.psk.size);

    if (g_chPskTa)

        lv_textarea_set_text(g_chPskTa, b64Psk.c_str());



    int roleSel = 0;

    if (ch->role == meshtastic_Channel_Role_PRIMARY) roleSel = 0;

    else if (ch->role == meshtastic_Channel_Role_SECONDARY) roleSel = 1;

    else roleSel = 2; // Disabled

    lv_dropdown_set_selected(g_chRoleDd, roleSel);



    set_switch(g_chSwUplink, ch->settings.uplink_enabled);

    set_switch(g_chSwDownlink, ch->settings.downlink_enabled);



    // Public channel check: primary channel (idx == 0), or key is default AQ== (0x01), or named LongFast / unset

    bool isPublic = (idx == 0 || (ch->settings.psk.size == 1 && ch->settings.psk.bytes[0] == 1) ||

                     strcmp(ch->settings.name, "LongFast") == 0 || strlen(ch->settings.name) == 0);



    bool posEnabled = true;

    bool preciseLoc = false;

    if (ch->settings.has_module_settings) {

        uint32_t prec = ch->settings.module_settings.position_precision;

        if (prec == 1) { // 1 = Disabled

            posEnabled = false;

            preciseLoc = false;

        } else if (prec == 32) { // 32 = Precise

            posEnabled = true;

            preciseLoc = !isPublic;

        } else {

            posEnabled = true;

            preciseLoc = false;

        }

        set_switch(g_chSwMute, ch->settings.module_settings.is_muted);

    } else {

        posEnabled = true;

        preciseLoc = false;

        set_switch(g_chSwMute, false);

    }



    set_switch(g_chSwPosition, posEnabled);

    set_switch(g_chSwPrecise, preciseLoc);

    update_precise_switch_state();

    lv_label_set_text(g_chStatus, "");

}



static void ch_dd_cb(lv_event_t *e)

{

    int sel = (int)lv_dropdown_get_selected(g_chDd);

    ch_load_idx(sel);

}



static void ch_save_cb(lv_event_t *e)

{

    if (!g_chanGet || !g_chanSend) return;

    int idx = (int)lv_dropdown_get_selected(g_chDd);

    meshtastic_Channel *ch = (meshtastic_Channel *)g_chanGet(idx);

    if (!ch) return;



    const char *name = lv_textarea_get_text(g_chNameTa);

    strncpy(ch->settings.name, name ? name : "", sizeof(ch->settings.name) - 1);

    ch->settings.name[sizeof(ch->settings.name) - 1] = 0;



    if (g_chPskTa) {

        const char *pskStr = lv_textarea_get_text(g_chPskTa);

        if (pskStr && strlen(pskStr) > 0) {

            uint8_t rawPsk[32];

            size_t pskLen = 0;

            if (base64_to_psk(pskStr, rawPsk, pskLen)) {

                memcpy(ch->settings.psk.bytes, rawPsk, pskLen);

                ch->settings.psk.size = (uint32_t)pskLen;

            }

        }

    }



    int roleSel = (int)lv_dropdown_get_selected(g_chRoleDd);

    if (roleSel == 0) ch->role = meshtastic_Channel_Role_PRIMARY;

    else if (roleSel == 1) ch->role = meshtastic_Channel_Role_SECONDARY;

    else ch->role = meshtastic_Channel_Role_DISABLED;



    ch->settings.uplink_enabled = lv_obj_has_state(g_chSwUplink, LV_STATE_CHECKED);

    ch->settings.downlink_enabled = lv_obj_has_state(g_chSwDownlink, LV_STATE_CHECKED);



    bool isPublic = (idx == 0 || (ch->settings.psk.size == 1 && ch->settings.psk.bytes[0] == 1) ||

                     strcmp(ch->settings.name, "LongFast") == 0 || strlen(ch->settings.name) == 0);



    ch->settings.has_module_settings = true;

    bool posEnabled = lv_obj_has_state(g_chSwPosition, LV_STATE_CHECKED);

    bool preciseLoc = lv_obj_has_state(g_chSwPrecise, LV_STATE_CHECKED);



    if (!posEnabled) {

        ch->settings.module_settings.position_precision = 1; // 1 = Disabled

    } else if (preciseLoc && !isPublic) {

        ch->settings.module_settings.position_precision = 32; // 32 = Precise 32-bit (~1 mm)

    } else {

        ch->settings.module_settings.position_precision = 0; // 0 = Default (inherited)

    }

    ch->settings.module_settings.is_muted = lv_obj_has_state(g_chSwMute, LV_STATE_CHECKED);



    ch->has_settings = true;

    g_chanSend(idx);

    lv_label_set_text(g_chStatus, "Channel saved & applied!");

}



static void build_ch_panel(void)

{

    lv_obj_t *content;

    g_chPanel = make_panel("Channel Settings", ch_back_cb, &content);



    make_section_header(content, "SELECT CHANNEL");

    g_chDd = make_dropdown(content, "Channel index", "Ch 0 (Primary)\nCh 1\nCh 2\nCh 3\nCh 4\nCh 5\nCh 6\nCh 7");

    lv_obj_add_event_cb(g_chDd, ch_dd_cb, LV_EVENT_VALUE_CHANGED, nullptr);



    make_section_header(content, "CHANNEL CONFIG");

    g_chNameTa = make_field(content, "Channel name", 11, false);

    g_chPskTa = make_field(content, "Pre-shared key (PSK Base64)", 44, false);

    make_action_button(content, "Generate Random Key (AES-256)", ch_gen_psk_cb);

    make_action_button(content, "Reset to Default Public (AQ==)", ch_default_psk_cb);

    g_chRoleDd = make_dropdown(content, "Channel role", "Primary\nSecondary\nDisabled");



    make_section_header(content, "MQTT & ROUTING");

    g_chSwUplink = make_switch_row(content, "MQTT Uplink Enabled");

    g_chSwDownlink = make_switch_row(content, "MQTT Downlink Enabled");



    make_section_header(content, "POSITION & PRIVACY");

    g_chSwPosition = make_switch_row(content, "Position enabled");

    lv_obj_add_event_cb(g_chSwPosition, ch_pos_sw_cb, LV_EVENT_VALUE_CHANGED, nullptr);



    g_chSwPrecise = make_switch_row(content, "Precise location");

    lv_obj_add_event_cb(g_chSwPrecise, ch_precise_sw_cb, LV_EVENT_VALUE_CHANGED, nullptr);



    g_chSwMute = make_switch_row(content, "Mute channel notifications");



    g_chStatus = make_status(content);

    make_save_cancel(content, ch_save_cb, ch_back_cb);



    lv_obj_t *pad = lv_obj_create(content);

    lv_obj_remove_style_all(pad);

    lv_obj_set_size(pad, 10, 150);

}



extern "C" void emoji_channel_open_index(int idx)

{

    if (!g_chPanel)

        build_ch_panel();

    if (idx < 0) idx = 0;

    if (idx > 7) idx = 7;

    lv_dropdown_set_selected(g_chDd, idx);

    ch_load_idx(idx);

    open_panel(g_chPanel);

}



static void ch_open_cb(lv_event_t *e)

{

    emoji_channel_open_index(0);

}





