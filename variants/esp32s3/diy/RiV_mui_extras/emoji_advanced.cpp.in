// "Advanced settings" entry in the settings list. It opens a panel with the chat name setting and an MQTT form, so the node can be set
// up without the phone app.
#include "lvgl.h"
#include "meshtastic/module_config.pb.h"
#include <stdio.h>
#include <string.h>

extern "C" bool emoji_long_names(void);
extern "C" bool emoji_long_names_toggle(void);
extern "C" void add_style_settings_button_style(lv_obj_t *obj);

typedef void *(*MqttCfgFn)(void);
typedef void (*VoidFn)(void);
typedef void (*KbFn)(lv_obj_t *);

static lv_obj_t *g_screen = nullptr;
static lv_obj_t *g_kb = nullptr;
static MqttCfgFn g_mqttCfg = nullptr;
static VoidFn g_sendMqtt = nullptr;
static KbFn g_showKb = nullptr;

static lv_obj_t *g_advPanel = nullptr;
static lv_obj_t *g_namesLabel = nullptr;
static lv_obj_t *g_mqttPanel = nullptr;
static lv_obj_t *g_mqttStatus = nullptr;
static lv_obj_t *g_swEnabled = nullptr, *g_swEnc = nullptr, *g_swTls = nullptr, *g_swProxy = nullptr;
static lv_obj_t *g_taAddress = nullptr, *g_taUser = nullptr, *g_taPass = nullptr, *g_taRoot = nullptr;

static const uint32_t COL_BG = 0x1E2142;
static const uint32_t COL_BAR = 0x2F3566;
static const uint32_t COL_BTN = 0x3A4075;
static const uint32_t COL_FIELD = 0xEEF0F6;

static void hide_kb(void)
{
    if (g_kb)
        lv_obj_add_flag(g_kb, LV_OBJ_FLAG_HIDDEN);
}

static void open_panel(lv_obj_t *p)
{
    lv_obj_remove_flag(p, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(p);
}

static void close_panel(lv_obj_t *p)
{
    hide_kb();
    lv_obj_add_flag(p, LV_OBJ_FLAG_HIDDEN);
}

static lv_obj_t *make_label_button(lv_obj_t *parent, const char *text, uint32_t bg, lv_event_cb_t cb)
{
    lv_obj_t *l = lv_label_create(parent);
    lv_label_set_text(l, text);
    lv_obj_set_style_bg_color(l, lv_color_hex(bg), 0);
    lv_obj_set_style_bg_opa(l, LV_OPA_COVER, 0);
    lv_obj_set_style_text_color(l, lv_color_hex(0xFFFFFF), 0);
    lv_obj_set_style_radius(l, 8, 0);
    lv_obj_set_style_pad_hor(l, 14, 0);
    lv_obj_set_style_pad_ver(l, 9, 0);
    lv_obj_add_flag(l, LV_OBJ_FLAG_CLICKABLE);
    if (cb)
        lv_obj_add_event_cb(l, cb, LV_EVENT_CLICKED, nullptr);
    return l;
}

// full screen panel with a title bar, a back button and a scrolling column for the content
static lv_obj_t *make_panel(const char *title, lv_event_cb_t backCb, lv_obj_t **contentOut)
{
    lv_obj_t *root = lv_obj_create(g_screen);
    lv_obj_remove_style_all(root);
    lv_obj_set_size(root, lv_pct(100), lv_pct(100));
    lv_obj_set_style_bg_color(root, lv_color_hex(COL_BG), 0);
    lv_obj_set_style_bg_opa(root, LV_OPA_COVER, 0);
    lv_obj_remove_flag(root, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_flex_flow(root, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_all(root, 0, 0);
    lv_obj_set_style_pad_row(root, 0, 0);
    lv_obj_t *bar = lv_obj_create(root);
    lv_obj_remove_style_all(bar);
    lv_obj_set_size(bar, lv_pct(100), 36);
    lv_obj_set_style_bg_color(bar, lv_color_hex(COL_BAR), 0);
    lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_t *back = make_label_button(bar, "<", COL_BTN, backCb);
    lv_obj_set_style_pad_ver(back, 6, 0);
    lv_obj_align(back, LV_ALIGN_LEFT_MID, 6, 0);
    lv_obj_t *t = lv_label_create(bar);
    lv_label_set_text(t, title);
    lv_obj_set_style_text_color(t, lv_color_hex(0xFFFFFF), 0);
    lv_obj_align(t, LV_ALIGN_LEFT_MID, 50, 0);
    lv_obj_t *content = lv_obj_create(root);
    lv_obj_remove_style_all(content);
    lv_obj_set_width(content, lv_pct(100));
    lv_obj_set_flex_grow(content, 1);
    lv_obj_set_style_pad_all(content, 8, 0);
    lv_obj_set_style_pad_row(content, 8, 0);
    lv_obj_set_flex_flow(content, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_scroll_dir(content, LV_DIR_VER);
    lv_obj_set_scrollbar_mode(content, LV_SCROLLBAR_MODE_AUTO);
    *contentOut = content;
    lv_obj_add_flag(root, LV_OBJ_FLAG_HIDDEN);
    return root;
}

// ---- MQTT form ----

static void ta_click_cb(lv_event_t *e)
{
    lv_obj_t *ta = (lv_obj_t *)lv_event_get_target(e);
    if (g_showKb)
        g_showKb(ta);
}

static lv_obj_t *make_field(lv_obj_t *content, const char *label, uint32_t maxLen, bool password)
{
    lv_obj_t *l = lv_label_create(content);
    lv_label_set_text(l, label);
    lv_obj_set_style_text_color(l, lv_color_hex(0xB8BEE6), 0);
    lv_obj_t *ta = lv_textarea_create(content);
    lv_obj_set_width(ta, lv_pct(100));
    lv_textarea_set_one_line(ta, true);
    lv_textarea_set_max_length(ta, maxLen);
    lv_textarea_set_password_mode(ta, password);
    lv_obj_set_style_bg_color(ta, lv_color_hex(COL_FIELD), 0);
    lv_obj_set_style_text_color(ta, lv_color_hex(0x1F2937), 0);
    lv_obj_add_event_cb(ta, ta_click_cb, LV_EVENT_CLICKED, nullptr);
    return ta;
}

static lv_obj_t *make_switch_row(lv_obj_t *content, const char *label)
{
    lv_obj_t *row = lv_obj_create(content);
    lv_obj_remove_style_all(row);
    lv_obj_set_size(row, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_remove_flag(row, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_t *l = lv_label_create(row);
    lv_label_set_text(l, label);
    lv_obj_set_style_text_color(l, lv_color_hex(0xFFFFFF), 0);
    lv_obj_align(l, LV_ALIGN_LEFT_MID, 0, 0);
    lv_obj_t *sw = lv_switch_create(row);
    lv_obj_align(sw, LV_ALIGN_RIGHT_MID, 0, 0);
    return sw;
}

static void set_switch(lv_obj_t *sw, bool on)
{
    if (on)
        lv_obj_add_state(sw, LV_STATE_CHECKED);
    else
        lv_obj_remove_state(sw, LV_STATE_CHECKED);
}

static void show_pass_cb(lv_event_t *e)
{
    lv_obj_t *l = (lv_obj_t *)lv_event_get_target(e);
    bool hidden = lv_textarea_get_password_mode(g_taPass);
    lv_textarea_set_password_mode(g_taPass, !hidden);
    lv_label_set_text(l, hidden ? "Hide password" : "Show password");
}

static void mqtt_load(void)
{
    meshtastic_ModuleConfig_MQTTConfig *c = (meshtastic_ModuleConfig_MQTTConfig *)g_mqttCfg();
    set_switch(g_swEnabled, c->enabled);
    set_switch(g_swEnc, c->encryption_enabled);
    set_switch(g_swTls, c->tls_enabled);
    set_switch(g_swProxy, c->proxy_to_client_enabled);
    lv_textarea_set_text(g_taAddress, c->address);
    lv_textarea_set_text(g_taUser, c->username);
    lv_textarea_set_text(g_taPass, c->password);
    lv_textarea_set_text(g_taRoot, c->root[0] ? c->root : "msh/ID");
    lv_label_set_text(g_mqttStatus, "");
}

static void copy_text(char *dst, size_t size, lv_obj_t *ta)
{
    strncpy(dst, lv_textarea_get_text(ta), size - 1);
    dst[size - 1] = 0;
}

static void mqtt_save_cb(lv_event_t *e)
{
    meshtastic_ModuleConfig_MQTTConfig *c = (meshtastic_ModuleConfig_MQTTConfig *)g_mqttCfg();
    c->enabled = lv_obj_has_state(g_swEnabled, LV_STATE_CHECKED);
    c->encryption_enabled = lv_obj_has_state(g_swEnc, LV_STATE_CHECKED);
    c->tls_enabled = lv_obj_has_state(g_swTls, LV_STATE_CHECKED);
    c->proxy_to_client_enabled = lv_obj_has_state(g_swProxy, LV_STATE_CHECKED);
    copy_text(c->address, sizeof(c->address), g_taAddress);
    copy_text(c->username, sizeof(c->username), g_taUser);
    copy_text(c->password, sizeof(c->password), g_taPass);
    copy_text(c->root, sizeof(c->root), g_taRoot);
    g_sendMqtt();
    hide_kb();
    lv_label_set_text(g_mqttStatus, "Saved, the node applies it after a restart");
}

static void mqtt_back_cb(lv_event_t *e)
{
    close_panel(g_mqttPanel);
}

static void mqtt_cancel_cb(lv_event_t *e)
{
    close_panel(g_mqttPanel);
}

static void build_mqtt_panel(void)
{
    lv_obj_t *content;
    g_mqttPanel = make_panel("MQTT", mqtt_back_cb, &content);
    g_swEnabled = make_switch_row(content, "MQTT enabled");
    g_taAddress = make_field(content, "Address", 63, false);
    g_taUser = make_field(content, "Username", 63, false);
    g_taPass = make_field(content, "Password", 31, true);
    lv_obj_t *show = make_label_button(content, "Show password", COL_BTN, show_pass_cb);
    lv_obj_set_style_pad_ver(show, 6, 0);
    g_swEnc = make_switch_row(content, "Encryption enabled");
    g_swTls = make_switch_row(content, "TLS enabled");
    g_taRoot = make_field(content, "Root topic", 31, false);
    g_swProxy = make_switch_row(content, "Proxy to client enabled");
    g_mqttStatus = lv_label_create(content);
    lv_label_set_text(g_mqttStatus, "");
    lv_obj_set_style_text_color(g_mqttStatus, lv_color_hex(0x8FE0A8), 0);
    lv_obj_t *buttons = lv_obj_create(content);
    lv_obj_remove_style_all(buttons);
    lv_obj_set_size(buttons, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(buttons, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(buttons, LV_FLEX_ALIGN_SPACE_EVENLY, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_remove_flag(buttons, LV_OBJ_FLAG_SCROLLABLE);
    make_label_button(buttons, "Save", 0x2F7D4F, mqtt_save_cb);
    make_label_button(buttons, "Cancel", 0x5A6078, mqtt_cancel_cb);
    // room under the last button so the keyboard does not hide it
    lv_obj_t *pad = lv_obj_create(content);
    lv_obj_remove_style_all(pad);
    lv_obj_set_size(pad, 10, 150);
}

static void mqtt_open_cb(lv_event_t *e)
{
    if (!g_mqttPanel)
        build_mqtt_panel();
    mqtt_load();
    open_panel(g_mqttPanel);
}

// ---- advanced list ----

static void names_text(void)
{
    if (g_namesLabel)
        lv_label_set_text(g_namesLabel, emoji_long_names() ? "Chat names: long" : "Chat names: short");
}

static void names_cb(lv_event_t *e)
{
    emoji_long_names_toggle();
    names_text();
}

static void adv_back_cb(lv_event_t *e)
{
    close_panel(g_advPanel);
}

static void build_adv_panel(void)
{
    lv_obj_t *content;
    g_advPanel = make_panel("Advanced settings", adv_back_cb, &content);
    lv_obj_t *names = make_label_button(content, "", COL_BTN, names_cb);
    lv_obj_set_width(names, lv_pct(100));
    g_namesLabel = names;
    names_text();
    lv_obj_t *mqtt = make_label_button(content, "MQTT  >", COL_BTN, mqtt_open_cb);
    lv_obj_set_width(mqtt, lv_pct(100));
}

static void adv_open_cb(lv_event_t *e)
{
    if (!g_advPanel)
        build_adv_panel();
    names_text();
    open_panel(g_advPanel);
}

// adds "Advanced settings" to the settings list, right below the button given
extern "C" void emoji_settings_init(lv_obj_t *anchor, lv_obj_t *screen, lv_obj_t *keyboard, void *(*mqttCfg)(void),
                                    void (*sendMqtt)(void), void (*showKb)(lv_obj_t *))
{
    if (g_screen || !anchor || !screen)
        return;
    g_screen = screen;
    g_kb = keyboard;
    g_mqttCfg = mqttCfg;
    g_sendMqtt = sendMqtt;
    g_showKb = showKb;
    lv_obj_t *parent = lv_obj_get_parent(anchor);
    lv_obj_t *btn = lv_button_create(parent);
    lv_obj_set_pos(btn, 0, 0);
    lv_obj_set_size(btn, LV_PCT(95), 30);
    add_style_settings_button_style(btn);
    lv_obj_set_style_align(btn, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_shadow_width(btn, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_left(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_right(btn, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(btn, lv_color_hex(0x4db270), LV_PART_MAIN | LV_STATE_PRESSED);
    lv_obj_set_style_text_color(btn, lv_color_hex(0x015114), LV_PART_MAIN | LV_STATE_PRESSED);
    lv_obj_t *label = lv_label_create(btn);
    lv_obj_set_size(label, LV_PCT(100), LV_SIZE_CONTENT);
    lv_label_set_long_mode(label, LV_LABEL_LONG_DOT);
    lv_obj_set_style_align(label, LV_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_label_set_text(label, "Advanced settings");
    lv_obj_add_event_cb(btn, adv_open_cb, LV_EVENT_CLICKED, nullptr);
    lv_obj_move_to_index(btn, lv_obj_get_index(anchor) + 1);
}
