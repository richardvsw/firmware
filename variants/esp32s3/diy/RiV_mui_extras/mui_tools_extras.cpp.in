// the daemon's working directory is whatever started it (on the R1 that is the web server's cgi folder), so anchor notes in its data folder
static const char *nf_rel(const char *p)
{
    static char buf[160];
    static const char *base = nullptr;
    if (!base) {
        base = getenv("MUI_NOTES_BASE");
        if (!base || !base[0])
            base = access("/usr/data/.portduino", F_OK) == 0 ? "/usr/data/.portduino" : ".";
    }
    snprintf(buf, sizeof(buf), "%s%s%s", base, (p && p[0] == '/') ? "" : "/", p ? p : "");
    return buf;
}
static bool nf_exists(const char *p)
{
    return access(nf_rel(p), F_OK) == 0;
}
#endif

