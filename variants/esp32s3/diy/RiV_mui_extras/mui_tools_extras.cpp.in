// -------------------------------------------------------------
// Data Tracking: Position, Nodes, RF Metrics
// -------------------------------------------------------------

struct Waypoint {
    char name[24];
    int32_t lat; // * 1e-7
    int32_t lon; // * 1e-7
    int32_t alt; // meters
};

static Waypoint g_waypoints[16];
static int g_numWaypoints = 0;
static int32_t g_myLat = 0, g_myLon = 0, g_myAlt = 0;

struct RadarNode {
    uint32_t nodeNum;
    char name[24];
    int32_t lat;
    int32_t lon;
    int32_t alt;
    int32_t rssi;
    float snr;
    uint32_t lastHeard;
};

static RadarNode g_radarNodes[32];
static int g_radarCount = 0;

// RF Metrics
static float g_chUtil = 0.0f;
static float g_airUtil = 0.0f;
static uint32_t g_rxPkts = 0;
static uint32_t g_txPkts = 0;
static uint32_t g_badPkts = 0;
static float g_avgRssi = -105.0f;
static float g_avgSnr = 0.0f;
static int g_sigSamples = 0;

static float g_gpsHeading = 0.0f;
static uint32_t g_gpsHeadingAt = 0;

extern "C" void emoji_tools_record_pos(uint32_t nodeNum, int32_t lat, int32_t lon, int32_t alt, bool isOwn)
{
    if (isOwn) {
        if ((g_myLat != 0 || g_myLon != 0) && (lat != g_myLat || lon != g_myLon)) {
            // course over ground from the last two fixes, ignored while the fix only jitters (under 4 m)
            float c = cosf((float)lat * 1e-7f * 0.0174533f);
            float dx = 111320.0f * c * 1e-7f * (float)(lon - g_myLon);
            float dy = 110570.0f * 1e-7f * (float)(lat - g_myLat);
            if (dx * dx + dy * dy >= 16.0f) {
                float h = atan2f(dx, dy) * 57.29578f;
                g_gpsHeading = h < 0.0f ? h + 360.0f : h;
                g_gpsHeadingAt = millis() ? millis() : 1;
            }
        }
        g_myLat = lat;
        g_myLon = lon;
        g_myAlt = alt;
    }
    if (!nodeNum || (lat == 0 && lon == 0)) return;

    for (int i = 0; i < g_radarCount; i++) {
        if (g_radarNodes[i].nodeNum == nodeNum) {
            g_radarNodes[i].lat = lat;
            g_radarNodes[i].lon = lon;
            g_radarNodes[i].alt = alt;
            return;
        }
    }
    if (g_radarCount < 32) {
        RadarNode &rn = g_radarNodes[g_radarCount++];
        rn.nodeNum = nodeNum;
        snprintf(rn.name, sizeof(rn.name), "!%08x", (unsigned)nodeNum);
        rn.lat = lat;
        rn.lon = lon;
        rn.alt = alt;
        rn.rssi = -120;
        rn.snr = 0.0f;
        rn.lastHeard = millis() / 1000;
    }
}

extern "C" void emoji_tools_record_node(uint32_t nodeNum, const char *shortName, const char *longName, uint32_t lastHeard)
{
    if (!nodeNum) return;
    for (int i = 0; i < g_radarCount; i++) {
        if (g_radarNodes[i].nodeNum == nodeNum) {
            if (shortName && shortName[0]) {
                snprintf(g_radarNodes[i].name, sizeof(g_radarNodes[i].name), "%s", shortName);
            }
            if (lastHeard) g_radarNodes[i].lastHeard = lastHeard;
            return;
        }
    }
    if (g_radarCount < 32) {
        RadarNode &rn = g_radarNodes[g_radarCount++];
        rn.nodeNum = nodeNum;
        if (shortName && shortName[0])
            snprintf(rn.name, sizeof(rn.name), "%s", shortName);
        else
            snprintf(rn.name, sizeof(rn.name), "!%08x", (unsigned)nodeNum);
        rn.lat = 0;
        rn.lon = 0;
        rn.alt = 0;
        rn.rssi = -120;
        rn.snr = 0.0f;
        rn.lastHeard = lastHeard ? lastHeard : (millis() / 1000);
    }
}

extern "C" void emoji_tools_record_signal(uint32_t nodeNum, int32_t rssi, float snr)
{
    if (rssi != 0) {
        if (g_sigSamples == 0) {
            g_avgRssi = (float)rssi;
            g_avgSnr = snr;
        } else {
            g_avgRssi = g_avgRssi * 0.85f + (float)rssi * 0.15f;
            g_avgSnr = g_avgSnr * 0.85f + snr * 0.15f;
        }
        g_sigSamples++;
    }

    if (!nodeNum) return;
    for (int i = 0; i < g_radarCount; i++) {
        if (g_radarNodes[i].nodeNum == nodeNum) {
            g_radarNodes[i].rssi = rssi;
            g_radarNodes[i].snr = snr;
            g_radarNodes[i].lastHeard = millis() / 1000;
            return;
        }
    }
}

extern "C" void emoji_tools_record_metrics(float chUtil, float airUtil)
{
    g_chUtil = chUtil;
    g_airUtil = airUtil;
}

extern "C" void emoji_tools_record_packet(bool isTx, bool isBad)
{
    if (isTx) g_txPkts++;
    else g_rxPkts++;
    if (isBad) g_badPkts++;
}

// -------------------------------------------------------------
// Distance & Bearing Math
// -------------------------------------------------------------

static void calc_dist_bearing(int32_t lat1, int32_t lon1, int32_t lat2, int32_t lon2,
                             float &distKm, float &bearingDeg, const char *&cardinal)
{
    float midLat = 0.5f * ((float)lat1 + (float)lat2) * 1e-7f * 0.0174533f;
    float dx = 111.32f * cosf(midLat) * 1e-7f * (float)(lon2 - lon1);
    float dy = 110.57f * 1e-7f * (float)(lat2 - lat1);
    distKm = sqrtf(dx * dx + dy * dy);
    float rad = atan2f(dx, dy);
    bearingDeg = rad * 57.29578f;
    if (bearingDeg < 0.0f) bearingDeg += 360.0f;

    cardinal = "N";
    if (bearingDeg >= 22.5f && bearingDeg < 67.5f) cardinal = "NE";
    else if (bearingDeg >= 67.5f && bearingDeg < 112.5f) cardinal = "E";
    else if (bearingDeg >= 112.5f && bearingDeg < 157.5f) cardinal = "SE";
    else if (bearingDeg >= 157.5f && bearingDeg < 202.5f) cardinal = "S";
    else if (bearingDeg >= 202.5f && bearingDeg < 247.5f) cardinal = "SW";
    else if (bearingDeg >= 247.5f && bearingDeg < 292.5f) cardinal = "W";
    else if (bearingDeg >= 292.5f && bearingDeg < 337.5f) cardinal = "NW";
}

// -------------------------------------------------------------
// Waypoints Persistence (SD & NVS)
// -------------------------------------------------------------

static void load_waypoints()
{
    g_numWaypoints = 0;
#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        if (SDFs.exists("/waypoints.txt")) {
            FsFile f = SDFs.open("/waypoints.txt", O_RDONLY);
            if (f) {
                char line[96];
                while (f.fgets(line, sizeof(line)) > 0 && g_numWaypoints < 16) {
                    char name[24] = {0};
                    int32_t lat = 0, lon = 0, alt = 0;
                    if (sscanf(line, "%23[^,],%d,%d,%d", name, &lat, &lon, &alt) >= 3) {
                        snprintf(g_waypoints[g_numWaypoints].name, sizeof(g_waypoints[g_numWaypoints].name), "%s", name);
                        g_waypoints[g_numWaypoints].lat = lat;
                        g_waypoints[g_numWaypoints].lon = lon;
                        g_waypoints[g_numWaypoints].alt = alt;
                        g_numWaypoints++;
                    }
                }
                f.close();
                if (g_numWaypoints > 0) return;
            }
        }
    }
#endif
    // NVS Fallback
    Preferences p;
    if (p.begin("waypts", true)) {
        g_numWaypoints = p.getInt("cnt", 0);
        if (g_numWaypoints > 16) g_numWaypoints = 16;
        for (int i = 0; i < g_numWaypoints; i++) {
            char k[16];
            snprintf(k, sizeof(k), "n%d", i);
            snprintf(g_waypoints[i].name, sizeof(g_waypoints[i].name), "%s", p.getString(k, "WP").c_str());
            snprintf(k, sizeof(k), "la%d", i);
            g_waypoints[i].lat = p.getInt(k, 0);
            snprintf(k, sizeof(k), "lo%d", i);
            g_waypoints[i].lon = p.getInt(k, 0);
            snprintf(k, sizeof(k), "al%d", i);
            g_waypoints[i].alt = p.getInt(k, 0);
        }
        p.end();
    }
}

static void save_waypoints()
{
#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        FsFile f = SDFs.open("/waypoints.txt", O_WRONLY | O_CREAT | O_TRUNC);
        if (f) {
            for (int i = 0; i < g_numWaypoints; i++) {
                char buf[96];
                snprintf(buf, sizeof(buf), "%s,%d,%d,%d\n", g_waypoints[i].name,
                         (int)g_waypoints[i].lat, (int)g_waypoints[i].lon, (int)g_waypoints[i].alt);
                f.write(buf);
            }
            f.close();
        }
    }
#endif
    Preferences p;
    if (p.begin("waypts", false)) {
        p.putInt("cnt", g_numWaypoints);
        for (int i = 0; i < g_numWaypoints; i++) {
            char k[16];
            snprintf(k, sizeof(k), "n%d", i);
            p.putString(k, g_waypoints[i].name);
            snprintf(k, sizeof(k), "la%d", i);
            p.putInt(k, g_waypoints[i].lat);
            snprintf(k, sizeof(k), "lo%d", i);
            p.putInt(k, g_waypoints[i].lon);
            snprintf(k, sizeof(k), "al%d", i);
            p.putInt(k, g_waypoints[i].alt);
        }
        p.end();
    }
}

// -------------------------------------------------------------
// Sub-Screen Factory (Clean Full-Screen View with Native Top Bar)
// -------------------------------------------------------------

static void on_subscreen_back(lv_event_t *e)
{
    lv_obj_t *root = (lv_obj_t *)lv_event_get_user_data(e);
    if (root) {
        lv_obj_del_async(root);
    }
    if (g_kb) lv_obj_add_flag(g_kb, LV_OBJ_FLAG_HIDDEN);
}

static lv_obj_t *create_subscreen(const char *title, lv_obj_t **outBody)
{
    if (!g_screen) return nullptr;

    lv_obj_t *root = lv_obj_create(g_screen);
    lv_obj_remove_style_all(root);
    lv_obj_set_size(root, lv_pct(100), lv_pct(100));
    lv_obj_set_style_bg_color(root, lv_color_hex(g_tBg), 0);
    lv_obj_set_style_bg_opa(root, LV_OPA_COVER, 0);
    lv_obj_remove_flag(root, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_flex_flow(root, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_all(root, 0, 0);

    // Top Bar
    lv_obj_t *bar = lv_obj_create(root);
    lv_obj_remove_style_all(bar);
    lv_obj_set_size(bar, lv_pct(100), 38);
    add_style_top_panel_style(bar);
    lv_obj_set_style_bg_color(bar, lv_color_hex(g_tTopBg), 0);
    lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(bar, 0, 0);
    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);

    // Back Button [ < Back ]
    lv_obj_t *backBtn = lv_button_create(bar);
    lv_obj_set_size(backBtn, 64, 28);
    lv_obj_set_style_align(backBtn, LV_ALIGN_LEFT_MID, 0);
    lv_obj_set_pos(backBtn, 6, 0);
    lv_obj_set_style_bg_color(backBtn, lv_color_hex(g_tBtnBg), 0);
    lv_obj_set_style_bg_opa(backBtn, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(backBtn, 4, 0);
    lv_obj_set_style_shadow_width(backBtn, 0, 0);
    lv_obj_add_event_cb(backBtn, on_subscreen_back, LV_EVENT_CLICKED, root);

    lv_obj_t *backLbl = lv_label_create(backBtn);
    lv_label_set_text(backLbl, "< Back");
    lv_obj_set_style_text_color(backLbl, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(backLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(backLbl, LV_ALIGN_CENTER, 0);

    // Title
    lv_obj_t *titleLbl = lv_label_create(bar);
    lv_label_set_text(titleLbl, title);
    lv_obj_set_style_text_color(titleLbl, lv_color_hex(g_tTopText), 0);
    lv_obj_set_style_text_font(titleLbl, &ui_font_montserrat_14, 0);
    lv_obj_set_style_align(titleLbl, LV_ALIGN_CENTER, 0);

    // Body
    lv_obj_t *body = lv_obj_create(root);
    lv_obj_remove_style_all(body);
    lv_obj_set_size(body, lv_pct(100), LV_PCT(100));
    lv_obj_set_flex_grow(body, 1);
    lv_obj_set_flex_flow(body, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_all(body, 8, 0);
    lv_obj_set_style_pad_row(body, 6, 0);
    lv_obj_set_scrollbar_mode(body, LV_SCROLLBAR_MODE_AUTO);
    lv_obj_set_scroll_dir(body, LV_DIR_VER);

    if (outBody) *outBody = body;

    // joystick: the controls of the finished screen take over the input group, and give it back when the screen is gone
    lv_obj_add_event_cb(root, [](lv_event_t *ev) {
        if (emoji_joy_screen_closed) emoji_joy_screen_closed((lv_obj_t *)lv_event_get_target(ev));
    }, LV_EVENT_DELETE, nullptr);
    lv_async_call([](void *r) {
        if (emoji_joy_screen_open && lv_obj_is_valid((lv_obj_t *)r)) emoji_joy_screen_open((lv_obj_t *)r);
    }, root);
    return root;
}

// -------------------------------------------------------------
// 1. Waypoints & Backtrack Compass Screen
// -------------------------------------------------------------

static lv_obj_t *g_wpListContainer = nullptr;
static int g_guideWpIdx = -1;

static void refresh_waypoints_list();

// -------------------------------------------------------------
// Guide screen: Text | Compass | Map tabs
// -------------------------------------------------------------

// ---- heading: a magnetometer when the board has one, otherwise the GPS course ----
enum { MAG_UNKNOWN = -1, MAG_NONE = 0, MAG_QMC5883L = 1, MAG_HMC5883L = 2 };
static int g_magType = MAG_UNKNOWN;
static float g_magMin[2] = {32767.0f, 32767.0f}, g_magMax[2] = {-32767.0f, -32767.0f};

#if !defined(ARCH_PORTDUINO)
static bool mag_read_regs(uint8_t addr, uint8_t reg, uint8_t *buf, uint8_t n)
{
    Wire.beginTransmission(addr);
    Wire.write(reg);
    if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom((int)addr, (int)n) != n) return false;
    for (uint8_t i = 0; i < n; i++) buf[i] = Wire.read();
    return true;
}
static void mag_write_reg(uint8_t addr, uint8_t reg, uint8_t v)
{
    Wire.beginTransmission(addr);
    Wire.write(reg);
    Wire.write(v);
    Wire.endTransmission();
}
#endif

static void mag_probe()
{
    if (g_magType != MAG_UNKNOWN) return;
    g_magType = MAG_NONE;
#if !defined(ARCH_PORTDUINO)
    uint8_t id[3] = {0, 0, 0};
    if (mag_read_regs(0x0D, 0x0D, id, 1) && id[0] == 0xFF) { // QMC5883L chip id
        mag_write_reg(0x0D, 0x0B, 0x01);
        mag_write_reg(0x0D, 0x09, 0x1D); // continuous, 200 Hz, 8 G, 512 oversampling
        g_magType = MAG_QMC5883L;
    } else if (mag_read_regs(0x1E, 0x0A, id, 3) && id[0] == 'H' && id[1] == '4' && id[2] == '3') { // HMC5883L id
        mag_write_reg(0x1E, 0x00, 0x70);
        mag_write_reg(0x1E, 0x02, 0x00); // continuous
        g_magType = MAG_HMC5883L;
    }
#endif
}

static const char *mag_name()
{
    return g_magType == MAG_QMC5883L ? "QMC5883L (0x0D)" : g_magType == MAG_HMC5883L ? "HMC5883L (0x1E)" : "none";
}

// flat heading 0..360 from the magnetometer, hard-iron offsets learned while the device is turned around
static bool mag_heading(float &deg)
{
#if !defined(ARCH_PORTDUINO)
    uint8_t b[6];
    float x, y;
    if (g_magType == MAG_QMC5883L) {
        if (!mag_read_regs(0x0D, 0x00, b, 6)) return false;
        x = (float)(int16_t)(b[0] | (b[1] << 8));
        y = (float)(int16_t)(b[2] | (b[3] << 8));
    } else if (g_magType == MAG_HMC5883L) {
        if (!mag_read_regs(0x1E, 0x03, b, 6)) return false;
        x = (float)(int16_t)((b[0] << 8) | b[1]);
        y = (float)(int16_t)((b[4] << 8) | b[5]);
    } else {
        return false;
    }
    float v[2] = {x, y};
    for (int i = 0; i < 2; i++) {
        if (v[i] < g_magMin[i]) g_magMin[i] = v[i];
        if (v[i] > g_magMax[i]) g_magMax[i] = v[i];
    }
    float cx = 0.5f * (g_magMax[0] + g_magMin[0]), cy = 0.5f * (g_magMax[1] + g_magMin[1]);
    float h = atan2f(y - cy, x - cx) * 57.29578f;
    deg = h < 0.0f ? h + 360.0f : h;
    return true;
#else
    (void)deg;
    return false;
#endif
}

// demo compass: on the portduino build a flag file (or MUI_SIM_COMPASS) turns on a simulated sensor that sweeps a full turn every 30 s
static bool sim_compass_on()
{
#if defined(ARCH_PORTDUINO)
    static int st = -1;
    static uint32_t chk = 0;
    uint32_t n = millis();
    if (st < 0 || n - chk > 5000) {
        chk = n;
        st = (access("/usr/data/.portduino/sim_compass", F_OK) == 0 || getenv("MUI_SIM_COMPASS")) ? 1 : 0;
    }
    return st == 1;
#else
    return false;
#endif
}

// source: 2 = magnetometer, 1 = GPS course, 0 = unknown
static int current_heading(float &deg)
{
    uint32_t now = millis();
    if (sim_compass_on()) {
        deg = fmodf((float)now * 0.012f, 360.0f);
        return 2;
    }
    bool gpsFresh = g_gpsHeadingAt && (now - g_gpsHeadingAt) < 6000;
    bool magOk = g_magType > MAG_NONE && mag_heading(deg);
    if (gpsFresh && (!magOk || (now - g_gpsHeadingAt) < 3000)) {
        deg = g_gpsHeading; // walking: the GPS course beats a magnetometer near metal and the body
        return 1;
    }
    if (magOk) return 2;
    if (g_gpsHeadingAt && (now - g_gpsHeadingAt) < 30000) {
        deg = g_gpsHeading;
        return 1;
    }
    return 0;
}

// ---- tiles: the stock map layout <prefix>/<style>/<zoom>/<x>/<y>.png ----
#if LV_USE_FS_ARDUINO_SD
#define GM_LETTER LV_FS_ARDUINO_SD_LETTER
#else
// no lvgl file driver for the card (every build except the ones that define LV_USE_FS_ARDUINO_SD): the stock map reads and decodes the PNG
// itself through SDCardService, so use that service on the boards as well as on portduino
#define GM_PORTDUINO 1
#include "graphics/map/SDCardService.h"
#endif

#if defined(GM_LETTER) || defined(GM_PORTDUINO)
static char g_gmPrefix[48] = "";
static char g_gmStyle[24] = "";
static bool g_gmFound = false;

#ifdef GM_PORTDUINO
// no file driver for tiles: the stock map decodes the PNG itself, so reuse its service and free the image with the tile
static SDCardService *g_gmSvc = nullptr;
static void gm_free_cb(lv_event_t *e)
{
    lv_obj_t *im = (lv_obj_t *)lv_event_get_target(e);
    const void *src = lv_image_get_src(im);
    if (src && lv_image_src_get_type(src) == LV_IMAGE_SRC_VARIABLE) {
        lv_img_dsc_t *d = (lv_img_dsc_t *)src;
        if (d->data && d->data_size > 0) lv_free((void *)d->data);
        lv_free(d);
    }
}
static lv_obj_t *gm_try(lv_obj_t *parent, const char *prefix, const char *style, int z, int x, int y)
{
    if (!g_gmSvc) g_gmSvc = new SDCardService();
    char name[128];
    snprintf(name, sizeof(name), "%s/%s%d/%d/%d.png", prefix, style, z, x, y);
    lv_obj_t *im = lv_image_create(parent);
    if (!g_gmSvc->load(name, im)) {
        lv_obj_delete(im);
        return nullptr;
    }
    lv_obj_add_event_cb(im, gm_free_cb, LV_EVENT_DELETE, nullptr);
    return im;
}
#else
static lv_obj_t *gm_try(lv_obj_t *parent, const char *prefix, const char *style, int z, int x, int y)
{
    char path[128];
    snprintf(path, sizeof(path), "%c:%s/%s%d/%d/%d.png", GM_LETTER, prefix, style, z, x, y);
    lv_fs_file_t f;
    if (lv_fs_open(&f, path, LV_FS_MODE_RD) != LV_FS_RES_OK) return nullptr;
    lv_fs_close(&f);
    lv_obj_t *im = lv_image_create(parent);
    lv_image_set_src(im, path);
    return im;
}
#endif

// one tile image, or nullptr when the card has none; the first hit fixes the prefix and style for the rest
static lv_obj_t *gm_tile(lv_obj_t *parent, int z, int x, int y)
{
    if (g_gmFound) return gm_try(parent, g_gmPrefix, g_gmStyle, z, x, y);
    const char *prefixes[] = {MapTileSettings::getPrefix(), "/maps", "/sdcard/maps"};
    const char *styles[] = {MapTileSettings::getTileDir(), "0/", "osm/", ""};
    for (auto pf : prefixes) {
        for (auto st : styles) {
            if (lv_obj_t *im = gm_try(parent, pf, st, z, x, y)) {
                snprintf(g_gmPrefix, sizeof(g_gmPrefix), "%s", pf);
                snprintf(g_gmStyle, sizeof(g_gmStyle), "%s", st);
                g_gmFound = true;
                return im;
            }
        }
    }
    return nullptr;
}
#endif

static void tile_of(double lat, double lon, int z, double &tx, double &ty)
{
    double n = (double)(1 << z), lr = lat * 0.017453292519943295;
    tx = (lon + 180.0) / 360.0 * n;
    ty = (1.0 - log(tan(lr) + 1.0 / cos(lr)) / 3.141592653589793) / 2.0 * n;
}

struct GuideUi {
    lv_obj_t *dist = nullptr;
    lv_obj_t *coord = nullptr, *alt = nullptr, *pText = nullptr;
    lv_obj_t *pComp = nullptr, *dial = nullptr, *card[4] = {nullptr, nullptr, nullptr, nullptr}, *arrow = nullptr, *arrowLine = nullptr,
             *sensorLbl = nullptr, *headLbl = nullptr;
    lv_obj_t *pMap = nullptr, *mapBox = nullptr, *mapInfo = nullptr, *mapTiles = nullptr, *mapMarks = nullptr, *trailLine = nullptr,
             *toLine = nullptr;
    lv_obj_t *tabBtn[3] = {nullptr, nullptr, nullptr};
    lv_point_precise_t arrowPts[5];
    lv_point_precise_t arrowAxis[2];
    lv_point_precise_t trailPts[16];
    lv_point_precise_t toPts[2];
    int zoomManual = 0; // 0 = fit both points
    int tileZ = -1, tileX0 = 0, tileY0 = 0;
    int tab = 0;
};
static int g_guideTab = 0; // the tab that was open last
static GuideUi *g_gu = nullptr;

static void guide_show_tab(GuideUi *u, int t)
{
    u->tab = t;
    g_guideTab = t;
    lv_obj_t *panels[3] = {u->pText, u->pComp, u->pMap};
    for (int i = 0; i < 3; i++) {
        if (panels[i]) {
            if (i == t) lv_obj_clear_flag(panels[i], LV_OBJ_FLAG_HIDDEN);
            else lv_obj_add_flag(panels[i], LV_OBJ_FLAG_HIDDEN);
        }
        lv_obj_set_style_bg_color(u->tabBtn[i], lv_color_hex(i == t ? g_tBtnBg : g_tItemBg), 0);
    }
}

static void on_guide_tab(lv_event_t *e)
{
    int t = (int)(intptr_t)lv_event_get_user_data(e);
    if (g_gu) guide_show_tab(g_gu, t);
}

static void on_guide_zoom(lv_event_t *e)
{
    int d = (int)(intptr_t)lv_event_get_user_data(e);
    if (!g_gu) return;
    int z = g_gu->zoomManual ? g_gu->zoomManual : g_gu->tileZ;
    if (z < 3) z = 13;
    z += d;
    if (z < 3) z = 3;
    if (z > 13) z = 13; // the offline pack stops at zoom 13
    g_gu->zoomManual = z;
}

static void guide_refresh_compass(GuideUi *u, const Waypoint &wp, bool haveFix, float bearingDeg)
{
    float head = 0.0f;
    int src = current_heading(head);
    char buf[96];
    const char *msg;
    uint32_t col;
    if (sim_compass_on()) {
        snprintf(buf, sizeof(buf), "SIMULATED compass (demo mode), not a real sensor reading.");
        col = 0xb28dff;
    } else if (g_magType > MAG_NONE) {
        snprintf(buf, sizeof(buf), "Compass sensor: %s%s", mag_name(), src == 1 ? ". Using the GPS course while walking." : ". Heading is live.");
        col = 0x4dd68c;
    } else if (src == 1) {
        snprintf(buf, sizeof(buf), "No compass sensor found. Heading comes from the GPS track, keep walking.");
        col = 0xffd54a;
    } else {
        snprintf(buf, sizeof(buf), "No compass sensor and no GPS movement yet. The arrow needs a heading.");
        col = 0xe5484d;
    }
    msg = buf;
    lv_label_set_text(u->sensorLbl, msg);
    lv_obj_set_style_text_color(u->sensorLbl, lv_color_hex(col), 0);

    const int R = 66, cx = 75, cy = 75;
    // north, east, south, west labels turn against the heading
    for (int i = 0; i < 4; i++) {
        float a = ((float)i * 90.0f - (src ? head : 0.0f)) * 0.0174533f;
        lv_obj_set_pos(u->card[i], cx + (int)((R - 9) * sinf(a)) - 5, cy - (int)((R - 9) * cosf(a)) - 8);
    }
    if (!haveFix || src == 0) {
        lv_label_set_text(u->headLbl, !haveFix ? "no fix" : "walk to get a heading");
        lv_obj_add_flag(u->arrow, LV_OBJ_FLAG_HIDDEN);
        lv_obj_add_flag(u->arrowLine, LV_OBJ_FLAG_HIDDEN);
        return;
    }
    char hb[40];
    snprintf(hb, sizeof(hb), "heading %03d° %s", (int)head, src == 2 ? (sim_compass_on() ? "(simulated)" : "(sensor)") : "(GPS)");
    lv_label_set_text(u->headLbl, hb);
    float rel = (bearingDeg - head) * 0.0174533f;
    auto pt = [&](float r, float ang, lv_point_precise_t &o) {
        o.x = (lv_value_precise_t)(cx + r * sinf(rel + ang));
        o.y = (lv_value_precise_t)(cy - r * cosf(rel + ang));
    };
    pt(48, 0, u->arrowPts[0]);
    pt(20, 2.55f, u->arrowPts[1]);
    pt(8, 3.14159f, u->arrowPts[2]);
    pt(20, -2.55f, u->arrowPts[3]);
    u->arrowPts[4] = u->arrowPts[0];
    lv_line_set_points(u->arrow, u->arrowPts, 5);
    u->arrowAxis[0].x = cx;
    u->arrowAxis[0].y = cy;
    u->arrowAxis[1] = u->arrowPts[0];
    lv_line_set_points(u->arrowLine, u->arrowAxis, 2);
    lv_obj_clear_flag(u->arrow, LV_OBJ_FLAG_HIDDEN);
    lv_obj_clear_flag(u->arrowLine, LV_OBJ_FLAG_HIDDEN);
}

static lv_obj_t *guide_dot(lv_obj_t *parent, int x, int y, int r, uint32_t col)
{
    lv_obj_t *d = lv_obj_create(parent);
    lv_obj_remove_style_all(d);
    lv_obj_set_size(d, r * 2, r * 2);
    lv_obj_set_pos(d, x - r, y - r);
    lv_obj_set_style_radius(d, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(d, lv_color_hex(col), 0);
    lv_obj_set_style_bg_opa(d, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(d, 1, 0);
    lv_obj_set_style_border_color(d, lv_color_hex(0x000000), 0);
    lv_obj_clear_flag(d, LV_OBJ_FLAG_CLICKABLE);
    return d;
}

static void guide_refresh_map(GuideUi *u, const Waypoint &wp, bool haveFix)
{
#if defined(GM_LETTER) || defined(GM_PORTDUINO)
    lv_obj_update_layout(u->mapBox);
    int W = lv_obj_get_width(u->mapBox), H = lv_obj_get_height(u->mapBox);
    if (W < 40 || H < 40) return;
    double tLat = wp.lat * 1e-7, tLon = wp.lon * 1e-7, mLat = g_myLat * 1e-7, mLon = g_myLon * 1e-7;
    double cLat = haveFix ? (tLat + mLat) * 0.5 : tLat, cLon = haveFix ? (tLon + mLon) * 0.5 : tLon;

    int z = 13;
    if (u->zoomManual) {
        z = u->zoomManual;
    } else if (haveFix) {
        for (z = 15; z > 3; z--) { // the highest zoom that keeps both points in view
            double ax, ay, bx, by;
            tile_of(tLat, tLon, z, ax, ay);
            tile_of(mLat, mLon, z, bx, by);
            if (fabs(ax - bx) * 256.0 < W * 0.8 && fabs(ay - by) * 256.0 < H * 0.8) break;
        }
        if (z > 13) z = 13; // the offline pack stops at 13
    }
    bool zoomChanged = (u->tileZ != z);
    u->tileZ = z;

    double cx, cy;
    tile_of(cLat, cLon, z, cx, cy);
    int x0 = (int)floor(cx - W / 2.0 / 256.0), x1 = (int)floor(cx + W / 2.0 / 256.0);
    int y0 = (int)floor(cy - H / 2.0 / 256.0), y1 = (int)floor(cy + H / 2.0 / 256.0);
    if (zoomChanged || u->tileX0 != x0 || u->tileY0 != y0 || !lv_obj_get_child_count(u->mapTiles)) {
        lv_obj_clean(u->mapTiles);
        int found = 0, total = 0;
        for (int ty = y0; ty <= y1; ty++) {
            for (int tx = x0; tx <= x1; tx++) {
                total++;
                lv_obj_t *im = gm_tile(u->mapTiles, z, tx, ty);
                if (!im) continue;
                found++;
                lv_obj_set_user_data(im, (void *)(((uintptr_t)(tx - x0) << 8) | (uintptr_t)(ty - y0)));
            }
        }
        u->tileX0 = x0;
        u->tileY0 = y0;
        char info[80];
        if (!found) snprintf(info, sizeof(info), "No map tiles found (looked in %s)", MapTileSettings::getPrefix());
        else snprintf(info, sizeof(info), "zoom %d, %d of %d tiles on the card", z, found, total);
        lv_label_set_text(u->mapInfo, info);
    }
    uint32_t n = lv_obj_get_child_count(u->mapTiles);
    for (uint32_t i = 0; i < n; i++) {
        lv_obj_t *im = lv_obj_get_child(u->mapTiles, i);
        uintptr_t k = (uintptr_t)lv_obj_get_user_data(im);
        int tx = x0 + (int)((k >> 8) & 0xff), ty = y0 + (int)(k & 0xff);
        lv_obj_set_pos(im, (int)((tx - cx) * 256.0 + W / 2.0), (int)((ty - cy) * 256.0 + H / 2.0));
    }

    // trail, waypoints and you
    lv_obj_clean(u->mapMarks);
    auto px = [&](double lat, double lon, int &ox, int &oy) {
        double ax, ay;
        tile_of(lat, lon, z, ax, ay);
        ox = (int)((ax - cx) * 256.0 + W / 2.0);
        oy = (int)((ay - cy) * 256.0 + H / 2.0);
    };
    int np = g_numWaypoints < 16 ? g_numWaypoints : 16;
    for (int i = 0; i < np; i++) {
        int ox, oy;
        px(g_waypoints[i].lat * 1e-7, g_waypoints[i].lon * 1e-7, ox, oy);
        u->trailPts[i].x = ox;
        u->trailPts[i].y = oy;
    }
    u->trailLine = lv_line_create(u->mapMarks);
    lv_line_set_points(u->trailLine, u->trailPts, np);
    lv_obj_set_style_line_color(u->trailLine, lv_color_hex(0xffd54a), 0);
    lv_obj_set_style_line_width(u->trailLine, 2, 0);
    lv_obj_set_style_line_dash_width(u->trailLine, 6, 0);
    lv_obj_set_style_line_dash_gap(u->trailLine, 4, 0);
    int tx, ty, mx, my;
    px(tLat, tLon, tx, ty);
    if (haveFix) {
        px(mLat, mLon, mx, my);
        u->toPts[0].x = mx;
        u->toPts[0].y = my;
        u->toPts[1].x = tx;
        u->toPts[1].y = ty;
        u->toLine = lv_line_create(u->mapMarks);
        lv_line_set_points(u->toLine, u->toPts, 2);
        lv_obj_set_style_line_color(u->toLine, lv_color_hex(0x4dd68c), 0);
        lv_obj_set_style_line_width(u->toLine, 3, 0);
    }
    for (int i = 0; i < np; i++) {
        if (i == g_guideWpIdx) continue;
        guide_dot(u->mapMarks, (int)u->trailPts[i].x, (int)u->trailPts[i].y, 4, 0x7fe3d2);
    }
    guide_dot(u->mapMarks, tx, ty, 7, 0xffd54a);
    if (haveFix) guide_dot(u->mapMarks, mx, my, 6, 0x4dd68c);
#else
    lv_label_set_text(u->mapInfo, "This build has no map tile support.");
    (void)wp;
    (void)haveFix;
#endif
}

static void on_guide_screen_timer(lv_timer_t *t)
{
    GuideUi *u = (GuideUi *)lv_timer_get_user_data(t);
    if (!u || !u->dist || !lv_obj_is_valid(u->dist) || g_guideWpIdx < 0 || g_guideWpIdx >= g_numWaypoints) return;

    Waypoint &wp = g_waypoints[g_guideWpIdx];
    bool haveFix = !(g_myLat == 0 && g_myLon == 0);
    float distKm = 0.0f, bearingDeg = 0.0f;
    const char *card = "N";
    if (!haveFix) {
        lv_label_set_text(u->dist, "Waiting GPS fix...");
    } else {
        calc_dist_bearing(g_myLat, g_myLon, wp.lat, wp.lon, distKm, bearingDeg, card);
        char buf[64];
        if (distKm < 1.0f)
            snprintf(buf, sizeof(buf), "%dm  %s  (%03d°)", (int)(distKm * 1000.0f), card, (int)bearingDeg);
        else
            snprintf(buf, sizeof(buf), "%.2fkm  %s  (%03d°)", distKm, card, (int)bearingDeg);
        lv_label_set_text(u->dist, buf);
    }
    char b[64];
    int32_t dAlt = (g_myAlt && wp.alt) ? (wp.alt - g_myAlt) : 0;
    snprintf(b, sizeof(b), "Elev delta: %+dm (Target: %dm)", (int)dAlt, (int)wp.alt);
    lv_label_set_text(u->alt, b);

    if (u->tab == 1) guide_refresh_compass(u, wp, haveFix, bearingDeg);
    if (u->tab == 2) guide_refresh_map(u, wp, haveFix);
}

static lv_obj_t *guide_panel(lv_obj_t *parent)
{
    lv_obj_t *p = lv_obj_create(parent);
    lv_obj_remove_style_all(p);
    lv_obj_set_size(p, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(p, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(p, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_set_style_pad_row(p, 6, 0);
    return p;
}

static void on_open_guidance(lv_event_t *e)
{
    int idx = (int)(intptr_t)lv_event_get_user_data(e);
    if (idx < 0 || idx >= g_numWaypoints) return;
    g_guideWpIdx = idx;
    mag_probe();

    Waypoint &wp = g_waypoints[idx];
    char title[40];
    snprintf(title, sizeof(title), "Guide: %s", wp.name);

    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen(title, &body);
    if (!root || !body) return;

    GuideUi *u = new GuideUi();
    g_gu = u;
    u->zoomManual = 0;

    // name and distance stay on top of every tab
    lv_obj_t *card = lv_obj_create(body);
    lv_obj_remove_style_all(card);
    lv_obj_set_size(card, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_style_bg_color(card, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_bg_opa(card, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(card, 8, 0);
    lv_obj_set_style_pad_all(card, 8, 0);
    lv_obj_set_flex_flow(card, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(card, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
    lv_obj_set_style_pad_row(card, 4, 0);

    lv_obj_t *nameLbl = lv_label_create(card);
    lv_label_set_text(nameLbl, wp.name);
    lv_obj_set_style_text_font(nameLbl, &ui_font_montserrat_16, 0);
    lv_obj_set_style_text_color(nameLbl, lv_color_hex(g_tAccent), 0);

    u->dist = lv_label_create(card);
    lv_obj_set_style_text_font(u->dist, &ui_font_montserrat_20, 0);
    lv_obj_set_style_text_color(u->dist, lv_color_hex(0xffffff), 0);
    lv_label_set_text(u->dist, "Calculating...");

    // tab bar
    lv_obj_t *bar = lv_obj_create(body);
    lv_obj_remove_style_all(bar);
    lv_obj_set_size(bar, lv_pct(100), 30);
    lv_obj_set_flex_flow(bar, LV_FLEX_FLOW_ROW);
    lv_obj_set_style_pad_column(bar, 4, 0);
    const char *names[3] = {"Text", "Compass", "Map"};
    for (int i = 0; i < 3; i++) {
        lv_obj_t *b = lv_button_create(bar);
        lv_obj_set_size(b, lv_pct(32), 30);
        lv_obj_set_style_radius(b, 6, 0);
        lv_obj_set_style_shadow_width(b, 0, 0);
        lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
        lv_obj_add_event_cb(b, on_guide_tab, LV_EVENT_CLICKED, (void *)(intptr_t)i);
        lv_obj_t *l = lv_label_create(b);
        lv_label_set_text(l, names[i]);
        lv_obj_set_style_text_font(l, &ui_font_montserrat_12, 0);
        lv_obj_set_style_text_color(l, lv_color_hex(0xffffff), 0);
        lv_obj_center(l);
        u->tabBtn[i] = b;
    }

    // text tab
    u->pText = guide_panel(body);
    u->coord = lv_label_create(u->pText);
    char cBuf[64];
    snprintf(cBuf, sizeof(cBuf), "Target: %.5f, %.5f", (double)wp.lat * 1e-7, (double)wp.lon * 1e-7);
    lv_label_set_text(u->coord, cBuf);
    lv_obj_set_style_text_font(u->coord, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(u->coord, lv_color_hex(0x9ca3af), 0);
    u->alt = lv_label_create(u->pText);
    lv_obj_set_style_text_font(u->alt, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(u->alt, lv_color_hex(0x9ca3af), 0);

    // compass tab
    u->pComp = guide_panel(body);
    u->dial = lv_obj_create(u->pComp);
    lv_obj_remove_style_all(u->dial);
    lv_obj_set_size(u->dial, 150, 150);
    lv_obj_set_style_radius(u->dial, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(u->dial, lv_color_hex(0x0e1517), 0);
    lv_obj_set_style_bg_opa(u->dial, LV_OPA_COVER, 0);
    lv_obj_set_style_border_width(u->dial, 2, 0);
    lv_obj_set_style_border_color(u->dial, lv_color_hex(g_tBorder), 0);
    lv_obj_clear_flag(u->dial, LV_OBJ_FLAG_SCROLLABLE);
    const char *cards[4] = {"N", "E", "S", "W"};
    for (int i = 0; i < 4; i++) {
        u->card[i] = lv_label_create(u->dial);
        lv_label_set_text(u->card[i], cards[i]);
        lv_obj_set_style_text_font(u->card[i], &ui_font_montserrat_12, 0);
        lv_obj_set_style_text_color(u->card[i], lv_color_hex(i == 0 ? 0xe5484d : 0x9ca3af), 0);
    }
    u->arrow = lv_line_create(u->dial);
    lv_obj_set_style_line_color(u->arrow, lv_color_hex(0x4dd68c), 0);
    lv_obj_set_style_line_width(u->arrow, 4, 0);
    lv_obj_set_style_line_rounded(u->arrow, true, 0);
    u->arrowLine = lv_line_create(u->dial);
    lv_obj_set_style_line_color(u->arrowLine, lv_color_hex(0x4dd68c), 0);
    lv_obj_set_style_line_width(u->arrowLine, 4, 0);
    u->headLbl = lv_label_create(u->pComp);
    lv_obj_set_style_text_font(u->headLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(u->headLbl, lv_color_hex(0x9ca3af), 0);
    lv_label_set_text(u->headLbl, "");
    u->sensorLbl = lv_label_create(u->pComp);
    lv_obj_set_width(u->sensorLbl, lv_pct(100));
    lv_label_set_long_mode(u->sensorLbl, LV_LABEL_LONG_WRAP);
    lv_obj_set_style_text_font(u->sensorLbl, &ui_font_montserrat_12, 0);

    // map tab
    u->pMap = guide_panel(body);
    u->mapBox = lv_obj_create(u->pMap);
    lv_obj_remove_style_all(u->mapBox);
    lv_obj_set_size(u->mapBox, lv_pct(100), 230);
    lv_obj_set_style_bg_color(u->mapBox, lv_color_hex(0x0e1517), 0);
    lv_obj_set_style_bg_opa(u->mapBox, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(u->mapBox, 6, 0);
    lv_obj_set_style_clip_corner(u->mapBox, true, 0);
    lv_obj_clear_flag(u->mapBox, LV_OBJ_FLAG_SCROLLABLE);
    u->mapTiles = lv_obj_create(u->mapBox);
    lv_obj_remove_style_all(u->mapTiles);
    lv_obj_set_size(u->mapTiles, lv_pct(100), lv_pct(100));
    lv_obj_clear_flag(u->mapTiles, LV_OBJ_FLAG_CLICKABLE);
    u->mapMarks = lv_obj_create(u->mapBox);
    lv_obj_remove_style_all(u->mapMarks);
    lv_obj_set_size(u->mapMarks, lv_pct(100), lv_pct(100));
    lv_obj_clear_flag(u->mapMarks, LV_OBJ_FLAG_CLICKABLE);
    for (int i = 0; i < 2; i++) {
        lv_obj_t *zb = lv_button_create(u->mapBox);
        lv_obj_set_size(zb, 30, 30);
        lv_obj_align(zb, LV_ALIGN_TOP_RIGHT, -4, 4 + i * 34);
        lv_obj_set_style_bg_opa(zb, LV_OPA_80, 0);
        lv_obj_set_style_shadow_width(zb, 0, 0);
        lv_obj_add_event_cb(zb, on_guide_zoom, LV_EVENT_CLICKED, (void *)(intptr_t)(i ? 1 : -1));
        lv_obj_t *zlbl = lv_label_create(zb);
        lv_label_set_text(zlbl, i ? "+" : "-");
        lv_obj_center(zlbl);
    }
    u->mapInfo = lv_label_create(u->pMap);
    lv_obj_set_style_text_font(u->mapInfo, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(u->mapInfo, lv_color_hex(0x9ca3af), 0);
    lv_label_set_text(u->mapInfo, "");

    guide_show_tab(u, g_guideTab >= 0 && g_guideTab < 3 ? g_guideTab : 0);

    lv_timer_t *tmr = lv_timer_create(on_guide_screen_timer, 1000, u);
    on_guide_screen_timer(tmr);

    // tear down with the screen
    lv_obj_add_event_cb(root, [](lv_event_t *ev) {
        lv_timer_t *t = (lv_timer_t *)lv_event_get_user_data(ev);
        if (t) {
            GuideUi *gu = (GuideUi *)lv_timer_get_user_data(t);
            lv_timer_delete(t);
            if (gu == g_gu) g_gu = nullptr;
            delete gu;
        }
    }, LV_EVENT_DELETE, tmr);
}

static void on_delete_waypoint(lv_event_t *e)
{
    int idx = (int)(intptr_t)lv_event_get_user_data(e);
    if (idx < 0 || idx >= g_numWaypoints) return;
    for (int i = idx; i < g_numWaypoints - 1; i++) {
        g_waypoints[i] = g_waypoints[i + 1];
    }
    g_numWaypoints--;
    save_waypoints();
    refresh_waypoints_list();
}

static void refresh_waypoints_list()
{
    if (!g_wpListContainer) return;
    lv_obj_clean(g_wpListContainer);
    struct JoyRefresh { lv_obj_t *c; ~JoyRefresh() { if (emoji_joy_refresh) emoji_joy_refresh(c); } } joyRefresh{g_wpListContainer};

    if (g_numWaypoints == 0) {
        lv_obj_t *emptyLbl = lv_label_create(g_wpListContainer);
        lv_label_set_text(emptyLbl, "No waypoints saved yet.\nTap '+ Mark Current GPS' to save your spot.");
        lv_obj_set_style_text_color(emptyLbl, lv_color_hex(0x9ca3af), 0);
        lv_obj_set_style_text_font(emptyLbl, &ui_font_montserrat_12, 0);
        lv_obj_set_style_pad_all(emptyLbl, 12, 0);
        return;
    }

    for (int i = 0; i < g_numWaypoints; i++) {
        Waypoint &wp = g_waypoints[i];

        lv_obj_t *row = lv_obj_create(g_wpListContainer);
        lv_obj_remove_style_all(row);
        lv_obj_set_size(row, lv_pct(100), 44);
        lv_obj_set_style_bg_color(row, lv_color_hex(g_tItemBg), 0);
        lv_obj_set_style_bg_opa(row, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(row, 6, 0);
        lv_obj_set_style_pad_hor(row, 8, 0);
        lv_obj_set_style_pad_ver(row, 4, 0);

        // Name and Dist Info
        lv_obj_t *infoCol = lv_obj_create(row);
        lv_obj_remove_style_all(infoCol);
        lv_obj_set_size(infoCol, 120, LV_PCT(100));
        lv_obj_set_flex_flow(infoCol, LV_FLEX_FLOW_COLUMN);

        lv_obj_t *nameLbl = lv_label_create(infoCol);
        lv_label_set_text(nameLbl, wp.name);
        lv_obj_set_style_text_font(nameLbl, &ui_font_montserrat_14, 0);
        lv_obj_set_style_text_color(nameLbl, lv_color_hex(0xffffff), 0);

        lv_obj_t *distLbl = lv_label_create(infoCol);
        lv_obj_set_style_text_font(distLbl, &ui_font_montserrat_12, 0);
        lv_obj_set_style_text_color(distLbl, lv_color_hex(g_tAccent), 0);
        if (g_myLat != 0 || g_myLon != 0) {
            float distKm = 0.0f, bearingDeg = 0.0f;
            const char *card = "N";
            calc_dist_bearing(g_myLat, g_myLon, wp.lat, wp.lon, distKm, bearingDeg, card);
            char dBuf[32];
            if (distKm < 1.0f) snprintf(dBuf, sizeof(dBuf), "%dm %s", (int)(distKm * 1000.0f), card);
            else snprintf(dBuf, sizeof(dBuf), "%.1fkm %s", distKm, card);
            lv_label_set_text(distLbl, dBuf);
        } else {
            lv_label_set_text(distLbl, "No GPS");
        }

        // [ Guide ] Button
        lv_obj_t *guideBtn = lv_button_create(row);
        lv_obj_set_size(guideBtn, 56, 28);
        lv_obj_set_style_align(guideBtn, LV_ALIGN_RIGHT_MID, 0);
        lv_obj_set_pos(guideBtn, -36, 0);
        lv_obj_set_style_bg_color(guideBtn, lv_color_hex(g_tBtnBg), 0);
        lv_obj_set_style_bg_opa(guideBtn, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(guideBtn, 4, 0);
        lv_obj_set_style_shadow_width(guideBtn, 0, 0);
        lv_obj_add_event_cb(guideBtn, on_open_guidance, LV_EVENT_CLICKED, (void *)(intptr_t)i);

        lv_obj_t *gLbl = lv_label_create(guideBtn);
        lv_label_set_text(gLbl, "Guide");
        lv_obj_set_style_text_color(gLbl, lv_color_hex(0xffffff), 0);
        lv_obj_set_style_text_font(gLbl, &ui_font_montserrat_12, 0);
        lv_obj_set_style_align(gLbl, LV_ALIGN_CENTER, 0);

        // [ Del ] Button
        lv_obj_t *delBtn = lv_button_create(row);
        lv_obj_set_size(delBtn, 30, 28);
        lv_obj_set_style_align(delBtn, LV_ALIGN_RIGHT_MID, 0);
        lv_obj_set_pos(delBtn, 0, 0);
        lv_obj_set_style_bg_color(delBtn, lv_color_hex(0xd9534f), 0);
        lv_obj_set_style_bg_opa(delBtn, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(delBtn, 4, 0);
        lv_obj_set_style_shadow_width(delBtn, 0, 0);
        lv_obj_add_event_cb(delBtn, on_delete_waypoint, LV_EVENT_CLICKED, (void *)(intptr_t)i);

        lv_obj_t *dLbl = lv_label_create(delBtn);
        lv_label_set_text(dLbl, "X");
        lv_obj_set_style_text_color(dLbl, lv_color_hex(0xffffff), 0);
        lv_obj_set_style_text_font(dLbl, &ui_font_montserrat_12, 0);
        lv_obj_set_style_align(dLbl, LV_ALIGN_CENTER, 0);
    }
}

static void on_mark_gps_click(lv_event_t *e)
{
    if (g_myLat == 0 && g_myLon == 0) {
        // GPS not locked yet
        return;
    }
    if (g_numWaypoints >= 16) return;

    // Default label: Camp, Car, Trail, or WP#
    const char *presets[] = {"Camp", "Car", "Trailhead", "Rendezvous", "Water", "Base"};
    char name[24];
    if (g_numWaypoints < 6) {
        snprintf(name, sizeof(name), "%s", presets[g_numWaypoints]);
    } else {
        snprintf(name, sizeof(name), "WP %d", g_numWaypoints + 1);
    }

    snprintf(g_waypoints[g_numWaypoints].name, sizeof(g_waypoints[g_numWaypoints].name), "%s", name);
    g_waypoints[g_numWaypoints].lat = g_myLat;
    g_waypoints[g_numWaypoints].lon = g_myLon;
    g_waypoints[g_numWaypoints].alt = g_myAlt;
    g_numWaypoints++;

    save_waypoints();
    refresh_waypoints_list();
}

static void open_waypoints_screen(lv_event_t *e)
{
    load_waypoints();
    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen("Waypoints & Compass", &body);
    if (!root || !body) return;

    // Top Action Row
    lv_obj_t *topRow = lv_obj_create(body);
    lv_obj_remove_style_all(topRow);
    lv_obj_set_size(topRow, lv_pct(100), 34);
    lv_obj_set_flex_flow(topRow, LV_FLEX_FLOW_ROW);

    lv_obj_t *markBtn = lv_button_create(topRow);
    lv_obj_set_size(markBtn, lv_pct(100), 32);
    lv_obj_set_style_bg_color(markBtn, lv_color_hex(g_tBtnBg), 0);
    lv_obj_set_style_bg_opa(markBtn, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(markBtn, 6, 0);
    lv_obj_set_style_shadow_width(markBtn, 0, 0);
    lv_obj_add_event_cb(markBtn, on_mark_gps_click, LV_EVENT_CLICKED, nullptr);

    lv_obj_t *mbLbl = lv_label_create(markBtn);
    if (g_myLat != 0 || g_myLon != 0) {
        lv_label_set_text(mbLbl, "+ Mark Current GPS");
    } else {
        lv_label_set_text(mbLbl, "Waiting for GPS Fix...");
    }
    lv_obj_set_style_text_color(mbLbl, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(mbLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(mbLbl, LV_ALIGN_CENTER, 0);

    // Waypoints Container
    g_wpListContainer = lv_obj_create(body);
    lv_obj_remove_style_all(g_wpListContainer);
    lv_obj_set_size(g_wpListContainer, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(g_wpListContainer, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(g_wpListContainer, 6, 0);

    refresh_waypoints_list();
}

// -------------------------------------------------------------
// 2. Node Radar (Proximity Finder) Screen
// -------------------------------------------------------------

static lv_obj_t *g_radarCard = nullptr;
static lv_obj_t *g_radarNameLbl = nullptr;
static lv_obj_t *g_radarDistLbl = nullptr;
static lv_obj_t *g_radarSigLbl = nullptr;
static lv_obj_t *g_radarBarsLbl = nullptr;
static lv_obj_t *g_radarHeardLbl = nullptr;
static lv_obj_t *g_radarPingStatusLbl = nullptr;
static int g_radarSelectedIdx = 0;

static void update_radar_display()
{
    if (g_radarCount == 0 || g_radarSelectedIdx < 0 || g_radarSelectedIdx >= g_radarCount) {
        if (g_radarNameLbl) lv_label_set_text(g_radarNameLbl, "No nodes discovered yet");
        if (g_radarDistLbl) lv_label_set_text(g_radarDistLbl, "--");
        if (g_radarSigLbl) lv_label_set_text(g_radarSigLbl, "RSSI: -- dBm  SNR: -- dB");
        if (g_radarBarsLbl) lv_label_set_text(g_radarBarsLbl, "[ . . . . . ]");
        if (g_radarHeardLbl) lv_label_set_text(g_radarHeardLbl, "Last contact: --");
        return;
    }

    RadarNode &rn = g_radarNodes[g_radarSelectedIdx];
    if (g_radarNameLbl) {
        char nBuf[48];
        snprintf(nBuf, sizeof(nBuf), "%s (!%08x)", rn.name, (unsigned)rn.nodeNum);
        lv_label_set_text(g_radarNameLbl, nBuf);
    }

    // Distance & Bearing
    if (g_radarDistLbl) {
        if (g_myLat != 0 && g_myLon != 0 && rn.lat != 0 && rn.lon != 0) {
            float distKm = 0.0f, bearingDeg = 0.0f;
            const char *card = "N";
            calc_dist_bearing(g_myLat, g_myLon, rn.lat, rn.lon, distKm, bearingDeg, card);
            char dBuf[48];
            if (distKm < 1.0f) snprintf(dBuf, sizeof(dBuf), "%dm %s (%03d°)", (int)(distKm * 1000.0f), card, (int)bearingDeg);
            else snprintf(dBuf, sizeof(dBuf), "%.2fkm %s (%03d°)", distKm, card, (int)bearingDeg);
            lv_label_set_text(g_radarDistLbl, dBuf);
        } else {
            lv_label_set_text(g_radarDistLbl, "No GPS position from node");
        }
    }

    // Signal Bars
    if (g_radarBarsLbl) {
        const char *bars = "[ . . . . . ]";
        if (rn.rssi > -80) bars = "[ ##### ] (Excellent)";
        else if (rn.rssi > -95) bars = "[ ####. ] (Good)";
        else if (rn.rssi > -105) bars = "[ ###.. ] (Fair)";
        else if (rn.rssi > -115) bars = "[ ##... ] (Weak)";
        else if (rn.rssi > -128) bars = "[ #.... ] (Marginal)";
        lv_label_set_text(g_radarBarsLbl, bars);
    }

    if (g_radarSigLbl) {
        char sBuf[48];
        snprintf(sBuf, sizeof(sBuf), "RSSI: %d dBm  |  SNR: %+.1f dB", (int)rn.rssi, rn.snr);
        lv_label_set_text(g_radarSigLbl, sBuf);
    }

    if (g_radarHeardLbl) {
        uint32_t nowSec = millis() / 1000;
        uint32_t age = (nowSec > rn.lastHeard) ? (nowSec - rn.lastHeard) : 0;
        char hBuf[32];
        if (age < 60) snprintf(hBuf, sizeof(hBuf), "Last heard: %ds ago", (int)age);
        else snprintf(hBuf, sizeof(hBuf), "Last heard: %dm ago", (int)(age / 60));
        lv_label_set_text(g_radarHeardLbl, hBuf);
    }
}

static void on_radar_dropdown_changed(lv_event_t *e)
{
    lv_obj_t *dd = (lv_obj_t *)lv_event_get_target(e);
    if (!dd) return;
    g_radarSelectedIdx = lv_dropdown_get_selected(dd);
    update_radar_display();
}

static void on_radar_ping(lv_event_t *e)
{
    if (g_radarCount == 0 || g_radarSelectedIdx < 0 || g_radarSelectedIdx >= g_radarCount) return;
    RadarNode &rn = g_radarNodes[g_radarSelectedIdx];
    emoji_trigger_traceroute(rn.nodeNum, 0);
    if (g_radarPingStatusLbl) {
        lv_label_set_text(g_radarPingStatusLbl, "Ping dispatched! Listening for ACK...");
        lv_obj_set_style_text_color(g_radarPingStatusLbl, lv_color_hex(g_tAccent), 0);
    }
}

static void open_node_radar_screen(lv_event_t *e)
{
    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen("Node Radar", &body);
    if (!root || !body) return;

    // Dropdown Node Picker
    lv_obj_t *dd = lv_dropdown_create(body);
    lv_obj_set_size(dd, lv_pct(100), 36);
    lv_dropdown_clear_options(dd);

    if (g_radarCount == 0) {
        lv_dropdown_add_option(dd, "No contacts discovered", 0);
    } else {
        for (int i = 0; i < g_radarCount; i++) {
            char opt[32];
            snprintf(opt, sizeof(opt), "%s", g_radarNodes[i].name);
            lv_dropdown_add_option(dd, opt, i);
        }
    }
    lv_dropdown_set_selected(dd, g_radarSelectedIdx);
    lv_obj_add_event_cb(dd, on_radar_dropdown_changed, LV_EVENT_VALUE_CHANGED, nullptr);

    // Radar Card
    g_radarCard = lv_obj_create(body);
    lv_obj_remove_style_all(g_radarCard);
    lv_obj_set_size(g_radarCard, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_style_bg_color(g_radarCard, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_bg_opa(g_radarCard, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(g_radarCard, 8, 0);
    lv_obj_set_style_pad_all(g_radarCard, 12, 0);
    lv_obj_set_flex_flow(g_radarCard, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(g_radarCard, 6, 0);

    g_radarNameLbl = lv_label_create(g_radarCard);
    lv_obj_set_style_text_font(g_radarNameLbl, &ui_font_montserrat_16, 0);
    lv_obj_set_style_text_color(g_radarNameLbl, lv_color_hex(g_tAccent), 0);

    g_radarDistLbl = lv_label_create(g_radarCard);
    lv_obj_set_style_text_font(g_radarDistLbl, &ui_font_montserrat_14, 0);
    lv_obj_set_style_text_color(g_radarDistLbl, lv_color_hex(0xffffff), 0);

    g_radarBarsLbl = lv_label_create(g_radarCard);
    lv_obj_set_style_text_font(g_radarBarsLbl, &ui_font_montserrat_14, 0);
    lv_obj_set_style_text_color(g_radarBarsLbl, lv_color_hex(0x4ade80), 0); // Light green

    g_radarSigLbl = lv_label_create(g_radarCard);
    lv_obj_set_style_text_font(g_radarSigLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(g_radarSigLbl, lv_color_hex(0x9ca3af), 0);

    g_radarHeardLbl = lv_label_create(g_radarCard);
    lv_obj_set_style_text_font(g_radarHeardLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(g_radarHeardLbl, lv_color_hex(0x9ca3af), 0);

    // Action: [ Ping Node ]
    lv_obj_t *pingBtn = lv_button_create(body);
    lv_obj_set_size(pingBtn, lv_pct(100), 34);
    lv_obj_set_style_bg_color(pingBtn, lv_color_hex(g_tBtnBg), 0);
    lv_obj_set_style_bg_opa(pingBtn, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(pingBtn, 6, 0);
    lv_obj_set_style_shadow_width(pingBtn, 0, 0);
    lv_obj_add_event_cb(pingBtn, on_radar_ping, LV_EVENT_CLICKED, nullptr);

    lv_obj_t *pLbl = lv_label_create(pingBtn);
    lv_label_set_text(pLbl, "Ping Node");
    lv_obj_set_style_text_color(pLbl, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(pLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(pLbl, LV_ALIGN_CENTER, 0);

    g_radarPingStatusLbl = lv_label_create(body);
    lv_label_set_text(g_radarPingStatusLbl, "");
    lv_obj_set_style_text_font(g_radarPingStatusLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(g_radarPingStatusLbl, LV_ALIGN_CENTER, 0);

    update_radar_display();
}

// -------------------------------------------------------------
// 3. RF Channel Monitor (Passive Health Overview) Screen
// -------------------------------------------------------------

static void on_rf_timer(lv_timer_t *t)
{
    lv_obj_t *body = (lv_obj_t *)lv_timer_get_user_data(t);
    if (!body || !lv_obj_is_valid(body)) return;

    // Refresh gauges and texts
    lv_obj_t *chBar = (lv_obj_t *)lv_obj_get_user_data(body);
    if (chBar && lv_obj_is_valid(chBar)) {
        int v = (int)g_chUtil;
        if (v > 100) v = 100;
        lv_bar_set_value(chBar, v, LV_ANIM_ON);
    }
}

static void open_rf_monitor_screen(lv_event_t *e)
{
    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen("RF Channel Monitor", &body);
    if (!root || !body) return;

    // Section 1: Channel Utilization Gauge
    lv_obj_t *cCard = lv_obj_create(body);
    lv_obj_remove_style_all(cCard);
    lv_obj_set_size(cCard, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_style_bg_color(cCard, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_bg_opa(cCard, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(cCard, 8, 0);
    lv_obj_set_style_pad_all(cCard, 10, 0);
    lv_obj_set_flex_flow(cCard, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(cCard, 6, 0);

    lv_obj_t *chLbl = lv_label_create(cCard);
    char buf[64];
    snprintf(buf, sizeof(buf), "Channel Air Util: %.1f%%", g_chUtil);
    lv_label_set_text(chLbl, buf);
    lv_obj_set_style_text_font(chLbl, &ui_font_montserrat_14, 0);
    lv_obj_set_style_text_color(chLbl, lv_color_hex(0xffffff), 0);

    lv_obj_t *bar = lv_bar_create(cCard);
    lv_obj_set_size(bar, lv_pct(100), 10);
    lv_bar_set_range(bar, 0, 100);
    lv_bar_set_value(bar, (int)g_chUtil, LV_ANIM_OFF);
    lv_obj_set_style_bg_color(bar, lv_color_hex(0x374151), LV_PART_MAIN);
    // Dynamic color: green if low, red if high
    uint32_t barCol = (g_chUtil > 50.0f) ? 0xef4444 : (g_chUtil > 25.0f ? 0xf59e0b : 0x10b981);
    lv_obj_set_style_bg_color(bar, lv_color_hex(barCol), LV_PART_INDICATOR);

    // Section 2: Tx Air Util & Noise
    lv_obj_t *txCard = lv_obj_create(body);
    lv_obj_remove_style_all(txCard);
    lv_obj_set_size(txCard, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_style_bg_color(txCard, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_bg_opa(txCard, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(txCard, 8, 0);
    lv_obj_set_style_pad_all(txCard, 10, 0);
    lv_obj_set_flex_flow(txCard, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(txCard, 4, 0);

    lv_obj_t *txLbl = lv_label_create(txCard);
    snprintf(buf, sizeof(buf), "Device Tx Airtime: %.2f%% (Duty Cycle OK)", g_airUtil);
    lv_label_set_text(txLbl, buf);
    lv_obj_set_style_text_font(txLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(txLbl, lv_color_hex(g_tAccent), 0);

    lv_obj_t *sigLbl = lv_label_create(txCard);
    snprintf(buf, sizeof(buf), "Avg Mesh Signal: %.0f dBm (SNR %+.1f dB)", g_avgRssi, g_avgSnr);
    lv_label_set_text(sigLbl, buf);
    lv_obj_set_style_text_font(sigLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(sigLbl, lv_color_hex(0x9ca3af), 0);

    // Section 3: Traffic Counters
    lv_obj_t *cntCard = lv_obj_create(body);
    lv_obj_remove_style_all(cntCard);
    lv_obj_set_size(cntCard, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_style_bg_color(cntCard, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_bg_opa(cntCard, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(cntCard, 8, 0);
    lv_obj_set_style_pad_all(cntCard, 10, 0);
    lv_obj_set_flex_flow(cntCard, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(cntCard, 4, 0);

    lv_obj_t *rxLbl = lv_label_create(cntCard);
    snprintf(buf, sizeof(buf), "RX Packets: %u", (unsigned)g_rxPkts);
    lv_label_set_text(rxLbl, buf);
    lv_obj_set_style_text_font(rxLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(rxLbl, lv_color_hex(0xffffff), 0);

    lv_obj_t *txCntLbl = lv_label_create(cntCard);
    snprintf(buf, sizeof(buf), "TX Packets: %u", (unsigned)g_txPkts);
    lv_label_set_text(txCntLbl, buf);
    lv_obj_set_style_text_font(txCntLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(txCntLbl, lv_color_hex(0xffffff), 0);

    lv_obj_t *badLbl = lv_label_create(cntCard);
    snprintf(buf, sizeof(buf), "CRC Errors / Drops: %u", (unsigned)g_badPkts);
    lv_label_set_text(badLbl, buf);
    lv_obj_set_style_text_font(badLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(badLbl, (g_badPkts > 0) ? lv_color_hex(0xf87171) : lv_color_hex(0x9ca3af), 0);

    // Note at bottom
    lv_obj_t *noteLbl = lv_label_create(body);
    lv_label_set_text(noteLbl, "100% passive RF monitoring.\nZero transmissions, no LoRa RX interference.");
    lv_obj_set_style_text_font(noteLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_text_color(noteLbl, lv_color_hex(0x6b7280), 0);
    lv_obj_set_style_pad_all(noteLbl, 6, 0);

    lv_obj_set_user_data(body, bar);
    lv_timer_t *tmr = lv_timer_create(on_rf_timer, 1000, body);
    lv_obj_add_event_cb(root, [](lv_event_t *e) {
        lv_timer_t *t = (lv_timer_t *)lv_event_get_user_data(e);
        if (t) lv_timer_delete(t);
    }, LV_EVENT_DELETE, tmr);
}

// -------------------------------------------------------------
// 4. Field Notes (SD Card Offline Scratchpad) Screen
// -------------------------------------------------------------

static lv_obj_t *g_notesList = nullptr;
static char g_currentNotePath[64] = {0};
static lv_obj_t *g_noteTa = nullptr;
static lv_obj_t *g_noteName = nullptr;
static lv_obj_t *g_noteFocus = nullptr;

static void refresh_notes_list();

static void on_note_field_event(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_indev_t *act = lv_indev_active();
    bool touched = act && lv_indev_get_type(act) == LV_INDEV_TYPE_POINTER;
    if (code == LV_EVENT_CLICKED || (code == LV_EVENT_FOCUSED && touched)) {
        lv_obj_t *ta = (lv_obj_t *)lv_event_get_target(e);
        g_noteFocus = ta;
        if (g_kb) {
            lv_obj_clear_flag(g_kb, LV_OBJ_FLAG_HIDDEN);
            lv_obj_move_foreground(g_kb);
        }
        if (g_showKb) g_showKb(ta);
    }
}

// keyboard icon: first press opens the keyboard, second press closes it
static void on_note_kb_toggle(lv_event_t *e)
{
    if (!g_kb) return;
    if (lv_obj_has_flag(g_kb, LV_OBJ_FLAG_HIDDEN)) {
        lv_obj_t *ta = g_noteFocus ? g_noteFocus : g_noteTa;
        lv_obj_clear_flag(g_kb, LV_OBJ_FLAG_HIDDEN);
        lv_obj_move_foreground(g_kb);
        if (g_showKb && ta) g_showKb(ta);
    } else {
        lv_obj_add_flag(g_kb, LV_OBJ_FLAG_HIDDEN);
        lv_group_t *grp = lv_group_get_default();
        if (grp) {
            lv_group_set_editing(grp, false);
            lv_obj_t *ta = g_noteFocus ? g_noteFocus : g_noteTa;
            if (ta && lv_obj_is_valid(ta)) lv_group_focus_obj(ta);
        }
    }
}

static void on_save_note(lv_event_t *e)
{
    if (!g_noteTa || !g_noteName || !g_currentNotePath[0]) return;
    const char *txt = lv_textarea_get_text(g_noteTa);

    char name[40];
    snprintf(name, sizeof(name), "%s", lv_textarea_get_text(g_noteName));
    for (char *c = name; *c; c++)
        if (strchr("/\:*?\"<>|", *c)) *c = '_';
    size_t n = strlen(name);
    while (n && name[n - 1] == ' ') name[--n] = 0;
    if (!name[0]) snprintf(name, sizeof(name), "note");
    n = strlen(name);
    if (n < 4 || strcasecmp(name + n - 4, ".txt") != 0) strncat(name, ".txt", sizeof(name) - strlen(name) - 1);
    char newPath[64];
    snprintf(newPath, sizeof(newPath), "/notes/%s", name);
    bool renamed = strcmp(newPath, g_currentNotePath) != 0;

#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        if (!SDFs.exists("/notes")) SDFs.mkdir("/notes");
        FsFile f = SDFs.open(newPath, O_WRONLY | O_CREAT | O_TRUNC);
        if (f) {
            if (txt) f.write(txt);
            f.close();
            if (renamed && SDFs.exists(g_currentNotePath)) SDFs.remove(g_currentNotePath);
        }
    }
#endif
#if defined(ARCH_PORTDUINO)
    mkdir(nf_rel("/notes"), 0755);
    FILE *lf = fopen(nf_rel(newPath), "w");
    if (lf) {
        if (txt) fputs(txt, lf);
        fclose(lf);
        if (renamed && nf_exists(g_currentNotePath)) remove(nf_rel(g_currentNotePath));
    }
#endif
    snprintf(g_currentNotePath, sizeof(g_currentNotePath), "%s", newPath);
    lv_textarea_set_text(g_noteName, name);
    if (strstr(newPath, "scratchpad")) {
        Preferences p;
        if (p.begin("fnotes", false)) {
            p.putString("note", txt ? txt : "");
            p.end();
        }
    }

    lv_obj_t *saveBtn = (lv_obj_t *)lv_event_get_target(e);
    if (saveBtn) {
        lv_obj_t *lbl = lv_obj_get_child(saveBtn, 0);
        if (lbl) lv_label_set_text(lbl, "Saved!");
    }
    if (g_notesList && lv_obj_is_valid(g_notesList)) refresh_notes_list();
}

static lv_obj_t *note_button(lv_obj_t *parent, const char *text, uint32_t color, int w, lv_event_cb_t cb)
{
    lv_obj_t *b = lv_button_create(parent);
    lv_obj_set_size(b, w, 30);
    lv_obj_set_style_bg_color(b, lv_color_hex(color), 0);
    lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(b, 4, 0);
    lv_obj_set_style_shadow_width(b, 0, 0);
    lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, nullptr);
    lv_obj_t *l = lv_label_create(b);
    lv_label_set_text(l, text);
    lv_obj_set_style_text_color(l, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(l, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(l, LV_ALIGN_CENTER, 0);
    return b;
}

static lv_obj_t *note_field(lv_obj_t *parent, int h, const char *placeholder, bool oneLine)
{
    lv_obj_t *ta = lv_textarea_create(parent);
    lv_obj_set_size(ta, lv_pct(100), h);
    lv_obj_set_style_bg_color(ta, lv_color_hex(g_tItemBg), 0);
    lv_obj_set_style_text_color(ta, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(ta, &ui_font_montserrat_14, 0);
    lv_obj_set_style_radius(ta, 6, 0);
    lv_textarea_set_one_line(ta, oneLine);
    lv_textarea_set_placeholder_text(ta, placeholder);
    lv_obj_add_event_cb(ta, on_note_field_event, LV_EVENT_ALL, nullptr);
    return ta;
}

static void open_note_editor(const char *path, const char *title)
{
    snprintf(g_currentNotePath, sizeof(g_currentNotePath), "%s", path);

    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen(title, &body);
    if (!root || !body) return;

    // [ Save Note ][ keyboard ]
    lv_obj_t *bar = lv_obj_create(body);
    lv_obj_remove_style_all(bar);
    lv_obj_set_size(bar, lv_pct(100), 30);
    lv_obj_set_flex_flow(bar, LV_FLEX_FLOW_ROW);
    lv_obj_set_style_pad_column(bar, 6, 0);
    note_button(bar, "Save Note", 0x10b981, 150, on_save_note);
    note_button(bar, "KB", g_tBtnBg, 44, on_note_kb_toggle);

    // File name (upper) and content (lower)
    g_noteName = note_field(body, 34, "File name", true);
    lv_textarea_set_max_length(g_noteName, 28);
    const char *base = strrchr(path, '/');
    lv_textarea_set_text(g_noteName, base ? base + 1 : path);
    g_noteTa = note_field(body, 150, "Type field notes here...", false);
    g_noteFocus = g_noteTa;

    // Load existing content
    static char content[2048];
    content[0] = 0;
#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        if (SDFs.exists(path)) {
            FsFile f = SDFs.open(path, O_RDONLY);
            if (f) {
                int n = f.read(content, sizeof(content) - 1);
                content[n > 0 ? n : 0] = 0;
                f.close();
            }
        }
    }
#endif
#if defined(ARCH_PORTDUINO)
    if (FILE *lf = fopen(nf_rel(path), "r")) {
        size_t n = fread(content, 1, sizeof(content) - 1, lf);
        content[n] = 0;
        fclose(lf);
    }
#endif
    if (content[0] == 0 && strstr(path, "scratchpad")) {
        Preferences p;
        if (p.begin("fnotes", true)) {
            snprintf(content, sizeof(content), "%s", p.getString("note", "").c_str());
            p.end();
        }
    }
    lv_textarea_set_text(g_noteTa, content);
}

static void on_open_note_click(lv_event_t *e)
{
    const char *name = (const char *)lv_event_get_user_data(e);
    char path[64];
    snprintf(path, sizeof(path), "/notes/%s", name);
    open_note_editor(path, name);
}

static void on_new_note_click(lv_event_t *e)
{
    char path[64] = "/notes/note_1.txt", title[32] = "note_1.txt";
#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        if (!SDFs.exists("/notes")) SDFs.mkdir("/notes");
        for (int i = 1; i < 1000; i++) {
            snprintf(title, sizeof(title), "note_%d.txt", i);
            snprintf(path, sizeof(path), "/notes/%s", title);
            if (!SDFs.exists(path)) break;
        }
    }
#endif
#if defined(ARCH_PORTDUINO)
    for (int i = 1; i < 1000; i++) {
        snprintf(title, sizeof(title), "note_%d.txt", i);
        snprintf(path, sizeof(path), "/notes/%s", title);
        if (!nf_exists(path)) break;
    }
#endif
    open_note_editor(path, title);
}

static void refresh_notes_list()
{
    if (!g_notesList) return;
    lv_obj_clean(g_notesList);
    struct JoyRefresh { lv_obj_t *c; ~JoyRefresh() { if (emoji_joy_refresh) emoji_joy_refresh(c); } } joyRefresh{g_notesList};

    std::vector<std::string> files;
#ifdef HAS_SDCARD
    if (emoji_sd_ready && emoji_sd_ready()) {
        ISpiLock::Guard bus;
        if (!SDFs.exists("/notes")) SDFs.mkdir("/notes");
        FsFile dir = SDFs.open("/notes");
        if (dir && dir.isDir()) {
            FsFile entry;
            char fn[32];
            while (entry.openNext(&dir, O_RDONLY)) {
                if (!entry.isDir()) {
                    entry.getName(fn, sizeof(fn));
                    if (strstr(fn, ".txt")) {
                        files.push_back(fn);
                    }
                }
                entry.close();
            }
            dir.close();
        }
    }
#endif

#if defined(ARCH_PORTDUINO)
    if (DIR *d = opendir(nf_rel("/notes"))) {
        while (struct dirent *de = readdir(d)) {
            if (strstr(de->d_name, ".txt")) files.push_back(de->d_name);
        }
        closedir(d);
    }
#endif
    if (files.empty()) {
        // Show default Scratchpad row
        files.push_back("scratchpad.txt");
    }

    for (const auto &fn : files) {
        lv_obj_t *row = lv_obj_create(g_notesList);
        lv_obj_remove_style_all(row);
        lv_obj_set_size(row, lv_pct(100), 38);
        lv_obj_set_style_bg_color(row, lv_color_hex(g_tItemBg), 0);
        lv_obj_set_style_bg_opa(row, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(row, 6, 0);
        lv_obj_set_style_pad_hor(row, 8, 0);

        lv_obj_t *lbl = lv_label_create(row);
        lv_label_set_text(lbl, fn.c_str());
        lv_obj_set_style_text_font(lbl, &ui_font_montserrat_14, 0);
        lv_obj_set_style_text_color(lbl, lv_color_hex(0xffffff), 0);
        lv_obj_set_style_align(lbl, LV_ALIGN_LEFT_MID, 0);

        lv_obj_t *openBtn = lv_button_create(row);
        lv_obj_set_size(openBtn, 56, 26);
        lv_obj_set_style_align(openBtn, LV_ALIGN_RIGHT_MID, 0);
        lv_obj_set_style_bg_color(openBtn, lv_color_hex(g_tBtnBg), 0);
        lv_obj_set_style_bg_opa(openBtn, LV_OPA_COVER, 0);
        lv_obj_set_style_radius(openBtn, 4, 0);
        lv_obj_set_style_shadow_width(openBtn, 0, 0);
        lv_obj_add_event_cb(openBtn, on_open_note_click, LV_EVENT_CLICKED, (void *)strdup(fn.c_str()));

        lv_obj_t *oLabel = lv_label_create(openBtn);
        lv_label_set_text(oLabel, "Open");
        lv_obj_set_style_text_font(oLabel, &ui_font_montserrat_12, 0);
        lv_obj_set_style_text_color(oLabel, lv_color_hex(0xffffff), 0);
        lv_obj_set_style_align(oLabel, LV_ALIGN_CENTER, 0);
    }
}

static void open_field_notes_screen(lv_event_t *e)
{
    lv_obj_t *body = nullptr;
    lv_obj_t *root = create_subscreen("Field Notes", &body);
    if (!root || !body) return;

    // [ + New Note ] Button
    lv_obj_t *newBtn = lv_button_create(body);
    lv_obj_set_size(newBtn, lv_pct(100), 32);
    lv_obj_set_style_bg_color(newBtn, lv_color_hex(g_tBtnBg), 0);
    lv_obj_set_style_bg_opa(newBtn, LV_OPA_COVER, 0);
    lv_obj_set_style_radius(newBtn, 6, 0);
    lv_obj_set_style_shadow_width(newBtn, 0, 0);
    lv_obj_add_event_cb(newBtn, on_new_note_click, LV_EVENT_CLICKED, nullptr);

    lv_obj_t *nLbl = lv_label_create(newBtn);
    lv_label_set_text(nLbl, "+ New Note");
    lv_obj_set_style_text_color(nLbl, lv_color_hex(0xffffff), 0);
    lv_obj_set_style_text_font(nLbl, &ui_font_montserrat_12, 0);
    lv_obj_set_style_align(nLbl, LV_ALIGN_CENTER, 0);

    g_notesList = lv_obj_create(body);
    lv_obj_remove_style_all(g_notesList);
    lv_obj_set_size(g_notesList, lv_pct(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(g_notesList, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(g_notesList, 6, 0);
    lv_obj_add_event_cb(g_notesList, [](lv_event_t *) { g_notesList = nullptr; }, LV_EVENT_DELETE, nullptr);

    refresh_notes_list();
}

// -------------------------------------------------------------
// Native Tools Tab Hook (EXTRAS Section Divider + 4 Buttons)
// -------------------------------------------------------------

static lv_obj_t *create_extras_tool_button(lv_obj_t *parent, const char *text, lv_event_cb_t cb)
{
    lv_obj_t *btn = lv_button_create(parent);
    lv_obj_set_pos(btn, 0, 0);
    lv_obj_set_size(btn, lv_pct(95), 30);
    add_style_settings_button_style(btn);
    lv_obj_set_style_align(btn, LV_ALIGN_TOP_MID, 0);
    lv_obj_set_style_shadow_width(btn, 0, 0);
    lv_obj_set_style_bg_color(btn, lv_color_hex(0x4db270), LV_STATE_PRESSED);
    lv_obj_set_style_text_color(btn, lv_color_hex(0x015114), LV_STATE_PRESSED);
    lv_obj_set_style_text_color(btn, lv_color_hex(0x808080), LV_STATE_DISABLED);

    lv_obj_t *lbl = lv_label_create(btn);
    lv_obj_set_size(lbl, lv_pct(100), LV_SIZE_CONTENT);
    lv_label_set_long_mode(lbl, LV_LABEL_LONG_DOT);
    lv_obj_set_style_align(lbl, LV_ALIGN_CENTER, 0);
    lv_label_set_text(lbl, text);

    lv_obj_add_event_cb(btn, cb, LV_EVENT_CLICKED, nullptr);
    return btn;
}

extern "C" void emoji_tools_extras_init(lv_obj_t *tab_page_tools, lv_obj_t *screen, lv_obj_t *keyboard, KbFn showKb)
{
    if (!tab_page_tools || !screen) return;
    g_screen = screen;
    g_kb = keyboard;
    g_showKb = showKb;

    // Section Separator: ── EXTRAS ──
    lv_obj_t *sep = lv_obj_create(tab_page_tools);
    lv_obj_remove_style_all(sep);
    lv_obj_set_size(sep, lv_pct(95), 24);
    lv_obj_set_style_pad_top(sep, 6, 0);
    lv_obj_set_style_pad_bottom(sep, 2, 0);
    lv_obj_set_flex_flow(sep, LV_FLEX_FLOW_ROW);
    lv_obj_set_flex_align(sep, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);

    lv_obj_t *line1 = lv_obj_create(sep);
    lv_obj_remove_style_all(line1);
    lv_obj_set_size(line1, 56, 1);
    lv_obj_set_style_bg_color(line1, lv_color_hex(0x4b5563), 0);
    lv_obj_set_style_bg_opa(line1, LV_OPA_COVER, 0);

    lv_obj_t *sepLbl = lv_label_create(sep);
    lv_label_set_text(sepLbl, "  EXTRAS  ");
    lv_obj_set_style_text_color(sepLbl, lv_color_hex(g_tAccent), 0);
    lv_obj_set_style_text_font(sepLbl, &ui_font_montserrat_12, 0);

    lv_obj_t *line2 = lv_obj_create(sep);
    lv_obj_remove_style_all(line2);
    lv_obj_set_size(line2, 56, 1);
    lv_obj_set_style_bg_color(line2, lv_color_hex(0x4b5563), 0);
    lv_obj_set_style_bg_opa(line2, LV_OPA_COVER, 0);

    // 4 Field Tools Buttons
    create_extras_tool_button(tab_page_tools, "Waypoints & Compass", open_waypoints_screen);
    create_extras_tool_button(tab_page_tools, "Node Radar", open_node_radar_screen);
    create_extras_tool_button(tab_page_tools, "RF Channel Monitor", open_rf_monitor_screen);
    create_extras_tool_button(tab_page_tools, "Field Notes", open_field_notes_screen);
}
